# Auto detect text files and perform LF normalization
# 모든 텍스트 파일을 자동 감지 후 LF로 통일
* text=auto eol=lf
# 특정 파일은 LF로 통일
.gitignore text eol=lf
# 소스 코드
*.asset text eol=lf
*.cs    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.java  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.jsx   text eol=lf
*.tsx   text eol=lf
*.md    text eol=lf
*.meta  text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
# Windows에서만 쓰는 파일은 CRLF 유지
*.bat   text eol=crlf
*.cmd   text eol=crlf
# 바이너리 파일은 변환하지 않음
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.pdf   binary
*.so filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
# uv 벤더링 바이너리 보호 (eol 정규화 방지)
*.exe   binary
