  - _key: event.EV_CH3_01.title
    _ko: "\uC601\uD63C\uC744 \uAC74 \uB0B4\uAE30"
    _ja: "\u9B42\u3092\u8CED\u3051\u305F\u52DD\u8CA0"
    _en: Soul Wager
    _zhHant: "\u9748\u9B42\u8CED\u5C40"
    _zhHans: "\u7075\u9B42\u8D4C\u5C40"
  - _key: event.EV_CH3_01.body
    _ko: "\uBC30\uAD00 \uC0AC\uC774\uC5D0 \uC790\uAE30\uC640 \uB611\uAC19\uC774 \uC0DD\uAE34
      \uAC83\uC774 \uC549\uC544 \uC788\uB2E4.\n\uC81C \uBAAB\uC744 \uB5BC\uC5B4 \uC8FC\uBA74
      \uAE38\uC744 \uBCF4\uC5EC \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u914D\u7BA1\u306E\u9593\u306B\u3001\u81EA\u5206\u3068\u305D\u3063\u304F\u308A\u306A\u8005\u304C\u5EA7\u3063\u3066\u3044\u308B\u3002\n\u5206\u3051\u524D\u3092\u6E21\u305B\u3070\u3001\u9053\u3092\u793A\u3057\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 'Between the pipes sits something that looks just like you.

      Hand
      over a share, and it will show you the way.'
    _zhHant: "\u7BA1\u7DDA\u4E4B\u9593\u5750\u8457\u4E00\u500B\u548C\u4F60\u9577\u5F97\u4E00\u6A21\u4E00\u6A23\u7684\u6771\u897F\u3002\n\u5B83\u8AAA\u53EA\u8981\u5206\u5B83\u4E00\u4EFD\uFF0C\u5C31\u70BA\u4F60\u6307\u8DEF\u3002"
    _zhHans: "\u7BA1\u9053\u4E4B\u95F4\u5750\u7740\u4E00\u4E2A\u548C\u4F60\u957F\u5F97\u4E00\u6A21\u4E00\u6837\u7684\u4E1C\u897F\u3002\n\u5B83\u8BF4\u53EA\u8981\u5206\u5B83\u4E00\u4EFD\uFF0C\u5C31\u4E3A\u4F60\u6307\u8DEF\u3002"
  - _key: event.EV_CH3_01.accept
    _ko: "\uC601\uD63C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    _ja: "\u9B42\u3092\u5206\u3051\u4E0E\u3048\u308B"
    _en: Hand Over Soul
    _zhHant: "\u5206\u51FA\u9748\u9B42"
    _zhHans: "\u5206\u51FA\u7075\u9B42"
