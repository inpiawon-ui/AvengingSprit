  - _key: event.EV_CH1_01.body
    _ko: "\uBD80\uC11C\uC9C4 \uBC29\uD30C\uC81C \uB05D\uC5D0 \uB0A1\uC740 \uC0AC\uB2F9\uC774
      \uC11C \uC788\uB2E4.\n\uB3D9\uC804\uC744 \uB193\uB294 \uC790\uB9AC\uAC00 \uC190\uB54C\uC5D0
      \uD30C\uC5EC \uC788\uB2E4."
    _ja: "\u5D29\u308C\u305F\u9632\u6CE2\u5824\u306E\u5148\u306B\u3001\u53E4\u3073\u305F\u7960\u304C\u5EFA\u3063\u3066\u3044\u308B\u3002\n\u786C\u8CA8\u3092\u7F6E\u304F\u7AAA\u307F\u304C\u3001\u4EBA\u306E\u624B\u3067\u3059\u308A\u6E1B\u3063\u3066\u3044\u308B\u3002"
    _en: 'An old shrine stands at the end of the broken seawall.

      The coin
      slot is worn smooth by countless hands.'
    _zhHant: "\u6B98\u7834\u9632\u6CE2\u5824\u7684\u76E1\u982D\uFF0C\u7ACB\u8457\u4E00\u5EA7\u53E4\u8001\u7684\u7960\u5802\u3002\n\u653E\u786C\u5E63\u7684\u51F9\u69FD\u5DF2\u88AB\u7121\u6578\u96D9\u624B\u78E8\u5E73\u3002"
    _zhHans: "\u6B8B\u7834\u9632\u6CE2\u5824\u7684\u5C3D\u5934\uFF0C\u7ACB\u7740\u4E00\u5EA7\u53E4\u8001\u7684\u7960\u5802\u3002\n\u653E\u786C\u5E01\u7684\u51F9\u69FD\u5DF2\u88AB\u65E0\u6570\u53CC\u624B\u78E8\u5E73\u3002"
