    _ja: "\u6700\u3082\u8FD1\u3044\u6575\u306B\u98DB\u3073\u8FBC\u307F\u3001\u5468\u56F2\u306B300%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002"
