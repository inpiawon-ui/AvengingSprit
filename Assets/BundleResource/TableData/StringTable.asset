    _ko: "\uCCB4\uB825\uC774 \uB0AE\uC740 \uC801\uC5D0\uAC8C \uB354 \uC544\uD504\uB2E4."
    _ja: "\u4F53\u529B\u306E\u4F4E\u3044\u6575\u306B\u30C0\u30E1\u30FC\u30B8\u5897\u52A0\u3002"
