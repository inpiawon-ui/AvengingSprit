    _zhHant: "\u96E2\u958B"
    _zhHans: "\u79BB\u5F00"
  - _key: event.EV_CH3_05.title
    _ko: "\uC2EC\uC5F0\uC758 \uAC70\uB798"
    _ja: "\u6DF1\u6DF5\u306E\u53D6\u5F15"
    _en: Abyssal Bargain
    _zhHant: "\u6DF1\u6DF5\u4EA4\u6613"
    _zhHans: "\u6DF1\u6E0A\u4EA4\u6613"
  - _key: event.EV_CH3_05.body
    _ko: "\uBC14\uB2E5\uC774 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uD1B5\uB85C. \uC544\uB798\uC5D0\uC11C
      \uBAA9\uC18C\uB9AC\uAC00 \uC62C\uB77C\uC628\uB2E4.\n\uAC12\uC740 \uC601\uD63C\uC73C\uB85C
      \uBC1B\uB294\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u5E95\u306E\u898B\u3048\u306A\u3044\u901A\u8DEF\u3002\u4E0B\u304B\u3089\u58F0\u304C\u6607\u3063\u3066\u304F\u308B\u3002\n\u4EE3\u4FA1\u306F\u9B42\u3067\u53D7\u3051\u53D6\u308B\u3068\u8A00\u3046\u3002"
    _en: 'A passage with no bottom. A voice rises from below.

      It says the
      price is paid in soul.'
    _zhHant: "\u770B\u4E0D\u898B\u5E95\u7684\u901A\u9053\u3002\u8072\u97F3\u5F9E\u4E0B\u65B9\u50B3\u4E0A\u4F86\u3002\n\u5B83\u8AAA\u4EE3\u50F9\u8981\u7528\u9748\u9B42\u652F\u4ED8\u3002"
    _zhHans: "\u770B\u4E0D\u89C1\u5E95\u7684\u901A\u9053\u3002\u58F0\u97F3\u4ECE\u4E0B\u65B9\u4F20\u4E0A\u6765\u3002\n\u5B83\u8BF4\u4EE3\u4EF7\u8981\u7528\u7075\u9B42\u652F\u4ED8\u3002"
  - _key: event.EV_CH3_05.accept
    _ko: "\uC601\uD63C\uC744 \uB0B4\uC900\uB2E4"
    _ja: "\u9B42\u3092\u5DEE\u3057\u51FA\u3059"
    _en: Give Your Soul
    _zhHant: "\u4EA4\u51FA\u9748\u9B42"
    _zhHans: "\u4EA4\u51FA\u7075\u9B42"
  - _key: event.EV_CH3_05.decline
    _ko: "\uB300\uC2E0 \uC26C\uC5B4 \uAC04\uB2E4  (\uACE0\uC2A4\uD2B8 30% \uD68C\uBCF5)"
    _ja: "\u4EE3\u308F\u308A\u306B\u4F11\u3093\u3067\u3044\u304F  \uFF08\u30B4\u30FC\u30B9\u30C830%\u56DE\u5FA9\uFF09"
    _en: Rest Instead  (Ghost 30% Heal)
    _zhHant: "\u6539\u70BA\u4F11\u606F  \uFF08\u5E7D\u9748\u56DE\u5FA930%\uFF09"
    _zhHans: "\u6539\u4E3A\u4F11\u606F  \uFF08\u5E7D\u7075\u6062\u590D30%\uFF09"
  - _key: event.EV_CH3_06.title
    _ko: "\uB9C8\uC9C0\uB9C9 \uBCF4\uAE09 \uD22C\uD558"
    _ja: "\u6700\u5F8C\u306E\u88DC\u7D66\u6295\u4E0B"
    _en: Final Supply Drop
    _zhHant: "\u6700\u5F8C\u7684\u7A7A\u6295"
    _zhHans: "\u6700\u540E\u7684\u7A7A\u6295"
  - _key: event.EV_CH3_06.body
    _ko: "\uC694\uC0C8 \uC704\uB85C \uB099\uD558\uC0B0 \uD558\uB098\uAC00 \uB0B4\uB824\uC628\uB2E4.\n\uBA3C\uC800
      \uC9D1\uB294 \uCABD\uC774 \uC784\uC790\uC9C0\uB9CC, \uC548\uC5D0 \uBB34\uC5C7\uC774
      \uB4E4\uC5C8\uB294\uC9C0\uB294 \uBAA8\uB978\uB2E4."
    _ja: "\u8981\u585E\u306E\u4E0A\u306B\u3001\u30D1\u30E9\u30B7\u30E5\u30FC\u30C8\u304C\u3072\u3068\u3064\u964D\u308A\u3066\u304F\u308B\u3002\n\u5148\u306B\u63B4\u3093\u3060\u8005\u306E\u3082\u306E\u3060\u304C\u3001\u4E2D\u8EAB\u306F\u5206\u304B\u3089\u306A\u3044\u3002"
    _en: 'A parachute drifts down onto the fortress.

      Finders keepers, but
      no telling what''s inside.'
    _zhHant: "\u4E00\u9802\u964D\u843D\u5098\u843D\u5411\u8981\u585E\u3002\n\u5148\u6436\u5230\u5C31\u6B78\u8AB0\uFF0C\u4F46\u4E0D\u77E5\u9053\u88E1\u9762\u88DD\u4E86\u4EC0\u9EBC\u3002"
    _zhHans: "\u4E00\u9876\u964D\u843D\u4F1E\u843D\u5411\u8981\u585E\u3002\n\u5148\u62A2\u5230\u5C31\u5F52\u8C01\uFF0C\u4F46\u4E0D\u77E5\u9053\u91CC\u9762\u88C5\u4E86\u4EC0\u4E48\u3002"
  - _key: event.EV_CH3_06.accept
    _ko: "\uC804\uBD80 \uD138\uC5B4 \uB123\uB294\uB2E4"
    _ja: "\u5168\u90E8\u3064\u304E\u8FBC\u3080"
    _en: Go All In
    _zhHant: "\u5168\u90E8\u62BC\u4E0A"
    _zhHans: "\u5168\u90E8\u62BC\u4E0A"
  - _key: event.EV_CH3_06.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: Walk Away
    _zhHant: "\u96E2\u958B"
    _zhHans: "\u79BB\u5F00"
  - _key: event.EV_DEAL_01.title
    _ko: "\uD53C\uC758 \uACC4\uC57D"
    _ja: "\u8840\u306E\u5951\u7D04"
    _en: Blood Pact
    _zhHant: "\u8840\u4E4B\u5951\u7D04"
    _zhHans: "\u8840\u4E4B\u5951\u7EA6"
  - _key: event.EV_DEAL_01.body
    _ko: "\uC81C\uB2E8\uC774 \uC190\uBAA9\uC744 \uC7A1\uB294\uB2E4.\n\uB124 \uADF8\uB987\uC744
      \uC601\uC601 \uC904\uC774\uB294 \uB300\uC2E0, \uC774 \uD310\uC5D0\uC11C \uAC00\uC7A5
      \uD070 \uAC83\uC744 \uC900\uB2E4."
    _ja: "\u796D\u58C7\u304C\u624B\u9996\u3092\u63B4\u3080\u3002\n\u304A\u524D\u306E\u5668\u3092\u6C38\u9060\u306B\u524A\u308B\u4EE3\u308F\u308A\u306B\u3001\u3053\u306E\u65C5\u3067\u3044\u3061\u3070\u3093\u5927\u304D\u306A\u3082\u306E\u3092\u4E0E\u3048\u3088\u3046\u3002"
    _en: 'The Altar seizes your wrist.

      Shrink your vessel forever, and take
      the greatest prize of this run.'
    _zhHant: "\u796D\u58C7\u6293\u4F4F\u4E86\u4F60\u7684\u624B\u8155\u3002\n\u6C38\u9060\u524A\u6E1B\u4F60\u7684\u5BB9\u5668\uFF0C\u63DB\u53D6\u9019\u4E00\u5C40\u6700\u5927\u7684\u734E\u8CDE\u3002"
    _zhHans: "\u796D\u575B\u6293\u4F4F\u4E86\u4F60\u7684\u624B\u8155\u3002\n\u6C38\u8FDC\u524A\u51CF\u4F60\u7684\u5BB9\u5668\uFF0C\u6362\u53D6\u8FD9\u4E00\u5C40\u6700\u5927\u7684\u5956\u52B1\u3002"
  - _key: event.EV_DEAL_01.accept
    _ko: "\uD53C\uB97C \uB0B4\uC900\uB2E4"
    _ja: "\u8840\u3092\u5DEE\u3057\u51FA\u3059"
    _en: Give Blood
    _zhHant: "\u737B\u51FA\u9BAE\u8840"
    _zhHans: "\u732E\u51FA\u9C9C\u8840"
  - _key: event.EV_DEAL_01.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
    _ja: "\u80CC\u3092\u5411\u3051\u308B"
    _en: Turn Away
    _zhHant: "\u8F49\u8EAB\u96E2\u958B"
    _zhHans: "\u8F6C\u8EAB\u79BB\u5F00"
  - _key: event.EV_DEAL_02.title
    _ko: "\uAD11\uB780"
    _ja: "\u72C2\u4E71"
    _en: Frenzy
    _zhHant: "\u72C2\u4E82"
    _zhHans: "\u72C2\u4E71"
  - _key: event.EV_DEAL_02.body
    _ko: "\uC18D\uC0AD\uC784\uC774 \uADC0\uB97C \uCC44\uC6B4\uB2E4.\n\uBAB8\uC774
      \uC791\uC544\uC9C0\uB294 \uB9CC\uD07C \uC190\uC774 \uBE68\uB77C\uC9C4\uB2E4\uACE0
      \uD55C\uB2E4."
    _ja: "\u56C1\u304D\u304C\u8033\u3092\u6E80\u305F\u3059\u3002\n\u4F53\u304C\u5C0F\u3055\u304F\u306A\u308B\u5206\u3001\u624B\u304C\u901F\u304F\u306A\u308B\u3068\u8A00\u3046\u3002"
    _en: 'Whispers fill your ears.

      The smaller your body, the faster your
      hands.'
    _zhHant: "\u4F4E\u8A9E\u5145\u6EFF\u8033\u7554\u3002\n\u8EAB\u9AD4\u7E2E\u5C0F\u591A\u5C11\uFF0C\u624B\u5C31\u6703\u8B8A\u5FEB\u591A\u5C11\u3002"
    _zhHans: "\u4F4E\u8BED\u5145\u6EE1\u8033\u7554\u3002\n\u8EAB\u4F53\u7F29\u5C0F\u591A\u5C11\uFF0C\u624B\u5C31\u4F1A\u53D8\u5FEB\u591A\u5C11\u3002"
  - _key: event.EV_DEAL_02.accept
    _ko: "\uADC0\uB97C \uC5F0\uB2E4"
    _ja: "\u8033\u3092\u50BE\u3051\u308B"
    _en: Listen
    _zhHant: "\u50BE\u807D"
    _zhHans: "\u503E\u542C"
  - _key: event.EV_DEAL_02.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
