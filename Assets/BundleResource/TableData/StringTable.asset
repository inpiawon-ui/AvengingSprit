  - _key: ui.job.melee.rule
    _ko: "\uB54C\uB9B4 \uB54C\uB9C8\uB2E4 \uC274\uB4DC (HP 3% \xB7 \uCD5C\uB300 30%)\n\uD0C0\uACA9
      \uC2DC 12% \uD655\uB960\uB85C 0.8\uCD08 \uC2A4\uD134"
    _ja: "\u653B\u6483\u3067\u30B7\u30FC\u30EB\u30C9+3%\uFF08\u4E0A\u965030%\uFF09\n\u547D\u4E2D\u664212%\u30670.8\u79D2\u30B9\u30BF\u30F3"
    _en: "Hits grant shield (3% HP \xB7 max 30%)\n12% chance on hit to stun 0.8s"
    _zhHant: "\u6BCF\u6B21\u653B\u64CA\u7372\u5F97\u8B77\u76FE\uFF08HP 3% \xB7 \u4E0A\u965030%\uFF09\n\u547D\u4E2D\u664212%\u6A5F\u7387\u6688\u77290.8\u79D2"
    _zhHans: "\u6BCF\u6B21\u653B\u51FB\u83B7\u5F97\u62A4\u76FE\uFF08HP 3% \xB7 \u4E0A\u965030%\uFF09\n\u547D\u4E2D\u65F612%\u6982\u7387\u7729\u66550.8\u79D2"
  - _key: ui.job.mid.rule
    _ko: "\uC9C1\uC5C5 \uADDC\uCE59 \uC5C6\uC74C \u2014 \uBE60\uB978 \uC5F0\uC0AC\uC640
      \uC9E7\uC740 \uC0AC\uAC70\uB9AC\uAC00 \uACE7 \uD2B9\uC131\uC774\uB2E4"
    _ja: "\u8077\u696D\u30EB\u30FC\u30EB\u306A\u3057 \u2014 \u901F\u3044\u9023\u5C04\u3068\u77ED\u3044\u5C04\u7A0B\u304C\u305D\u306E\u307E\u307E\u7279\u6027"
    _en: "No class rule \u2014 fast fire and short range are its trait"
    _zhHant: "\u7121\u8077\u696D\u898F\u5247 \u2014 \u5FEB\u901F\u9023\u5C04\u8207\u77ED\u5C04\u7A0B\u5C31\u662F\u7279\u6027"
    _zhHans: "\u65E0\u804C\u4E1A\u89C4\u5219 \u2014 \u5FEB\u901F\u8FDE\u5C04\u4E0E\u77ED\u5C04\u7A0B\u5C31\u662F\u7279\u6027"
  - _key: ui.job.ranged.rule
    _ko: "\uC9C1\uC5C5 \uADDC\uCE59 \uC5C6\uC74C \u2014 \uCC28\uBCC4\uD654\uB294
      \uAC01\uC790\uC758 \uC561\uD2F0\uBE0C\xB7\uD328\uC2DC\uBE0C\uAC00 \uB9E1\uB294\uB2E4"
    _ja: "\u8077\u696D\u30EB\u30FC\u30EB\u306A\u3057 \u2014 \u5DEE\u306F\u305D\u308C\u305E\u308C\u306E\u30A2\u30AF\u30C6\u30A3\u30D6\u30FB\u30D1\u30C3\u30B7\u30D6\u304C\u62C5\u3046"
    _en: "No class rule \u2014 each Active/Passive sets it apart"
    _zhHant: "\u7121\u8077\u696D\u898F\u5247 \u2014 \u5DEE\u7570\u7531\u5404\u81EA\u7684\u4E3B\u52D5
      \xB7 \u88AB\u52D5\u6280\u80FD\u6C7A\u5B9A"
    _zhHans: "\u65E0\u804C\u4E1A\u89C4\u5219 \u2014 \u5DEE\u5F02\u7531\u5404\u81EA\u7684\u4E3B\u52A8
      \xB7 \u88AB\u52A8\u6280\u80FD\u51B3\u5B9A"
  - _key: ui.hostselect.tip
    _ko: "HOST\uB9C8\uB2E4 \uC774\uB3D9\uC18D\uB3C4, \uACF5\uACA9 \uBC29\uC2DD, \uC2A4\uD0AC\uC774
      \uB2E4\uB985\uB2C8\uB2E4.\n\uB2E4\uC591\uD55C HOST\uB97C \uACBD\uD5D8\uD574
      \uBCF4\uC138\uC694!"
    _ja: "HOST\u3054\u3068\u306B\u79FB\u52D5\u901F\u5EA6\u3001\u653B\u6483\u65B9\u6CD5\u3001\u30B9\u30AD\u30EB\u304C\u7570\u306A\u308A\u307E\u3059\u3002\n\u3044\u308D\u3044\u308D\u306AHOST\u3092\u8A66\u3057\u3066\u307F\u307E\u3057\u3087\u3046\uFF01"
    _en: 'Each HOST differs in speed, attack, and Skills.

      Try out many HOSTs!'
    _zhHant: "\u6BCF\u500BHOST\u7684\u79FB\u52D5\u901F\u5EA6\u3001\u653B\u64CA\u65B9\u5F0F\u8207\u6280\u80FD\u5404\u4E0D\u76F8\u540C\u3002\n\u591A\u8A66\u8A66\u5404\u7A2EHOST\u5427\uFF01"
    _zhHans: "\u6BCF\u4E2AHOST\u7684\u79FB\u52A8\u901F\u5EA6\u3001\u653B\u51FB\u65B9\u5F0F\u548C\u6280\u80FD\u5404\u4E0D\u76F8\u540C\u3002\n\u591A\u8BD5\u8BD5\u5404\u79CDHOST\u5427\uFF01"
