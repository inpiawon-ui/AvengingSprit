    _ja: "\u5F15\u304D\u8FD4\u3059"
    _en: 
  - _key: event.EV_CH2_03.title
    _ko: "\uBD09\uC778\uB41C \uADA4\uC9DD"
    _ja: "\u5C01\u5370\u3055\u308C\u305F\u6728\u7BB1"
    _en: 
  - _key: event.EV_CH2_03.body
    _ko: "\uAC12\uC740 \uBE44\uC2F8\uC9C0\uB9CC \uC548\uC5D0 \uB4E0 \uAC83\uC740
      \uD655\uC2E4\uD558\uB2E4.\n\uC774\uB7F0 \uBB3C\uAC74\uC740 \uB450 \uBC88 \uB098\uC624\uC9C0
      \uC54A\uB294\uB2E4."
    _ja: "\u5024\u306F\u5F35\u308B\u304C\u3001\u4E2D\u8EAB\u306F\u78BA\u304B\u3060\u3002\n\u3053\u3046\u3044\u3046\u54C1\u306F\u4E8C\u5EA6\u3068\u51FA\u306A\u3044\u3002"
    _en: 
  - _key: event.EV_CH2_03.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: "\u4EE3\u4FA1\u3092\u6255\u3046"
    _en: 
  - _key: event.EV_CH2_03.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH2_04.title
    _ko: "\uAD50\uCC28\uC0AC\uACA9"
    _ja: "\u5341\u5B57\u7832\u706B"
    _en: 
  - _key: event.EV_CH2_04.body
    _ko: "\uC591\uCABD \uC625\uC0C1\uC5D0 \uCD1D\uAD6C\uAC00 \uAC78\uB824 \uC788\uB2E4.
      \uC601\uD63C\uC744 \uC870\uAE08 \uD0DC\uC6CC \uBAB8\uC744 \uB0AE\uCD94\uBA74\n\uCCAB
      \uC0AC\uACA9\uC740 \uB118\uAE38 \uC218 \uC788\uB2E4."
    _ja: "\u4E21\u5074\u306E\u5C4B\u4E0A\u306B\u9283\u53E3\u304C\u4E26\u3093\u3067\u3044\u308B\u3002\u9B42\u3092\u5C11\u3057\u71C3\u3084\u3057\u3066\u8EAB\u3092\u4F4E\u304F\u3059\u308C\u3070\u3001\n\u6700\u521D\u306E\u5C04\u6483\u306F\u3084\u308A\u904E\u3054\u305B\u308B\u3002"
    _en: 
  - _key: event.EV_CH2_04.accept
    _ko: "\uC601\uD63C\uC744 \uD0DC\uC6CC \uB6AB\uB294\uB2E4"
    _ja: "\u9B42\u3092\u71C3\u3084\u3057\u3066\u7A81\u7834\u3059\u308B"
    _en: 
  - _key: event.EV_CH2_04.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: "\u5F15\u304D\u8FD4\u3059"
    _en: 
  - _key: event.EV_CH2_05.title
    _ko: "\uC554\uC2DC\uC7A5 \uC5F0\uC904"
    _ja: "\u95C7\u5E02\u306E\u30C4\u30C6"
    _en: 
  - _key: event.EV_CH2_05.body
    _ko: "\uB124\uC628 \uC544\uB798\uC5D0\uC11C \uB204\uAC00 \uC190\uC9D3\uD55C\uB2E4.
      \uBAB8\uC744 \uC880 \uB0B4\uC8FC\uBA74\n\uC774 \uAD6C\uC5ED \uC0C1\uC778\uB4E4\uC5D0\uAC8C
      \uB9D0\uC744 \uB123\uC5B4 \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u30CD\u30AA\u30F3\u306E\u4E0B\u3067\u8AB0\u304B\u304C\u624B\u62DB\u304D\u3057\u3066\u3044\u308B\u3002\u4F53\u3092\u5C11\u3057\u5DEE\u3057\u51FA\u305B\u3070\u3001\n\u3053\u306E\u533A\u57DF\u306E\u5546\u4EBA\u306B\u53E3\u3092\u5229\u3044\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 
  - _key: event.EV_CH2_05.accept
    _ko: "\uC0B4\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    _ja: "\u8089\u3092\u5DEE\u3057\u51FA\u3059"
    _en: 
  - _key: event.EV_CH2_05.decline
    _ko: "\uBB3C\uB7EC\uC120\uB2E4"
    _ja: "\u8EAB\u3092\u5F15\u304F"
    _en: 
  - _key: event.EV_CH2_06.title
    _ko: "\uBD80\uC11C\uC9C4 \uC81C\uB2E8"
    _ja: "\u58CA\u308C\u305F\u796D\u58C7"
    _en: 
  - _key: event.EV_CH2_06.body
    _ko: "\uAE08 \uAC04 \uC81C\uB2E8\uC774 \uC544\uC9C1 \uC228\uC744 \uC270\uB2E4.\n\uC0C8
      \uAC83\uC744 \uC8FC\uC9C0\uB294 \uBABB\uD558\uC9C0\uB9CC, \uC9C0\uB2CC \uAC83
      \uD558\uB098\uB294 \uBCBC\uB824 \uC900\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u3072\u3073\u5272\u308C\u305F\u796D\u58C7\u304C\u3001\u307E\u3060\u606F\u3065\u3044\u3066\u3044\u308B\u3002\n\u65B0\u3057\u3044\u3082\u306E\u306F\u4E0E\u3048\u3089\u308C\u306A\u3044\u304C\u3001\u6301\u3063\u3066\u3044\u308B\u3082\u306E\u3092\u3072\u3068\u3064\u935B\u3048\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 
  - _key: event.EV_CH2_06.accept
    _ko: "\uC81C\uB2E8\uC5D0 \uC62C\uB9B0\uB2E4"
    _ja: "\u796D\u58C7\u306B\u6367\u3052\u308B"
    _en: 
  - _key: event.EV_CH2_06.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH3_01.title
    _ko: "\uC601\uD63C\uC744 \uAC74 \uB0B4\uAE30"
    _ja: "\u9B42\u3092\u8CED\u3051\u305F\u52DD\u8CA0"
    _en: 
  - _key: event.EV_CH3_01.body
    _ko: "\uBC30\uAD00 \uC0AC\uC774\uC5D0 \uC790\uAE30\uC640 \uB611\uAC19\uC774 \uC0DD\uAE34
      \uAC83\uC774 \uC549\uC544 \uC788\uB2E4.\n\uC81C \uBAAB\uC744 \uB5BC\uC5B4 \uC8FC\uBA74
      \uAE38\uC744 \uBCF4\uC5EC \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u914D\u7BA1\u306E\u9593\u306B\u3001\u81EA\u5206\u3068\u305D\u3063\u304F\u308A\u306A\u8005\u304C\u5EA7\u3063\u3066\u3044\u308B\u3002\n\u5206\u3051\u524D\u3092\u6E21\u305B\u3070\u3001\u9053\u3092\u793A\u3057\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 
  - _key: event.EV_CH3_01.accept
    _ko: "\uC601\uD63C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    _ja: "\u9B42\u3092\u5206\u3051\u4E0E\u3048\u308B"
    _en: 
  - _key: event.EV_CH3_01.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH3_02.title
    _ko: "\uCE58\uBA85\uC801\uC778 \uB3C4\uC804"
    _ja: "\u547D\u61F8\u3051\u306E\u6311\u6226"
    _en: 
  - _key: event.EV_CH3_02.body
    _ko: "\uC694\uC0C8\uC758 \uBB38\uC9C0\uAE30 \uB458\uC774 \uAE38\uC744 \uB9C9\uACE0
      \uC11C \uC788\uB2E4.\n\uC774\uACA8\uC11C \uC5BB\uC744 \uAC83\uC774 \uD06C\uACE0,
      \uC838\uC11C \uC783\uC744 \uAC83\uB3C4 \uD06C\uB2E4."
    _ja: "\u8981\u585E\u306E\u9580\u756A\u304C\u3075\u305F\u308A\u3001\u9053\u3092\u585E\u3044\u3067\u3044\u308B\u3002\n\u52DD\u3066\u3070\u5F97\u308B\u3082\u306E\u306F\u5927\u304D\u304F\u3001\u8CA0\u3051\u308C\u3070\u5931\u3046\u3082\u306E\u3082\u5927\u304D\u3044\u3002"
    _en: 
  - _key: event.EV_CH3_02.accept
    _ko: "\uBC1B\uC544\uB4E4\uC778\uB2E4"
    _ja: "\u53D7\u3051\u3066\u7ACB\u3064"
    _en: 
  - _key: event.EV_CH3_02.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: "\u5F15\u304D\u8FD4\u3059"
    _en: 
  - _key: event.EV_CH3_03.title
    _ko: "\uBCF4\uC2A4 \uB300\uBE44"
    _ja: "\u30DC\u30B9\u5BFE\u7B56"
    _en: 
  - _key: event.EV_CH3_03.body
    _ko: "\uBB34\uAE30\uACE0\uC5D0 \uD30C\uC1C4\uD0C4\uC774 \uD558\uB098 \uB0A8\uC544
      \uC788\uB2E4.\n\uAC12\uC740 \uBE44\uC2F8\uC9C0\uB9CC, \uADF8 \uBC29\uC5B4\uB9C9\uC744
      \uD55C \uBC88\uC740 \uD655\uC2E4\uD788 \uBC97\uAE34\uB2E4."
    _ja: "\u6B66\u5668\u5EAB\u306B\u7834\u7815\u5F3E\u304C\u3072\u3068\u3064\u6B8B\u3063\u3066\u3044\u308B\u3002\n\u5024\u306F\u5F35\u308B\u304C\u3001\u3042\u306E\u30D0\u30EA\u30A2\u3092\u4E00\u5EA6\u306F\u78BA\u5B9F\u306B\u5265\u304C\u305B\u308B\u3002"
    _en: 
  - _key: event.EV_CH3_03.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: "\u4EE3\u4FA1\u3092\u6255\u3046"
    _en: 
  - _key: event.EV_CH3_03.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH3_04.title
    _ko: "\uD0C0\uB77D\uD55C \uD638\uC2A4\uD2B8"
    _ja: "\u5815\u3061\u305F\u30DB\u30B9\u30C8"
    _en: 
  - _key: event.EV_CH3_04.body
    _ko: "\uBC30\uAD00 \uC548\uCABD\uC5D0\uC11C \uB0AB \uB044\uB294 \uC18C\uB9AC\uAC00
      \uB09C\uB2E4.\n\uC0B4\uC744 \uC870\uAE08 \uB0B4\uC8FC\uBA74 \uC774\uCABD\uC73C\uB85C
      \uB098\uC628\uB2E4. \uB098\uC624\uBA74, \uBE7C\uC557\uC744 \uC218 \uC788\uB2E4."
    _ja: "\u914D\u7BA1\u306E\u5965\u304B\u3089\u3001\u938C\u3092\u5F15\u304D\u305A\u308B\u97F3\u304C\u3059\u308B\u3002\n\u8089\u3092\u5C11\u3057\u5DEE\u3057\u51FA\u305B\u3070\u3001\u3053\u3061\u3089\u3078\u51FA\u3066\u304F\u308B\u3002\u51FA\u3066\u304F\u308C\u3070\u3001\u596A\u3048\u308B\u3002"
    _en: 
  - _key: event.EV_CH3_04.accept
    _ko: "\uC0B4\uC744 \uB0B4\uC900\uB2E4"
    _ja: "\u8089\u3092\u5DEE\u3057\u51FA\u3059"
    _en: 
  - _key: event.EV_CH3_04.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH3_05.title
    _ko: "\uC2EC\uC5F0\uC758 \uAC70\uB798"
    _ja: "\u6DF1\u6DF5\u306E\u53D6\u5F15"
    _en: 
  - _key: event.EV_CH3_05.body
    _ko: "\uBC14\uB2E5\uC774 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uD1B5\uB85C. \uC544\uB798\uC5D0\uC11C
      \uBAA9\uC18C\uB9AC\uAC00 \uC62C\uB77C\uC628\uB2E4.\n\uAC12\uC740 \uC601\uD63C\uC73C\uB85C
      \uBC1B\uB294\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u5E95\u306E\u898B\u3048\u306A\u3044\u901A\u8DEF\u3002\u4E0B\u304B\u3089\u58F0\u304C\u6607\u3063\u3066\u304F\u308B\u3002\n\u4EE3\u4FA1\u306F\u9B42\u3067\u53D7\u3051\u53D6\u308B\u3068\u8A00\u3046\u3002"
    _en: 
  - _key: event.EV_CH3_05.accept
    _ko: "\uC601\uD63C\uC744 \uB0B4\uC900\uB2E4"
    _ja: "\u9B42\u3092\u5DEE\u3057\u51FA\u3059"
    _en: 
  - _key: event.EV_CH3_05.decline
    _ko: "\uB300\uC2E0 \uC26C\uC5B4 \uAC04\uB2E4  (\uACE0\uC2A4\uD2B8 30% \uD68C\uBCF5)"
    _ja: "\u4EE3\u308F\u308A\u306B\u4F11\u3093\u3067\u3044\u304F  \uFF08\u30B4\u30FC\u30B9\u30C830%\u56DE\u5FA9\uFF09"
    _en: 
  - _key: event.EV_CH3_06.title
    _ko: "\uB9C8\uC9C0\uB9C9 \uBCF4\uAE09 \uD22C\uD558"
    _ja: "\u6700\u5F8C\u306E\u88DC\u7D66\u6295\u4E0B"
    _en: 
  - _key: event.EV_CH3_06.body
    _ko: "\uC694\uC0C8 \uC704\uB85C \uB099\uD558\uC0B0 \uD558\uB098\uAC00 \uB0B4\uB824\uC628\uB2E4.\n\uBA3C\uC800
      \uC9D1\uB294 \uCABD\uC774 \uC784\uC790\uC9C0\uB9CC, \uC548\uC5D0 \uBB34\uC5C7\uC774
      \uB4E4\uC5C8\uB294\uC9C0\uB294 \uBAA8\uB978\uB2E4."
    _ja: "\u8981\u585E\u306E\u4E0A\u306B\u3001\u30D1\u30E9\u30B7\u30E5\u30FC\u30C8\u304C\u3072\u3068\u3064\u964D\u308A\u3066\u304F\u308B\u3002\n\u5148\u306B\u63B4\u3093\u3060\u8005\u306E\u3082\u306E\u3060\u304C\u3001\u4E2D\u8EAB\u306F\u5206\u304B\u3089\u306A\u3044\u3002"
    _en: 
  - _key: event.EV_CH3_06.accept
    _ko: "\uC804\uBD80 \uD138\uC5B4 \uB123\uB294\uB2E4"
    _ja: "\u5168\u90E8\u3064\u304E\u8FBC\u3080"
    _en: 
  - _key: event.EV_CH3_06.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_DEAL_01.title
    _ko: "\uD53C\uC758 \uACC4\uC57D"
    _ja: "\u8840\u306E\u5951\u7D04"
    _en: 
  - _key: event.EV_DEAL_01.body
    _ko: "\uC81C\uB2E8\uC774 \uC190\uBAA9\uC744 \uC7A1\uB294\uB2E4.\n\uB124 \uADF8\uB987\uC744
      \uC601\uC601 \uC904\uC774\uB294 \uB300\uC2E0, \uC774 \uD310\uC5D0\uC11C \uAC00\uC7A5
      \uD070 \uAC83\uC744 \uC900\uB2E4."
    _ja: "\u796D\u58C7\u304C\u624B\u9996\u3092\u63B4\u3080\u3002\n\u304A\u524D\u306E\u5668\u3092\u6C38\u9060\u306B\u524A\u308B\u4EE3\u308F\u308A\u306B\u3001\u3053\u306E\u65C5\u3067\u3044\u3061\u3070\u3093\u5927\u304D\u306A\u3082\u306E\u3092\u4E0E\u3048\u3088\u3046\u3002"
    _en: 
  - _key: event.EV_DEAL_01.accept
    _ko: "\uD53C\uB97C \uB0B4\uC900\uB2E4"
    _ja: "\u8840\u3092\u5DEE\u3057\u51FA\u3059"
    _en: 
  - _key: event.EV_DEAL_01.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
    _ja: "\u80CC\u3092\u5411\u3051\u308B"
    _en: 
  - _key: event.EV_DEAL_02.title
    _ko: "\uAD11\uB780"
    _ja: "\u72C2\u4E71"
    _en: 
  - _key: event.EV_DEAL_02.body
    _ko: "\uC18D\uC0AD\uC784\uC774 \uADC0\uB97C \uCC44\uC6B4\uB2E4.\n\uBAB8\uC774
      \uC791\uC544\uC9C0\uB294 \uB9CC\uD07C \uC190\uC774 \uBE68\uB77C\uC9C4\uB2E4\uACE0
      \uD55C\uB2E4."
    _ja: "\u56C1\u304D\u304C\u8033\u3092\u6E80\u305F\u3059\u3002\n\u4F53\u304C\u5C0F\u3055\u304F\u306A\u308B\u5206\u3001\u624B\u304C\u901F\u304F\u306A\u308B\u3068\u8A00\u3046\u3002"
    _en: 
  - _key: event.EV_DEAL_02.accept
    _ko: "\uADC0\uB97C \uC5F0\uB2E4"
    _ja: "\u8033\u3092\u50BE\u3051\u308B"
    _en: 
