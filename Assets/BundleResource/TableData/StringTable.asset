      \uBAB8\uC73C\uB85C \uAC00\uB294 \uAE38\uC744 \uB113\uD600 \uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4."
    _ja: "\u4F53\u3092\u63A2\u3057\u75B2\u308C\u305F\u8005\u304C\u3072\u3068\u3064\u3001\u6F02\u3063\u3066\u3044\u308B\u3002\n\u5206\u3051\u524D\u3092\u5C11\u3057\u6E21\u305B\u3070\u3001\u4F53\u3078\u306E\u9053\u3092\u5E83\u3052\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 'Another one drifts here, worn out from searching for a body.

      Share
      a little of yours, and it will widen your path to a Host.'
    _zhHant: "\u4E00\u500B\u540C\u6A23\u627E\u8EAB\u9AD4\u627E\u5230\u7B4B\u75B2\u529B\u76E1\u7684\u50A2\u4F19\u98C4\u5728\u9019\u88E1\u3002\n\u5B83\u8AAA\u53EA\u8981\u5206\u5B83\u4E00\u9EDE\uFF0C\u5C31\u5E6B\u4F60\u62D3\u5BEC\u901A\u5F80\u8EAB\u9AD4\u7684\u8DEF\u3002"
    _zhHans: "\u4E00\u4E2A\u540C\u6837\u627E\u8EAB\u4F53\u627E\u5230\u7B4B\u75B2\u529B\u5C3D\u7684\u5BB6\u4F19\u98D8\u5728\u8FD9\u91CC\u3002\n\u5B83\u8BF4\u53EA\u8981\u5206\u5B83\u4E00\u70B9\uFF0C\u5C31\u5E2E\u4F60\u62D3\u5BBD\u901A\u5F80\u8EAB\u4F53\u7684\u8DEF\u3002"
  - _key: event.EV_CH1_04.accept
    _ko: "\uC601\uD63C\uC744 \uB098\uB220 \uC900\uB2E4"
    _ja: "\u9B42\u3092\u5206\u3051\u4E0E\u3048\u308B"
    _en: Share Your Soul
    _zhHant: "\u5206\u51FA\u9748\u9B42"
    _zhHans: "\u5206\u51FA\u7075\u9B42"
  - _key: event.EV_CH1_04.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: Walk Away
    _zhHant: "\u96E2\u958B"
    _zhHans: "\u79BB\u5F00"
  - _key: event.EV_CH1_05.title
    _ko: "\uC57C\uC804 \uC758\uBB34\uBCD1"
    _ja: "\u91CE\u6226\u885B\u751F\u5175"
    _en: Field Medic
    _zhHant: "\u91CE\u6230\u91AB\u8B77\u5175"
    _zhHans: "\u91CE\u6218\u533B\u62A4\u5175"
  - _key: event.EV_CH1_05.body
    _ko: "\uBD80\uB450 \uCC3D\uACE0\uC5D0 \uC544\uC9C1 \uC228\uC774 \uBD99\uC740
      \uC758\uBB34\uBCD1\uC774 \uC788\uB2E4.\n\uB9D0\uC740 \uC548 \uD1B5\uD558\uC9C0\uB9CC
      \uC190\uC9D3\uC740 \uD1B5\uD55C\uB2E4."
    _ja: "\u57E0\u982D\u306E\u5009\u5EAB\u306B\u3001\u307E\u3060\u606F\u306E\u3042\u308B\u885B\u751F\u5175\u304C\u3044\u308B\u3002\n\u8A00\u8449\u306F\u901A\u3058\u306A\u3044\u304C\u3001\u8EAB\u632F\u308A\u306F\u901A\u3058\u308B\u3002"
    _en: 'A medic still breathes in the dockside warehouse.

      No common tongue,
      but gestures work.'
    _zhHant: "\u78BC\u982D\u5009\u5EAB\u88E1\u6709\u500B\u9084\u5269\u4E00\u53E3\u6C23\u7684\u91AB\u8B77\u5175\u3002\n\u8A9E\u8A00\u4E0D\u901A\uFF0C\u4F46\u624B\u52E2\u80FD\u61C2\u3002"
    _zhHans: "\u7801\u5934\u4ED3\u5E93\u91CC\u6709\u4E2A\u8FD8\u5269\u4E00\u53E3\u6C14\u7684\u533B\u62A4\u5175\u3002\n\u8BED\u8A00\u4E0D\u901A\uFF0C\u4F46\u624B\u52BF\u80FD\u61C2\u3002"
  - _key: event.EV_CH1_05.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: "\u4EE3\u4FA1\u3092\u6255\u3046"
    _en: Pay the Price
    _zhHant: "\u652F\u4ED8\u4EE3\u50F9"
    _zhHans: "\u652F\u4ED8\u4EE3\u4EF7"
  - _key: event.EV_CH1_05.decline
    _ko: "\uB0B4\uBC84\uB824 \uB454\uB2E4"
    _ja: "\u653E\u3063\u3066\u304A\u304F"
    _en: Leave Him Be
    _zhHant: "\u7F6E\u4E4B\u4E0D\u7406"
    _zhHans: "\u7F6E\u4E4B\u4E0D\u7406"
  - _key: event.EV_CH1_06.title
    _ko: "\uC881\uC740 \uAE38\uBAA9"
    _ja: "\u72ED\u3044\u901A\u308A\u9053"
    _en: Narrow Passage
    _zhHant: "\u72F9\u7A84\u901A\u9053"
    _zhHans: "\u72ED\u7A84\u901A\u9053"
  - _key: event.EV_CH1_06.body
    _ko: "\uC9D0\uC9DD \uC0AC\uC774\uB85C \uAE38\uC774 \uD558\uB098\uBFD0\uC774\uB2E4.\n\uBC18\uB300\uD3B8\uC5D0\uC11C
      \uAE30\uCC99\uC774 \uB09C\uB2E4. \uB3CC\uC544\uAC08 \uC218\uB3C4 \uC788\uB2E4."
    _ja: "\u8377\u7269\u306E\u9593\u306B\u9053\u306F\u3072\u3068\u3064\u3060\u3051\u3002\n\u5411\u3053\u3046\u5074\u3067\u6C17\u914D\u304C\u3059\u308B\u3002\u5F15\u304D\u8FD4\u3059\u3053\u3068\u3082\u3067\u304D\u308B\u3002"
    _en: 'One path between the cargo stacks.

      Something stirs on the other
      side. You could turn back.'
    _zhHant: "\u8CA8\u5806\u4E4B\u9593\u53EA\u6709\u4E00\u689D\u8DEF\u3002\n\u53E6\u4E00\u982D\u6709\u52D5\u975C\u3002\u4E5F\u53EF\u4EE5\u6298\u8FD4\u3002"
    _zhHans: "\u8D27\u5806\u4E4B\u95F4\u53EA\u6709\u4E00\u6761\u8DEF\u3002\n\u53E6\u4E00\u5934\u6709\u52A8\u9759\u3002\u4E5F\u53EF\u4EE5\u6298\u8FD4\u3002"
  - _key: event.EV_CH1_06.accept
    _ko: "\uBC00\uACE0 \uB4E4\uC5B4\uAC04\uB2E4"
    _ja: "\u62BC\u3057\u5165\u308B"
    _en: Push Through
    _zhHant: "\u786C\u95D6\u904E\u53BB"
    _zhHans: "\u786C\u95EF\u8FC7\u53BB"
  - _key: event.EV_CH1_06.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: "\u5F15\u304D\u8FD4\u3059"
    _en: Turn Back
    _zhHant: "\u6298\u8FD4"
    _zhHans: "\u8FD4\u56DE"
  - _key: event.EV_CH2_01.title
    _ko: "\uC800\uC8FC\uBC1B\uC740 \uC740\uB2C9\uCC98"
    _ja: "\u546A\u308F\u308C\u305F\u96A0\u3057\u5834\u6240"
    _en: Cursed Stash
    _zhHant: "\u88AB\u8A5B\u5492\u7684\u85CF\u533F\u8655"
    _zhHans: "\u88AB\u8BC5\u5492\u7684\u85CF\u533F\u5904"
  - _key: event.EV_CH2_01.body
    _ko: "\uB124\uC628\uC774 \uB2FF\uC9C0 \uC54A\uB294 \uAD6C\uC11D. \uC190\uC744
      \uB123\uC73C\uBA74 \uC0B4\uC774 \uD0C0\uB294 \uB0C4\uC0C8\uAC00 \uB09C\uB2E4.\n\uC548\uCABD\uC5D0\uC11C
      \uBB34\uC5B8\uAC00\uAC00 \uBE5B\uB09C\uB2E4."
    _ja: "\u30CD\u30AA\u30F3\u306E\u5C4A\u304B\u306A\u3044\u7247\u9685\u3002\u624B\u3092\u5165\u308C\u308B\u3068\u3001\u8089\u306E\u713C\u3051\u308B\u5302\u3044\u304C\u3059\u308B\u3002\n\u5965\u3067\u4F55\u304B\u304C\u5149\u3063\u3066\u3044\u308B\u3002"
    _en: 'A corner the neon can''t reach. Reach in, and flesh sizzles.

      Something
      glints deep inside.'
    _zhHant: "\u9713\u8679\u7167\u4E0D\u5230\u7684\u89D2\u843D\u3002\u4E00\u4F38\u624B\u4FBF\u50B3\u4F86\u76AE\u8089\u71D2\u7126\u7684\u6C23\u5473\u3002\n\u6DF1\u8655\u6709\u4EC0\u9EBC\u5728\u767C\u5149\u3002"
    _zhHans: "\u9713\u8679\u7167\u4E0D\u5230\u7684\u89D2\u843D\u3002\u4E00\u4F38\u624B\u4FBF\u4F20\u6765\u76AE\u8089\u70E7\u7126\u7684\u6C14\u5473\u3002\n\u6DF1\u5904\u6709\u4EC0\u4E48\u5728\u53D1\u5149\u3002"
  - _key: event.EV_CH2_01.accept
    _ko: "\uC190\uC744 \uB123\uB294\uB2E4"
    _ja: "\u624B\u3092\u5165\u308C\u308B"
    _en: Reach In
    _zhHant: "\u4F38\u624B"
    _zhHans: "\u4F38\u624B"
  - _key: event.EV_CH2_01.decline
    _ko: "\uBB3C\uB7EC\uC120\uB2E4"
    _ja: "\u8EAB\u3092\u5F15\u304F"
    _en: Back Off
    _zhHant: "\u9000\u5F8C"
    _zhHans: "\u540E\u9000"
  - _key: event.EV_CH2_02.title
    _ko: "\uC774\uB984\uB09C \uBAB8"
    _ja: "\u540D\u306E\u77E5\u308C\u305F\u4F53"
    _en: Notorious Body
    _zhHant: "\u540D\u8072\u5728\u5916\u7684\u8EAB\u9AD4"
    _zhHans: "\u540D\u58F0\u5728\u5916\u7684\u8EAB\u4F53"
  - _key: event.EV_CH2_02.body
    _ko: "\uACE8\uBAA9 \uB05D\uC5D0 \uD558\uB098\uAC00 \uC11C \uC788\uB2E4. \uC774
      \uAD6C\uC5ED\uC5D0\uC11C \uC81C\uC77C \uC88B\uC740 \uBAB8\uC774\uB2E4.\n\uBE44\uCF1C
      \uC904 \uC0DD\uAC01\uC740 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4."
    _ja: "\u8DEF\u5730\u306E\u5965\u306B\u3072\u3068\u308A\u7ACB\u3063\u3066\u3044\u308B\u3002\u3053\u306E\u533A\u57DF\u3067\u3044\u3061\u3070\u3093\u826F\u3044\u4F53\u3060\u3002\n\u9053\u3092\u8B72\u308B\u6C17\u306F\u306A\u3055\u305D\u3046\u3060\u3002"
    _en: 'One stands at the end of the alley. The finest body in this district.

      It
      isn''t stepping aside.'
    _zhHant: "\u5DF7\u5B50\u76E1\u982D\u7AD9\u8457\u4E00\u500B\u4EBA\u3002\u9019\u662F\u9019\u4E00\u5340\u6700\u597D\u7684\u8EAB\u9AD4\u3002\n\u770B\u4F86\u6C92\u6253\u7B97\u8B93\u8DEF\u3002"
    _zhHans: "\u5DF7\u5B50\u5C3D\u5934\u7AD9\u7740\u4E00\u4E2A\u4EBA\u3002\u8FD9\u662F\u8FD9\u4E00\u7247\u6700\u597D\u7684\u8EAB\u4F53\u3002\n\u770B\u6765\u6CA1\u6253\u7B97\u8BA9\u8DEF\u3002"
  - _key: event.EV_CH2_02.accept
    _ko: "\uB364\uBE48\uB2E4"
    _ja: "\u6311\u3080"
    _en: Challenge It
    _zhHant: "\u6311\u6230"
    _zhHans: "\u6311\u6218"
  - _key: event.EV_CH2_02.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: "\u5F15\u304D\u8FD4\u3059"
    _en: Turn Back
    _zhHant: "\u6298\u8FD4"
    _zhHans: "\u8FD4\u56DE"
  - _key: event.EV_CH2_03.title
    _ko: "\uBD09\uC778\uB41C \uADA4\uC9DD"
    _ja: "\u5C01\u5370\u3055\u308C\u305F\u6728\u7BB1"
    _en: Sealed Crate
    _zhHant: "\u5C01\u5370\u7684\u6728\u7BB1"
    _zhHans: "\u5C01\u5370\u7684\u6728\u7BB1"
  - _key: event.EV_CH2_03.body
    _ko: "\uAC12\uC740 \uBE44\uC2F8\uC9C0\uB9CC \uC548\uC5D0 \uB4E0 \uAC83\uC740
      \uD655\uC2E4\uD558\uB2E4.\n\uC774\uB7F0 \uBB3C\uAC74\uC740 \uB450 \uBC88 \uB098\uC624\uC9C0
      \uC54A\uB294\uB2E4."
    _ja: "\u5024\u306F\u5F35\u308B\u304C\u3001\u4E2D\u8EAB\u306F\u78BA\u304B\u3060\u3002\n\u3053\u3046\u3044\u3046\u54C1\u306F\u4E8C\u5EA6\u3068\u51FA\u306A\u3044\u3002"
    _en: 'Pricey, but what''s inside is the real thing.

      Goods like this never
      show up twice.'
    _zhHant: "\u50F9\u683C\u4E0D\u83F2\uFF0C\u4F46\u88E1\u9762\u7684\u6771\u897F\u8CA8\u771F\u50F9\u5BE6\u3002\n\u9019\u7A2E\u6771\u897F\u4E0D\u6703\u51FA\u73FE\u7B2C\u4E8C\u6B21\u3002"
    _zhHans: "\u4EF7\u683C\u4E0D\u83F2\uFF0C\u4F46\u91CC\u9762\u7684\u4E1C\u897F\u8D27\u771F\u4EF7\u5B9E\u3002\n\u8FD9\u79CD\u4E1C\u897F\u4E0D\u4F1A\u51FA\u73B0\u7B2C\u4E8C\u6B21\u3002"
  - _key: event.EV_CH2_03.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: "\u4EE3\u4FA1\u3092\u6255\u3046"
    _en: Pay the Price
    _zhHant: "\u652F\u4ED8\u4EE3\u50F9"
    _zhHans: "\u652F\u4ED8\u4EE3\u4EF7"
  - _key: event.EV_CH2_03.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: Walk Away
    _zhHant: "\u96E2\u958B"
    _zhHans: "\u79BB\u5F00"
  - _key: event.EV_CH2_04.title
    _ko: "\uAD50\uCC28\uC0AC\uACA9"
    _ja: "\u5341\u5B57\u7832\u706B"
    _en: Crossfire
    _zhHant: "\u4EA4\u53C9\u706B\u529B"
    _zhHans: "\u4EA4\u53C9\u706B\u529B"
  - _key: event.EV_CH2_04.body
    _ko: "\uC591\uCABD \uC625\uC0C1\uC5D0 \uCD1D\uAD6C\uAC00 \uAC78\uB824 \uC788\uB2E4.
      \uC601\uD63C\uC744 \uC870\uAE08 \uD0DC\uC6CC \uBAB8\uC744 \uB0AE\uCD94\uBA74\n\uCCAB
      \uC0AC\uACA9\uC740 \uB118\uAE38 \uC218 \uC788\uB2E4."
    _ja: "\u4E21\u5074\u306E\u5C4B\u4E0A\u306B\u9283\u53E3\u304C\u4E26\u3093\u3067\u3044\u308B\u3002\u9B42\u3092\u5C11\u3057\u71C3\u3084\u3057\u3066\u8EAB\u3092\u4F4E\u304F\u3059\u308C\u3070\u3001\n\u6700\u521D\u306E\u5C04\u6483\u306F\u3084\u308A\u904E\u3054\u305B\u308B\u3002"
    _en: 'Gun barrels line both rooftops. Burn a little soul and keep low,

      and
      you''ll slip past the first volley.'
    _zhHant: "\u5169\u5074\u5C4B\u9802\u90FD\u67B6\u8457\u69CD\u53E3\u3002\u71D2\u6389\u4E00\u9EDE\u9748\u9B42\u58D3\u4F4E\u8EAB\u5B50\uFF0C\n\u5C31\u80FD\u8EB2\u904E\u7B2C\u4E00\u8F2A\u5C04\u64CA\u3002"
    _zhHans: "\u4E24\u4FA7\u5C4B\u9876\u90FD\u67B6\u7740\u67AA\u53E3\u3002\u70E7\u6389\u4E00\u70B9\u7075\u9B42\u538B\u4F4E\u8EAB\u5B50\uFF0C\n\u5C31\u80FD\u8EB2\u8FC7\u7B2C\u4E00\u8F6E\u5C04\u51FB\u3002"
  - _key: event.EV_CH2_04.accept
    _ko: "\uC601\uD63C\uC744 \uD0DC\uC6CC \uB6AB\uB294\uB2E4"
    _ja: "\u9B42\u3092\u71C3\u3084\u3057\u3066\u7A81\u7834\u3059\u308B"
    _en: Burn Soul, Break Through
    _zhHant: "\u71C3\u71D2\u9748\u9B42\u7A81\u7834"
    _zhHans: "\u71C3\u70E7\u7075\u9B42\u7A81\u7834"
  - _key: event.EV_CH2_04.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: "\u5F15\u304D\u8FD4\u3059"
    _en: Turn Back
    _zhHant: "\u6298\u8FD4"
    _zhHans: "\u8FD4\u56DE"
  - _key: event.EV_CH2_05.title
    _ko: "\uC554\uC2DC\uC7A5 \uC5F0\uC904"
    _ja: "\u95C7\u5E02\u306E\u30C4\u30C6"
    _en: Black Market
    _zhHant: "\u9ED1\u5E02\u9580\u8DEF"
    _zhHans: "\u9ED1\u5E02\u95E8\u8DEF"
  - _key: event.EV_CH2_05.body
    _ko: "\uB124\uC628 \uC544\uB798\uC5D0\uC11C \uB204\uAC00 \uC190\uC9D3\uD55C\uB2E4.
      \uBAB8\uC744 \uC880 \uB0B4\uC8FC\uBA74\n\uC774 \uAD6C\uC5ED \uC0C1\uC778\uB4E4\uC5D0\uAC8C
      \uB9D0\uC744 \uB123\uC5B4 \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: "\u30CD\u30AA\u30F3\u306E\u4E0B\u3067\u8AB0\u304B\u304C\u624B\u62DB\u304D\u3057\u3066\u3044\u308B\u3002\u4F53\u3092\u5C11\u3057\u5DEE\u3057\u51FA\u305B\u3070\u3001\n\u3053\u306E\u533A\u57DF\u306E\u5546\u4EBA\u306B\u53E3\u3092\u5229\u3044\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 'Someone beckons under the neon. Give up a little flesh,

      and they''ll
      put in a word with the local merchants.'
    _zhHant: "\u9713\u8679\u71C8\u4E0B\u6709\u4EBA\u5728\u62DB\u624B\u3002\u53EA\u8981\u4EA4\u51FA\u4E00\u9EDE\u8840\u8089\uFF0C\n\u5C31\u5E6B\u4F60\u8DDF\u9019\u4E00\u5340\u7684\u5546\u4EBA\u6253\u8072\u62DB\u547C\u3002"
    _zhHans: "\u9713\u8679\u706F\u4E0B\u6709\u4EBA\u5728\u62DB\u624B\u3002\u53EA\u8981\u4EA4\u51FA\u4E00\u70B9\u8840\u8089\uFF0C\n\u5C31\u5E2E\u4F60\u8DDF\u8FD9\u4E00\u7247\u7684\u5546\u4EBA\u6253\u58F0\u62DB\u547C\u3002"
  - _key: event.EV_CH2_05.accept
    _ko: "\uC0B4\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    _ja: "\u8089\u3092\u5DEE\u3057\u51FA\u3059"
    _en: Give Up Flesh
    _zhHant: "\u5272\u4E0B\u8840\u8089"
    _zhHans: "\u5272\u4E0B\u8840\u8089"
