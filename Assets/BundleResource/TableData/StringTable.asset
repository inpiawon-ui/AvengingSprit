  - _key: askill.psg_h01.name
    _ko: "\uB3C4\uC57D \uAC15\uD0C0"
    _ja: "\u8DF3\u8E8D\u5F37\u6253"
    _en: Leap Smash
    _zhHant: "\u98DB\u8E8D\u91CD\u64CA"
    _zhHans: "\u98DE\u8DC3\u91CD\u51FB"
  - _key: askill.psg_h01.desc
    _ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uB6F0\uC5B4\uB4E4\uC5B4
      \uB458\uB808\uB97C 300% \uD53C\uD574\uB85C \uCE5C\uB2E4."
    _ja: "\u6700\u3082\u8FD1\u3044\u6575\u306B\u98DB\u3073\u8FBC\u307F\u3001\u5468\u56F2\u306B300%\u306E\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002"
    _en: Leap at the nearest enemy, dealing 300% damage around you.
    _zhHant: "\u64B2\u5411\u6700\u8FD1\u7684\u6575\u4EBA\uFF0C\u5C0D\u5468\u570D\u9020\u6210300%\u50B7\u5BB3\u3002"
    _zhHans: "\u6251\u5411\u6700\u8FD1\u7684\u654C\u4EBA\uFF0C\u5BF9\u5468\u56F4\u9020\u6210300%\u4F24\u5BB3\u3002"
  - _key: askill.psg_h02.name
    _ko: "\uBD88\uAD74"
    _ja: "\u4E0D\u5C48"
    _en: Unyielding
    _zhHant: "\u4E0D\u5C48"
    _zhHans: "\u4E0D\u5C48"
  - _key: askill.psg_h02.desc
    _ko: "2.5\uCD08\uAC04 \uBB34\uC801\uC774 \uB41C\uB2E4."
    _ja: "2.5\u79D2\u9593\u3001\u7121\u6575\u306B\u306A\u308B\u3002"
    _en: Become invincible for 2.5s.
    _zhHant: "2.5\u79D2\u5167\u7121\u6575\u3002"
    _zhHans: "2.5\u79D2\u5185\u65E0\u654C\u3002"
  - _key: askill.psg_h03.name
    _ko: "\uC735\uB2E8 \uD3ED\uACA9"
    _ja: "\u7D68\u6BEF\u7206\u6483"
    _en: Carpet Bomb
    _zhHant: "\u5730\u6BEF\u5F0F\u8F5F\u70B8"
    _zhHans: "\u5730\u6BEF\u5F0F\u8F70\u70B8"
  - _key: askill.psg_h03.desc
    _ko: "\uB0B4 \uB458\uB808\uC5D0 \uC218\uB958\uD0C4\uC744 \uC6D0\uC73C\uB85C \uB5A8\uAD70\uB2E4.
      \uAC00\uAE4C\uC6B4 \uC801\uC774 \uC788\uC73C\uBA74 \uADF8 \uC801\uC5D0\uAC8C
      \uB5A8\uC5B4\uC9C4\uB2E4."
    _ja: "\u81EA\u5206\u306E\u5468\u308A\u306B\u624B\u69B4\u5F3E\u3092\u5186\u5F62\u306B\u843D\u3068\u3059\u3002\u8FD1\u304F\u306B\u6575\u304C\u3044\u308C\u3070\u305D\u306E\u6575\u306B\u843D\u3061\u308B\u3002"
    _en: Drop grenades in a ring around you, landing on nearby foes.
    _zhHant: "\u5728\u81EA\u8EAB\u5468\u570D\u74B0\u72C0\u6295\u4E0B\u624B\u69B4\u5F48\u3002\u9644\u8FD1\u6709\u6575\u4EBA\u6642\u6703\u843D\u5728\u6575\u4EBA\u8EAB\u4E0A\u3002"
    _zhHans: "\u5728\u81EA\u8EAB\u5468\u56F4\u73AF\u5F62\u6295\u4E0B\u624B\u69B4\u5F39\u3002\u9644\u8FD1\u6709\u654C\u4EBA\u65F6\u4F1A\u843D\u5728\u654C\u4EBA\u8EAB\u4E0A\u3002"
  - _key: askill.psg_h04.name
    _ko: "\uC5F0\uC1C4 \uBC29\uC804"
    _ja: "\u9023\u9396\u653E\u96FB"
    _en: Chain Discharge
    _zhHant: "\u9023\u9396\u653E\u96FB"
    _zhHans: "\u8FDE\u9501\u653E\u7535"
  - _key: askill.psg_h04.desc
    _ko: "3\uCD08\uAC04 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uC804\uAE30\uAC00 \uACC4\uC18D
      \uD284\uB2E4."
    _ja: "3\u79D2\u9593\u3001\u5468\u56F2\u306E\u6575\u306B\u96FB\u6483\u304C\u8D70\u308A\u7D9A\u3051\u308B\u3002"
    _en: Shock nearby enemies nonstop for 3s.
    _zhHant: "3\u79D2\u5167\u6301\u7E8C\u96FB\u64CA\u5468\u570D\u6575\u4EBA\u3002"
    _zhHans: "3\u79D2\u5185\u6301\u7EED\u7535\u51FB\u5468\u56F4\u654C\u4EBA\u3002"
  - _key: askill.psg_h05.name
    _ko: "\uBC29\uBCBD \uC804\uAC1C"
    _ja: "\u9632\u58C1\u5C55\u958B"
    _en: Barrier
    _zhHant: "\u5C55\u958B\u5C4F\u969C"
    _zhHans: "\u5C55\u5F00\u5C4F\u969C"
  - _key: askill.psg_h05.desc
    _ko: "5\uCD08\uAC04 \uCD5C\uB300 \uCCB4\uB825\uB9CC\uD07C \uC274\uB4DC\uB97C
      \uB450\uB978\uB2E4. \uAE4E\uC774\uBA74 \uB05D\uB09C\uB2E4."
    _ja: "5\u79D2\u9593\u3001\u6700\u5927\u4F53\u529B\u5206\u306E\u30B7\u30FC\u30EB\u30C9\u3092\u307E\u3068\u3046\u3002\u524A\u3089\u308C\u308B\u3068\u6D88\u3048\u308B\u3002"
    _en: Gain a Shield equal to max HP for 5s. Ends when broken.
    _zhHant: "5\u79D2\u5167\u7372\u5F97\u7B49\u540C\u6700\u5927HP\u7684\u8B77\u76FE\uFF0C\u88AB\u6253\u7834\u5373\u6D88\u5931\u3002"
    _zhHans: "5\u79D2\u5185\u83B7\u5F97\u7B49\u540C\u6700\u5927HP\u7684\u62A4\u76FE\uFF0C\u88AB\u51FB\u7834\u5373\u6D88\u5931\u3002"
  - _key: askill.psg_h06.name
    _ko: "\uB2E4\uC911 \uC720\uB3C4"
    _ja: "\u591A\u91CD\u8A98\u5C0E"
    _en: Multi-Homing
    _zhHant: "\u591A\u91CD\u8FFD\u8E64"
    _zhHans: "\u591A\u91CD\u8FFD\u8E2A"
  - _key: askill.psg_h06.desc
    _ko: "\uBBF8\uC0AC\uC77C 7\uBC1C\uC774 \uB458\uB808 \uC801\uB4E4\uC5D0\uAC8C
      \uD55C \uBC1C\uC529 \uB0A0\uC544\uAC04\uB2E4."
    _ja: "\u30DF\u30B5\u30A4\u30EB7\u767A\u304C\u5468\u56F2\u306E\u6575\u30781\u767A\u305A\u3064\u98DB\u3093\u3067\u3044\u304F\u3002"
    _en: 7 missiles fly out, one to each nearby foe.
    _zhHant: "7\u767C\u98DB\u5F48\u5206\u5225\u98DB\u5411\u5468\u570D\u7684\u6575\u4EBA\u3002"
    _zhHans: "7\u679A\u5BFC\u5F39\u5206\u522B\u98DE\u5411\u5468\u56F4\u7684\u654C\u4EBA\u3002"
  - _key: askill.psg_h07.name
    _ko: "\uB1CC\uC804 \uD3ED\uC8FC"
    _ja: "\u96F7\u96FB\u66B4\u8D70"
    _en: Thunder Rampage
    _zhHant: "\u96F7\u96FB\u66B4\u8D70"
    _zhHans: "\u96F7\u7535\u66B4\u8D70"
  - _key: askill.psg_h07.desc
    _ko: "2\uCD08\uAC04 \uBC88\uAC1C \uD295\uAE40\uC774 \uBC18\uB4DC\uC2DC \uD130\uC9C4\uB2E4."
    _ja: "2\u79D2\u9593\u3001\u9023\u9396\u96F7\u304C\u5FC5\u305A\u767A\u751F\u3059\u308B\u3002"
    _en: Chain lightning always triggers for 2s.
    _zhHant: "2\u79D2\u5167\u5FC5\u5B9A\u89F8\u767C\u9023\u9396\u9583\u96FB\u3002"
    _zhHans: "2\u79D2\u5185\u5FC5\u5B9A\u89E6\u53D1\u8FDE\u9501\u95EA\u7535\u3002"
  - _key: askill.psg_h08.name
    _ko: "\uB3C5 \uBFDC\uAE30"
    _ja: "\u6BD2\u9727\u5674\u5C04"
    _en: Venom Spray
    _zhHant: "\u5674\u5410\u6BD2\u9727"
    _zhHans: "\u55B7\u5410\u6BD2\u96FE"
  - _key: askill.psg_h08.desc
    _ko: "\uB458\uB808 5 m \uC758 \uC801\uC744 \uBAA8\uB450 \uC911\uB3C5\uC2DC\uD0A8\uB2E4.
      \uB3C5\uC740 \uC544\uD504\uACE0 \uB290\uB824\uC9C4\uB2E4."
    _ja: "\u5468\u56F25m\u306E\u6575\u3092\u6BD2\u72B6\u614B\u306B\u3059\u308B\u3002\u6BD2\u306F\u30C0\u30E1\u30FC\u30B8\u3068\u920D\u8DB3\u3092\u4E0E\u3048\u308B\u3002"
    _en: Poison all enemies within 5 m. Poison damages and slows.
    _zhHant: "\u4F7F\u5468\u570D5m\u5167\u6240\u6709\u6575\u4EBA\u4E2D\u6BD2\u3002\u4E2D\u6BD2\u6703\u9020\u6210\u50B7\u5BB3\u4E26\u6E1B\u901F\u3002"
    _zhHans: "\u4F7F\u5468\u56F45m\u5185\u6240\u6709\u654C\u4EBA\u4E2D\u6BD2\u3002\u4E2D\u6BD2\u4F1A\u9020\u6210\u4F24\u5BB3\u5E76\u51CF\u901F\u3002"
  - _key: askill.psg_h09.name
    _ko: "\uD654\uC5FC \uC9C0\uB300"
    _ja: "\u706B\u708E\u5730\u5E2F"
    _en: Fire Zone
    _zhHant: "\u706B\u7130\u5730\u5E36"
    _zhHans: "\u706B\u7130\u5730\u5E26"
  - _key: askill.psg_h09.desc
    _ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uBC1C\uBC11\uC5D0 \uBD88\uBC14\uB2E4\uB97C
      \uD3B8\uB2E4. \uBC1F\uACE0 \uC120 \uC801\uC774 \uACC4\uC18D \uD0C4\uB2E4."
    _ja: "\u6700\u3082\u8FD1\u3044\u6575\u306E\u8DB3\u5143\u306B\u706B\u306E\u6D77\u3092\u5E83\u3052\u308B\u3002\u4E0A\u306B\u7ACB\u3064\u6575\u306F\u71C3\u3048\u7D9A\u3051\u308B\u3002"
    _en: Spread fire under the nearest enemy. Enemies on it keep burning.
    _zhHant: "\u5728\u6700\u8FD1\u7684\u6575\u4EBA\u8173\u4E0B\u5C55\u958B\u706B\u6D77\uFF0C\u7AD9\u5728\u4E0A\u9762\u7684\u6575\u4EBA\u6703\u6301\u7E8C\u71C3\u71D2\u3002"
    _zhHans: "\u5728\u6700\u8FD1\u7684\u654C\u4EBA\u811A\u4E0B\u5C55\u5F00\u706B\u6D77\uFF0C\u7AD9\u5728\u4E0A\u9762\u7684\u654C\u4EBA\u4F1A\u6301\u7EED\u71C3\u70E7\u3002"
  - _key: askill.psg_h10.name
    _ko: "\uC77C\uC81C \uD45C\uC2DD"
    _ja: "\u4E00\u6589\u30DE\u30FC\u30AD\u30F3\u30B0"
    _en: Mass Mark
    _zhHant: "\u5168\u9AD4\u6A19\u8A18"
    _zhHans: "\u5168\u4F53\u6807\u8BB0"
  - _key: askill.psg_h10.desc
    _ko: "\uBC29 \uC548 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C 3\uCD08\uAC04 \uD45C\uC2DD\uC744
      \uC0C8\uAE34\uB2E4."
    _ja: "\u90E8\u5C4B\u306B\u3044\u308B\u3059\u3079\u3066\u306E\u6575\u306B3\u79D2\u9593\u30DE\u30FC\u30AD\u30F3\u30B0\u3092\u523B\u3080\u3002"
    _en: Mark every enemy in the room for 3s.
    _zhHant: "\u70BA\u623F\u9593\u5167\u6240\u6709\u6575\u4EBA\u65BD\u52A03\u79D2\u6A19\u8A18\u3002"
    _zhHans: "\u4E3A\u623F\u95F4\u5185\u6240\u6709\u654C\u4EBA\u65BD\u52A03\u79D2\u6807\u8BB0\u3002"
  - _key: askill.psg_h11.name
    _ko: "\uB09C\uC0AC"
    _ja: "\u4E71\u5C04"
    _en: Bullet Storm
    _zhHant: "\u4E82\u5C04"
    _zhHans: "\u4E71\u5C04"
  - _key: askill.psg_h11.desc
    _ko: "\uB2E4\uC12F \uAC08\uB798\uB85C \uC138 \uBC88 \uBE60\uB974\uAC8C \uC3DC\uB2E4."
    _ja: "5\u65B9\u5411\u306E\u5F3E\u3092\u7D20\u65E9\u304F3\u9023\u5C04\u3059\u308B\u3002"
    _en: Fire a 5-way spread 3 times in quick succession.
    _zhHant: "\u5411\u4E94\u500B\u65B9\u5411\u5FEB\u901F\u9023\u5C043\u6B21\u3002"
    _zhHans: "\u5411\u4E94\u4E2A\u65B9\u5411\u5FEB\u901F\u8FDE\u5C043\u6B21\u3002"
  - _key: askill.psg_h12.name
    _ko: "\uC218\uD638 \uACB0\uACC4"
    _ja: "\u5B88\u8B77\u7D50\u754C"
    _en: Guardian Ward
    _zhHant: "\u5B88\u8B77\u7D50\u754C"
    _zhHans: "\u5B88\u62A4\u7ED3\u754C"
  - _key: askill.psg_h12.desc
    _ko: "3\uCD08\uAC04 \uBC1B\uB294 \uD53C\uD574 \u221250% \xB7 \uC274\uB4DC \uD68D\uB4DD
      2\uBC30."
    _ja: "3\u79D2\u9593\u3001\u88AB\u30C0\u30E1\u30FC\u30B8\u221250%\u30FB\u30B7\u30FC\u30EB\u30C9\u7372\u5F97\u91CF2\u500D\u3002"
    _en: "For 3s: damage taken \u221250%, Shield gain x2."
    _zhHant: "3\u79D2\u5167\u53D7\u5230\u50B7\u5BB3\u221250%\uFF0C\u8B77\u76FE\u7372\u5F97\u91CF2\u500D\u3002"
    _zhHans: "3\u79D2\u5185\u53D7\u5230\u4F24\u5BB3\u221250%\uFF0C\u62A4\u76FE\u83B7\u5F97\u91CF2\u500D\u3002"
  - _key: askill.psg_h13.name
    _ko: "\uC815\uC870\uC900"
    _ja: "\u7CBE\u5BC6\u7167\u6E96"
    _en: Dead Aim
    _zhHant: "\u7CBE\u6E96\u7784\u6E96"
    _zhHans: "\u7CBE\u51C6\u7784\u51C6"
  - _key: askill.psg_h13.desc
    _ko: "5\uCD08\uAC04 \uCE58\uBA85\uD0C0 \uD655\uB960\uC774 90% \uB85C \uACE0\uC815\uB41C\uB2E4."
    _ja: "5\u79D2\u9593\u3001\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u7387\u304C90%\u306B\u56FA\u5B9A\u3055\u308C\u308B\u3002"
    _en: Crit chance locked at 90% for 5s.
    _zhHant: "5\u79D2\u5167\u66B4\u64CA\u7387\u56FA\u5B9A\u70BA90%\u3002"
    _zhHans: "5\u79D2\u5185\u66B4\u51FB\u7387\u56FA\u5B9A\u4E3A90%\u3002"
  - _key: askill.psg_h14.name
    _ko: "\uBC31\uC2A4\uD15D \uC0AC\uACA9"
    _ja: "\u30D0\u30C3\u30AF\u30B9\u30C6\u30C3\u30D7\u5C04\u6483"
    _en: Backstep Fire
    _zhHant: "\u5F8C\u64A4\u5C04\u64CA"
    _zhHans: "\u540E\u64A4\u5C04\u51FB"
  - _key: askill.psg_h14.desc
    _ko: "\uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C\uC11C \uB4A4\uB85C \uD06C\uAC8C \uB6F0\uBA70
      \uC55E\uC73C\uB85C \uBD80\uCC44\uAF34 \uC5F0\uC0AC."
    _ja: "\u8FD1\u304F\u306E\u6575\u304B\u3089\u5927\u304D\u304F\u5F8C\u308D\u3078\u8DF3\u3073\u3001\u524D\u65B9\u3078\u6247\u72B6\u306B\u9023\u5C04\u3059\u308B\u3002"
    _en: Leap back from the nearest enemy while spraying a fan of shots forward.
    _zhHant: "\u5F9E\u6700\u8FD1\u7684\u6575\u4EBA\u8EAB\u908A\u5927\u6B65\u5F8C\u8DF3\uFF0C\u540C\u6642\u5411\u524D\u65B9\u6247\u5F62\u9023\u5C04\u3002"
    _zhHans: "\u4ECE\u6700\u8FD1\u7684\u654C\u4EBA\u8EAB\u8FB9\u5927\u6B65\u540E\u8DF3\uFF0C\u540C\u65F6\u5411\u524D\u65B9\u6247\u5F62\u8FDE\u5C04\u3002"
  - _key: askill.psg_h15.name
    _ko: "\uBBF8\uB2C8 \uACE8\uB818"
    _ja: "\u30DF\u30CB\u30B4\u30FC\u30EC\u30E0"
    _en: Mini Golem
    _zhHant: "\u8FF7\u4F60\u9B54\u50CF"
    _zhHans: "\u8FF7\u4F60\u9B54\u50CF"
  - _key: askill.psg_h15.desc
    _ko: "\uBBF8\uB2C8 \uACE8\uB818\uC744 \uBD88\uB7EC 10\uCD08\uAC04 \uB370\uB9AC\uACE0
      \uB2E4\uB2C8\uBA70 \uAC19\uC774 \uC2F8\uC6B4\uB2E4."
    _ja: "\u30DF\u30CB\u30B4\u30FC\u30EC\u30E0\u3092\u547C\u3073\u300110\u79D2\u9593\u9023\u308C\u3066\u4E00\u7DD2\u306B\u6226\u3046\u3002"
    _en: Summon a mini golem that follows and fights with you for 10s.
    _zhHant: "\u53EC\u559A\u8FF7\u4F60\u9B54\u50CF\uFF0C10\u79D2\u5167\u8DDF\u96A8\u4F60\u4E00\u8D77\u6230\u9B25\u3002"
    _zhHans: "\u53EC\u5524\u8FF7\u4F60\u9B54\u50CF\uFF0C10\u79D2\u5185\u8DDF\u968F\u4F60\u4E00\u8D77\u6218\u6597\u3002"
  - _key: askill.psg_h16.name
    _ko: "\uC911\uB825\uC9C4"
    _ja: "\u91CD\u529B\u9663"
    _en: Gravity Well
    _zhHant: "\u91CD\u529B\u9663"
    _zhHans: "\u91CD\u529B\u9635"
  - _key: askill.psg_h16.desc
    _ko: "\uC801\uC774 \uAC00\uC7A5 \uBAB0\uB9B0 \uC790\uB9AC\uC5D0 \uD669\uAE08
      \uB9C8\uBC95\uC9C4\uC744 \uD3BC\uCCD0 1.2\uCD08 \uB3D9\uC548 \uAC00\uC6B4\uB370\uB85C
      \uBE68\uC544\uB4E4\uC774\uBA70 \uAE4E\uB2E4\uAC00, \uBE5B\uC73C\uB85C \uD130\uB728\uB9B0\uB2E4."
    _ja: "\u6575\u304C\u6700\u3082\u96C6\u307E\u3063\u305F\u5834\u6240\u306B\u9EC4\u91D1\u306E\u9B54\u6CD5\u9663\u3092\u5E83\u3052\u30011.2\u79D2\u9593\u4E2D\u5FC3\u3078\u5F15\u304D\u5BC4\u305B\u306A\u304C\u3089\u524A\u308A\u3001\u5149\u3067\u7206\u767A\u3055\u305B\u308B\u3002"
    _en: Open a golden circle where foes crowd, pull them to the center for 1.2s
      while chipping away, then burst in light.
    _zhHant: "\u5728\u6575\u4EBA\u6700\u5BC6\u96C6\u8655\u5C55\u958B\u9EC3\u91D1\u9B54\u6CD5\u9663\uFF0C1.2\u79D2\u5167\u5C07\u6575\u4EBA\u5438\u5411\u4E2D\u5FC3\u4E26\u6301\u7E8C\u524A\u8840\uFF0C\u6700\u5F8C\u4EE5\u5149\u8292\u5F15\u7206\u3002"
    _zhHans: "\u5728\u654C\u4EBA\u6700\u5BC6\u96C6\u5904\u5C55\u5F00\u9EC4\u91D1\u9B54\u6CD5\u9635\uFF0C1.2\u79D2\u5185\u5C06\u654C\u4EBA\u5438\u5411\u4E2D\u5FC3\u5E76\u6301\u7EED\u6389\u8840\uFF0C\u6700\u540E\u4EE5\u5149\u8292\u5F15\u7206\u3002"
  - _key: askill.psg_h17.name
    _ko: "\uC0AC\uC2AC \uB04C\uC5B4\uC624\uAE30"
    _ja: "\u9396\u5F15\u304D\u5BC4\u305B"
    _en: Chain Pull
    _zhHant: "\u9396\u93C8\u727D\u5F15"
    _zhHans: "\u9501\u94FE\u7275\u5F15"
  - _key: askill.psg_h17.desc
    _ko: "\uB458\uB808 \uC801 5\uBA85\uC744 \uC0AC\uC2AC\uB85C \uB0B4 \uC55E\uC5D0
      \uB04C\uC5B4\uC640 \uBB36\uACE0 \uD55C \uBC88\uC5D0 \uD6C4\uB824\uCE5C\uB2E4.
      \uBB36\uC778 \uC801\uC740 \uB354 \uC544\uD504\uAC8C \uB9DE\uB294\uB2E4."
    _ja: "\u5468\u56F2\u306E\u65755\u4F53\u3092\u9396\u3067\u76EE\u306E\u524D\u306B\u5F15\u304D\u5BC4\u305B\u3066\u7E1B\u308A\u3001\u307E\u3068\u3081\u3066\u8599\u304E\u6255\u3046\u3002\u7E1B\u3089\u308C\u305F\u6575\u3078\u306E\u30C0\u30E1\u30FC\u30B8\u5897\u52A0\u3002"
    _en: Chain up to 5 nearby foes, yank them in front of you, bind them and strike
      them all. Bound foes take more damage.
    _zhHant: "\u7528\u9396\u93C8\u5C07\u5468\u570D5\u540D\u6575\u4EBA\u62C9\u5230\u9762\u524D\u7D91\u7D81\uFF0C\u4E00\u6B21\u6A6B\u6383\u3002\u88AB\u7D91\u7D81\u7684\u6575\u4EBA\u53D7\u5230\u66F4\u591A\u50B7\u5BB3\u3002"
    _zhHans: "\u7528\u9501\u94FE\u5C06\u5468\u56F45\u540D\u654C\u4EBA\u62C9\u5230\u9762\u524D\u6346\u7ED1\uFF0C\u4E00\u6B21\u6A2A\u626B\u3002\u88AB\u6346\u7ED1\u7684\u654C\u4EBA\u53D7\u5230\u66F4\u591A\u4F24\u5BB3\u3002"
  - _key: askill.psg_h18.name
    _ko: "\uADF8\uB9BC\uC790 \uAC78\uC74C"
    _ja: "\u5F71\u8D70\u308A"
    _en: Shadow Step
    _zhHant: "\u5F71\u6B65"
    _zhHans: "\u5F71\u6B65"
  - _key: askill.psg_h18.desc
    _ko: "4\uCD08\uAC04 \uD68C\uD53C 50% \xB7 \uC774\uB3D9 \uC18D\uB3C4 +35%, \uC794\uC0C1\uC774
      \uB0A8\uB294\uB2E4."
    _ja: "4\u79D2\u9593\u3001\u56DE\u907F50%\u30FB\u79FB\u52D5\u901F\u5EA6+35%\u3001\u6B8B\u50CF\u304C\u6B8B\u308B\u3002"
    _en: For 4s, 50% dodge and +35% move speed, leaving afterimages.
    _zhHant: "4\u79D2\u5167\u9583\u907F50%\uFF0C\u79FB\u52D5\u901F\u5EA6+35%\uFF0C\u4E26\u7559\u4E0B\u6B98\u5F71\u3002"
    _zhHans: "4\u79D2\u5185\u95EA\u907F50%\uFF0C\u79FB\u52A8\u901F\u5EA6+35%\uFF0C\u5E76\u7559\u4E0B\u6B8B\u5F71\u3002"
  - _key: askill.psg_h19.name
    _ko: "\uD3EC\uD0D1 \uC804\uAC1C"
    _ja: "\u7832\u53F0\u5C55\u958B"
    _en: Deploy Turret
    _zhHant: "\u67B6\u8A2D\u7832\u53F0"
    _zhHans: "\u90E8\u7F72\u70AE\u53F0"
  - _key: askill.psg_h19.desc
    _ko: "10\uCD08\uAC04 \uC790\uB3D9\uC73C\uB85C \uC3D8\uB294 \uD3EC\uD0D1\uC744
      \uC138\uC6B4\uB2E4."
    _ja: "10\u79D2\u9593\u3001\u81EA\u52D5\u3067\u6483\u3064\u7832\u53F0\u3092\u8A2D\u7F6E\u3059\u308B\u3002"
    _en: Deploy an auto-firing turret for 10s.
    _zhHant: "\u67B6\u8A2D\u4E00\u5EA7\u81EA\u52D5\u5C04\u64CA\u7684\u7832\u53F0\uFF0C\u6301\u7E8C10\u79D2\u3002"
    _zhHans: "\u90E8\u7F72\u4E00\u5EA7\u81EA\u52A8\u5C04\u51FB\u7684\u70AE\u53F0\uFF0C\u6301\u7EED10\u79D2\u3002"
  - _key: askill.psg_h20.name
    _ko: "\uC804\uD0C4 \uBC18\uC0AC"
    _ja: "\u5168\u5F3E\u53CD\u5C04"
    _en: Full Reflect
    _zhHant: "\u5168\u5F48\u53CD\u5C04"
    _zhHans: "\u5168\u5F39\u53CD\u5C04"
  - _key: askill.psg_h20.desc
    _ko: "5\uCD08\uAC04 \uB0A0\uC544\uC624\uB294 \uD0C4\uC744 \uB418\uBC1B\uC544\uCE5C\uB2E4.
      \uBC18\uC0AC\uD0C4\uC740 \uB354 \uC544\uD504\uB2E4."
    _ja: "5\u79D2\u9593\u3001\u98DB\u3093\u3067\u304F\u308B\u5F3E\u3092\u8DF3\u306D\u8FD4\u3059\u3002\u53CD\u5C04\u5F3E\u306F\u5A01\u529B\u304C\u9AD8\u3044\u3002"
    _en: Reflect incoming bullets for 5s. Reflected shots hit harder.
    _zhHant: "5\u79D2\u5167\u53CD\u5F48\u98DB\u4F86\u7684\u5B50\u5F48\u3002\u53CD\u5F48\u7684\u5B50\u5F48\u5A01\u529B\u66F4\u9AD8\u3002"
    _zhHans: "5\u79D2\u5185\u53CD\u5F39\u98DE\u6765\u7684\u5B50\u5F39\u3002\u53CD\u5F39\u7684\u5B50\u5F39\u5A01\u529B\u66F4\u9AD8\u3002"
  - _key: askill.psg_h21.name
    _ko: "\uC5BC\uC74C \uAC10\uC625"
    _ja: "\u6C37\u306E\u7262\u7344"
    _en: Ice Prison
    _zhHant: "\u51B0\u4E4B\u7262\u7344"
    _zhHans: "\u51B0\u4E4B\u7262\u72F1"
  - _key: askill.psg_h21.desc
    _ko: "1\uCD08\uAC04 \uC5BC\uC74C\uC5D0 \uB4E4\uC5B4\uAC04\uB2E4. \uB9DE\uC9C0\uB3C4
      \uB54C\uB9AC\uC9C0\uB3C4 \uC54A\uACE0 \uCCB4\uB825 30% \uB97C \uCC44\uC6B4\uB2E4."
    _ja: "1\u79D2\u9593\u3001\u6C37\u306B\u9589\u3058\u3053\u3082\u308B\u3002\u653B\u6483\u3092\u53D7\u3051\u305A\u4E0E\u3048\u305A\u3001\u4F53\u529B\u309230%\u56DE\u5FA9\u3059\u308B\u3002"
    _en: Encase yourself in ice for 1s. No damage dealt or taken; heal 30% HP.
    _zhHant: "\u5C01\u5165\u51B0\u4E2D1\u79D2\u3002\u4E0D\u53D7\u50B7\u4E5F\u4E0D\u653B\u64CA\uFF0C\u56DE\u5FA930%HP\u3002"
    _zhHans: "\u5C01\u5165\u51B0\u4E2D1\u79D2\u3002\u4E0D\u53D7\u4F24\u4E5F\u4E0D\u653B\u51FB\uFF0C\u6062\u590D30%HP\u3002"
  - _key: askill.psg_h22.name
    _ko: "\uD608\uC5F0"
    _ja: "\u8840\u5BB4"
    _en: Blood Feast
    _zhHant: "\u8840\u5BB4"
    _zhHans: "\u8840\u5BB4"
  - _key: askill.psg_h22.desc
    _ko: "\uD654\uBA74\uC758 \uC801\uB9C8\uB2E4 \uBC15\uC950\uAC00 \uB0A0\uC544\uAC00
      \uD53C\uB97C \uBE68\uC544 \uC628\uB2E4. \uC801 \uC218\uB9CC\uD07C \uCD5C\uB300
      \uCCB4\uB825\uC758 2%\uC529 \uD68C\uBCF5."
    _ja: "\u753B\u9762\u5185\u306E\u6575\u3054\u3068\u306B\u30B3\u30A6\u30E2\u30EA\u304C\u98DB\u3093\u3067\u8840\u3092\u5438\u3063\u3066\u304F\u308B\u3002\u6575\u306E\u6570\u3060\u3051\u6700\u5927\u4F53\u529B\u306E2%\u305A\u3064\u56DE\u5FA9\u3002"
    _en: A bat flies to each foe on screen and drains blood. Heal 2% max HP per foe.
    _zhHant: "\u8759\u8760\u98DB\u5411\u756B\u9762\u4E2D\u6BCF\u500B\u6575\u4EBA\u5438\u8840\u3002\u6BCF\u500B\u6575\u4EBA\u56DE\u5FA9\u6700\u5927HP\u76842%\u3002"
    _zhHans: "\u8759\u8760\u98DE\u5411\u753B\u9762\u4E2D\u6BCF\u4E2A\u654C\u4EBA\u5438\u8840\u3002\u6BCF\u4E2A\u654C\u4EBA\u6062\u590D\u6700\u5927HP\u76842%\u3002"
  - _key: askill.psg_h23.name
    _ko: "\uC0AC\uC2E0\uC758 \uC2DC\uAC04"
    _ja: "\u6B7B\u795E\u306E\u523B"
    _en: Death's Hour
    _zhHant: "\u6B7B\u795E\u4E4B\u523B"
    _zhHans: "\u6B7B\u795E\u4E4B\u523B"
  - _key: askill.psg_h23.desc
    _ko: "3\uCD08\uAC04 \uB54C\uB9AC\uB294 \uC801\uC774 \uC8FD\uB294\uB2E4. \uC911\uAC04
      \uBCF4\uC2A4\uB294 \uC808\uBC18, \uBCF4\uC2A4\uB294 \uC5F4\uC5D0 \uD558\uB098."
    _ja: "3\u79D2\u9593\u3001\u653B\u6483\u3057\u305F\u6575\u3092\u5373\u6B7B\u3055\u305B\u308B\u3002\u4E2D\u30DC\u30B9\u306F\u534A\u5206\u3001\u30DC\u30B9\u306F10\u5206\u306E1\u3002"
    _en: For 3s, enemies you hit die. Mini-bosses lose half, bosses a tenth.
    _zhHant: "3\u79D2\u5167\u88AB\u4F60\u653B\u64CA\u7684\u6575\u4EBA\u5373\u6B7B\u3002\u4E2D\u982D\u76EE\u6263\u4E00\u534A\uFF0C\u982D\u76EE\u6263\u5341\u5206\u4E4B\u4E00\u3002"
    _zhHans: "3\u79D2\u5185\u88AB\u4F60\u653B\u51FB\u7684\u654C\u4EBA\u5373\u6B7B\u3002\u4E2D\u5934\u76EE\u6263\u4E00\u534A\uFF0C\u5934\u76EE\u6263\u5341\u5206\u4E4B\u4E00\u3002"
  - _key: pskill.psv_amazon.name
    _ko: "\uC274\uB4DC \uC9C8\uC8FC"
    _ja: "\u30B7\u30FC\u30EB\u30C9\u75BE\u8D70"
    _en: Shield Dash
    _zhHant: "\u8B77\u76FE\u75BE\u99B3"
    _zhHans: "\u62A4\u76FE\u75BE\u9A70"
  - _key: pskill.psv_amazon.desc
    _ko: "\uC274\uB4DC\uAC00 \uCC30\uC218\uB85D \uBE68\uB77C\uC9C4\uB2E4. \uAC00\uB4DD\uC774\uBA74
      \uC774\uB3D9\uC18D\uB3C4 +40%."
    _ja: "\u30B7\u30FC\u30EB\u30C9\u304C\u6E9C\u307E\u308B\u307B\u3069\u901F\u304F\u306A\u308B\u3002\u6700\u5927\u6642\u306F\u79FB\u52D5\u901F\u5EA6+40%\u3002"
    _en: 'Faster as Shield fills. Full: Speed +40%.'
    _zhHant: "\u8B77\u76FE\u8D8A\u6EFF\u901F\u5EA6\u8D8A\u5FEB\u3002\u5168\u6EFF\u6642\u79FB\u52D5\u901F\u5EA6+40%\u3002"
    _zhHans: "\u62A4\u76FE\u8D8A\u6EE1\u901F\u5EA6\u8D8A\u5FEB\u3002\u5145\u6EE1\u65F6\u79FB\u52A8\u901F\u5EA6+40%\u3002"
  - _key: pskill.psv_counter.name
    _ko: "\uC5ED\uC804\uC758 \uC790\uC138"
    _ja: "\u9006\u8EE2\u306E\u69CB\u3048"
    _en: Comeback Stance
    _zhHant: "\u9006\u8F49\u67B6\u52E2"
    _zhHans: "\u9006\u8F6C\u67B6\u52BF"
  - _key: pskill.psv_counter.desc
    _ko: "\uC274\uB4DC\uAC00 \uB0A8\uC544 \uC788\uB294 \uB3D9\uC548 \uACF5\uACA9\uB825\uC774
      \uC624\uB978\uB2E4."
    _ja: "\u30B7\u30FC\u30EB\u30C9\u304C\u6B8B\u3063\u3066\u3044\u308B\u9593\u3001\u653B\u6483\u529B\u304C\u4E0A\u304C\u308B\u3002"
    _en: Attack up while Shield remains.
    _zhHant: "\u8B77\u76FE\u5B58\u5728\u671F\u9593\u653B\u64CA\u529B\u63D0\u5347\u3002"
    _zhHans: "\u62A4\u76FE\u5B58\u5728\u671F\u95F4\u653B\u51FB\u529B\u63D0\u5347\u3002"
  - _key: pskill.psv_slugger.name
    _ko: "\uC7A5\uC678 \uD0C0\uAD6C"
    _ja: "\u5834\u5916\u5F3E"
    _en: Home Run
    _zhHant: "\u5834\u5916\u5168\u58D8\u6253"
    _zhHans: "\u573A\u5916\u672C\u5792\u6253"
  - _key: pskill.psv_slugger.desc
    _ko: "\uB9C9\uD0C0\uC5D0 20% \uB85C \uC8FC\uBCC0 \uC801\uC744 \uB0A0\uB824 \uBC84\uB9B0\uB2E4."
    _ja: "\u3068\u3069\u3081\u306E\u4E00\u6483\u306720%\u306E\u78BA\u7387\u3067\u5468\u56F2\u306E\u6575\u3092\u5439\u304D\u98DB\u3070\u3059\u3002"
    _en: Final blows have a 20% chance to knock away nearby enemies.
    _zhHant: "\u6700\u5F8C\u4E00\u64CA\u670920%\u6A5F\u7387\u64CA\u98DB\u5468\u570D\u6575\u4EBA\u3002"
    _zhHans: "\u6700\u540E\u4E00\u51FB\u670920%\u51E0\u7387\u51FB\u98DE\u5468\u56F4\u654C\u4EBA\u3002"
  - _key: pskill.psv_death.name
    _ko: "\uB9DD\uC790 \uC18C\uC9D1"
    _ja: "\u4EA1\u8005\u53EC\u96C6"
    _en: Call of the Dead
    _zhHant: "\u4EA1\u8005\u53EC\u96C6"
    _zhHans: "\u4EA1\u8005\u53EC\u96C6"
  - _key: pskill.psv_death.desc
    _ko: "\uC801\uC744 \uC7A1\uC744 \uB54C\uB9C8\uB2E4 \uADF8 \uC790\uB9AC\uC5D0\uC11C
      \uD574\uACE8\uC774 \uC77C\uC5B4\uC120\uB2E4."
    _ja: "\u6575\u3092\u5012\u3059\u305F\u3073\u3001\u305D\u306E\u5834\u306B\u30B9\u30B1\u30EB\u30C8\u30F3\u304C\u8D77\u304D\u4E0A\u304C\u308B\u3002"
    _en: A skeleton rises wherever you kill an enemy.
    _zhHant: "\u6BCF\u64CA\u5012\u4E00\u540D\u6575\u4EBA\uFF0C\u8A72\u8655\u5C31\u6703\u7AD9\u8D77\u4E00\u5177\u9AB7\u9ACF\u3002"
    _zhHans: "\u6BCF\u51FB\u5012\u4E00\u540D\u654C\u4EBA\uFF0C\u8BE5\u5904\u5C31\u4F1A\u7AD9\u8D77\u4E00\u5177\u9AB7\u9AC5\u3002"
  - _key: pskill.psv_guru.name
    _ko: "\uBB34\uD615\uBCF4"
    _ja: "\u7121\u5F62\u6B69"
    _en: Phase Walk
    _zhHant: "\u7121\u5F62\u6B65"
    _zhHans: "\u65E0\u5F62\u6B65"
  - _key: pskill.psv_guru.desc
    _ko: "\uAC78\uC5B4 \uB2E4\uB2D0 \uB54C \uC9C0\uD615\uC9C0\uBB3C\uC744 \uD1B5\uACFC\uD55C\uB2E4."
    _ja: "\u6B69\u3044\u3066\u3044\u308B\u9593\u3001\u969C\u5BB3\u7269\u3092\u3059\u308A\u629C\u3051\u308B\u3002"
    _en: Walk through obstacles.
    _zhHant: "\u884C\u8D70\u6642\u53EF\u7A7F\u904E\u969C\u7919\u7269\u3002"
    _zhHans: "\u884C\u8D70\u65F6\u53EF\u7A7F\u8FC7\u969C\u788D\u7269\u3002"
  - _key: pskill.psv_ninja_chain.name
    _ko: "\uD758\uB9AC\uAE30"
    _ja: "\u53D7\u3051\u6D41\u3057"
    _en: Parry
    _zhHant: "\u62DB\u67B6"
    _zhHans: "\u62DB\u67B6"
  - _key: pskill.psv_ninja_chain.desc
    _ko: "10% \uB85C \uD53C\uD574\uB97C \uD1B5\uC9F8\uB85C \uD758\uB9B0\uB2E4."
    _ja: "10%\u306E\u78BA\u7387\u3067\u30C0\u30E1\u30FC\u30B8\u3092\u4E38\u3054\u3068\u53D7\u3051\u6D41\u3059\u3002"
    _en: 10% chance to negate all damage.
    _zhHant: "10%\u6A5F\u7387\u5B8C\u5168\u5316\u89E3\u50B7\u5BB3\u3002"
    _zhHans: "10%\u51E0\u7387\u5B8C\u5168\u5316\u89E3\u4F24\u5BB3\u3002"
  - _key: pskill.psv_dragoon.name
    _ko: "\uBD88\uC528"
    _ja: "\u706B\u7A2E"
    _en: Ember
    _zhHant: "\u706B\u7A2E"
    _zhHans: "\u706B\u79CD"
  - _key: pskill.psv_dragoon.desc
    _ko: "\uBA85\uC911\uD55C \uC801\uC5D0\uAC8C 10% \uB85C \uD654\uC0C1. \uACB9\uCE58\uC9C0
      \uC54A\uB294\uB2E4."
    _ja: "\u547D\u4E2D\u3057\u305F\u6575\u306B10%\u306E\u78BA\u7387\u3067\u71C3\u713C\u3002\u91CD\u8907\u3057\u306A\u3044\u3002"
    _en: 10% chance to Burn on hit. Doesn't stack.
    _zhHant: "\u547D\u4E2D\u6575\u4EBA\u664210%\u6A5F\u7387\u9020\u6210\u71D2\u50B7\u3002\u4E0D\u53EF\u758A\u52A0\u3002"
    _zhHans: "\u547D\u4E2D\u654C\u4EBA\u65F610%\u51E0\u7387\u9020\u6210\u707C\u70E7\u3002\u4E0D\u53EF\u53E0\u52A0\u3002"
  - _key: pskill.psv_salamander.name
    _ko: "\uB3C5\uB2C8"
    _ja: "\u6BD2\u7259"
    _en: Venom Fang
    _zhHant: "\u6BD2\u7259"
    _zhHans: "\u6BD2\u7259"
  - _key: pskill.psv_salamander.desc
    _ko: "\uBA85\uC911\uD55C \uC801\uC5D0\uAC8C 10% \uB85C \uB3C5. \uC911\uB3C5\uB41C
      \uC801\uC740 25% \uB354 \uC544\uD504\uAC8C \uB9DE\uB294\uB2E4."
    _ja: "\u547D\u4E2D\u3057\u305F\u6575\u306B10%\u306E\u78BA\u7387\u3067\u6BD2\u3002\u6BD2\u72B6\u614B\u306E\u6575\u3078\u306E\u30C0\u30E1\u30FC\u30B8+25%\u3002"
    _en: 10% chance to Poison on hit. Poisoned foes take 25% more damage.
    _zhHant: "\u547D\u4E2D\u6575\u4EBA\u664210%\u6A5F\u7387\u4E2D\u6BD2\u3002\u4E2D\u6BD2\u7684\u6575\u4EBA\u53D7\u5230\u7684\u50B7\u5BB3+25%\u3002"
    _zhHans: "\u547D\u4E2D\u654C\u4EBA\u65F610%\u51E0\u7387\u4E2D\u6BD2\u3002\u4E2D\u6BD2\u7684\u654C\u4EBA\u53D7\u5230\u7684\u4F24\u5BB3+25%\u3002"
  - _key: pskill.psv_dragon_blue.name
    _ko: "\uB099\uB8B0"
    _ja: "\u843D\u96F7"
    _en: Thunderbolt
    _zhHant: "\u843D\u96F7"
    _zhHans: "\u843D\u96F7"
  - _key: pskill.psv_dragon_blue.desc
    _ko: "10% \uB85C \uC606 \uC801\uC5D0\uAC8C \uBC88\uAC1C\uAC00 \uD284\uB2E4. \uD288
      \uC801\uC774 \uC5C6\uC73C\uBA74 \uD130\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
    _ja: "10%\u306E\u78BA\u7387\u3067\u96A3\u306E\u6575\u306B\u96F7\u304C\u8DF3\u3076\u3002\u8DF3\u3076\u5148\u304C\u3044\u306A\u3051\u308C\u3070\u767A\u52D5\u3057\u306A\u3044\u3002"
    _en: 10% chance for lightning to jump to a nearby enemy. Needs a target.
    _zhHant: "10%\u6A5F\u7387\u5C0D\u65C1\u908A\u7684\u6575\u4EBA\u5F48\u5C04\u9583\u96FB\u3002\u6C92\u6709\u76EE\u6A19\u6642\u4E0D\u6703\u89F8\u767C\u3002"
    _zhHans: "10%\u51E0\u7387\u5BF9\u65C1\u8FB9\u7684\u654C\u4EBA\u5F39\u5C04\u95EA\u7535\u3002\u6CA1\u6709\u76EE\u6807\u65F6\u4E0D\u4F1A\u89E6\u53D1\u3002"
  - _key: pskill.psv_commando_grenade.name
    _ko: "\uD30C\uD3B8\uD0C4"
    _ja: "\u7834\u7247\u5F3E"
    _en: Shrapnel
    _zhHant: "\u7834\u7247\u5F48"
    _zhHans: "\u7834\u7247\u5F39"
  - _key: pskill.psv_commando_grenade.desc
    _ko: "\uC0C1\uB300 \uBC29\uC5B4\uB825\uC744 50% \uBB34\uC2DC\uD55C\uB2E4."
    _ja: "\u76F8\u624B\u306E\u9632\u5FA1\u529B\u309250%\u7121\u8996\u3059\u308B\u3002"
    _en: Ignore 50% of enemy defense.
    _zhHant: "\u7121\u8996\u6575\u4EBA50%\u9632\u79A6\u529B\u3002"
    _zhHans: "\u65E0\u89C6\u654C\u4EBA50%\u9632\u5FA1\u529B\u3002"
  - _key: pskill.psv_snowwoman.name
    _ko: "\uC11C\uB9BF\uBC1C"
    _ja: "\u971C\u67F1"
    _en: Frost
    _zhHant: "\u971C\u67F1"
    _zhHans: "\u971C\u51BB"
  - _key: pskill.psv_snowwoman.desc
    _ko: "30% \uB85C \uC801\uC744 \uC5BC\uB9B0\uB2E4. \uC5BC\uC5B4 \uC788\uB294 \uC801\uC5D0\uAC8C\uB294
      \uB354 \uC544\uD504\uB2E4. \uBCF4\uC2A4\uB294 \uC548 \uAC78\uB9B0\uB2E4."
    _ja: "30%\u3067\u6575\u3092\u51CD\u7D50\u3002\u30DC\u30B9\u306B\u306F\u7121\u52B9\u3002\u51CD\u3063\u305F\u6575\u3078\u306E\u30C0\u30E1\u30FC\u30B8\u304C\u5897\u3048\u308B\u3002"
    _en: 30% chance to Freeze. Frozen foes take more damage. Not bosses.
    _zhHant: "30%\u6A5F\u7387\u51B0\u51CD\u6575\u4EBA\u3002\u5C0D\u51B0\u51CD\u7684\u6575\u4EBA\u50B7\u5BB3\u66F4\u9AD8\u3002\u5C0D\u982D\u76EE\u7121\u6548\u3002"
    _zhHans: "30%\u51E0\u7387\u51B0\u51BB\u654C\u4EBA\u3002\u5BF9\u51B0\u51BB\u7684\u654C\u4EBA\u4F24\u5BB3\u66F4\u9AD8\u3002\u5BF9\u5934\u76EE\u65E0\u6548\u3002"
  - _key: pskill.psv_hopper_smg.name
    _ko: "\uCDA9\uACA9 \uBC18\uB3D9"
    _ja: "\u885D\u6483\u53CD\u52D5"
    _en: Recoil Shock
    _zhHant: "\u885D\u64CA\u53CD\u9707"
    _zhHans: "\u51B2\u51FB\u53CD\u9707"
  - _key: pskill.psv_hopper_smg.desc
    _ko: "10% \uB85C \uB9DE\uC740 \uC801\uC744 \uBC00\uC5B4\uB0B8\uB2E4."
