    _zhHans: "\u8FDE\u7EED\u538B\u5236"
  - _key: card.c023.desc
    _ko: "\uAC19\uC740 \uC801\uC744 \uC5F0\uB2EC\uC544 \uCE60\uC218\uB85D \uC138\uC9C4\uB2E4."
    _ja: "\u540C\u3058\u6575\u3092\u7D9A\u3051\u3066\u653B\u6483\u3059\u308B\u307B\u3069\u5F37\u304F\u306A\u308B\u3002"
