    _zhHans: "\u7206\u70B8\u56DE\u54CD"
  - _key: card.c026.desc
    _ko: "\uB0B4 \uD0C4\uC774 \uD130\uC9C0\uBA74 \uAC19\uC740 \uC790\uB9AC\uC5D0
      \uC791\uC740 \uD3ED\uBC1C\uC774 \uD55C \uBC88 \uB354."
    _ja: "\u81EA\u5206\u306E\u5F3E\u304C\u7206\u767A\u3059\u308B\u3068\u540C\u3058\u5834\u6240\u3067\u3082\u3046\u4E00\u5EA6\u5C0F\u7206\u767A\u3002"
    _en: Your blasts echo with a second small blast.
    _zhHant: "\u5B50\u5F48\u7206\u70B8\u6642\uFF0C\u540C\u4E00\u4F4D\u7F6E\u518D\u5F15\u767C\u4E00\u6B21\u5C0F\u7206\u70B8\u3002"
    _zhHans: "\u5B50\u5F39\u7206\u70B8\u65F6\uFF0C\u540C\u4E00\u4F4D\u7F6E\u518D\u5F15\u53D1\u4E00\u6B21\u5C0F\u7206\u70B8\u3002"
