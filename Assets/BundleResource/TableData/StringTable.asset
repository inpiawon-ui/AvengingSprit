    _zhHans: "\u8BC5\u5492\u523B\u5370"
  - _key: card.c018.desc
    _ko: "\uACF5\uACA9\uC5D0 \uC800\uC8FC\uB97C \uBD99\uC778\uB2E4. \uAC78\uB9B0
      \uC801\uC740 \uB354 \uC544\uD504\uAC8C \uB9DE\uB294\uB2E4."
