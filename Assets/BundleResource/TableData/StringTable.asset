  - _key: ui.rb.growth.help
    _ko: "\uB2A5\uB825\uCE58\uB294 \uACE8\uB4DC\uB85C \xB7 \uC131\uAE09\uC740 \uC870\uAC01\uACFC
      \uACE8\uB4DC\uB85C \uC62C\uB824\uC694.\n\uC131\uAE09\uC774 \uC624\uB974\uBA74
      \uAC15\uD654 \uC0C1\uD55C \xB7 \uC2A4\uD0AC \uC704\uB825\uC774 \uD568\uAED8
      \uC62C\uB77C\uC694."
    _ja: "\u80FD\u529B\u306F\u30B4\u30FC\u30EB\u30C9\u3067\u3001\u661F\u7D1A\u306F\u304B\u3051\u3089\u3068\u30B4\u30FC\u30EB\u30C9\u3067\u4E0A\u3052\u307E\u3059\u3002\n\u661F\u7D1A\u304C\u4E0A\u304C\u308B\u3068\u5F37\u5316\u4E0A\u9650\u3068\u30B9\u30AD\u30EB\u5A01\u529B\u3082\u4E0A\u304C\u308A\u307E\u3059\u3002"
    _en: 'Stats use gold; stars use shards and gold.

      Higher stars raise the
      upgrade cap and skill power.'
    _zhHant: "\u80FD\u529B\u503C\u7528\u91D1\u5E63\u3001\u661F\u7D1A\u7528\u788E\u7247\u548C\u91D1\u5E63\u63D0\u5347\u3002\n\u661F\u7D1A\u63D0\u5347\u5F8C\uFF0C\u5F37\u5316\u4E0A\u9650\u8207\u6280\u80FD\u5A01\u529B\u4E5F\u6703\u63D0\u5347\u3002"
    _zhHans: "\u5C5E\u6027\u7528\u91D1\u5E01\u3001\u661F\u7EA7\u7528\u788E\u7247\u548C\u91D1\u5E01\u63D0\u5347\u3002\n\u661F\u7EA7\u63D0\u5347\u540E\uFF0C\u5F3A\u5316\u4E0A\u9650\u4E0E\u6280\u80FD\u5A01\u529B\u4E5F\u4F1A\u63D0\u5347\u3002"
