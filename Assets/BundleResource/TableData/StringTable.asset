    _en: 
  - _key: event.EV_CH2_03.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH2_04.title
    _ko: "\uAD50\uCC28\uC0AC\uACA9"
    _ja: 
    _en: 
  - _key: event.EV_CH2_04.body
    _ko: "\uC591\uCABD \uC625\uC0C1\uC5D0 \uCD1D\uAD6C\uAC00 \uAC78\uB824 \uC788\uB2E4.
      \uC601\uD63C\uC744 \uC870\uAE08 \uD0DC\uC6CC \uBAB8\uC744 \uB0AE\uCD94\uBA74\n\uCCAB
      \uC0AC\uACA9\uC740 \uB118\uAE38 \uC218 \uC788\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH2_04.accept
    _ko: "\uC601\uD63C\uC744 \uD0DC\uC6CC \uB6AB\uB294\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH2_04.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH2_05.title
    _ko: "\uC554\uC2DC\uC7A5 \uC5F0\uC904"
    _ja: 
    _en: 
  - _key: event.EV_CH2_05.body
    _ko: "\uB124\uC628 \uC544\uB798\uC5D0\uC11C \uB204\uAC00 \uC190\uC9D3\uD55C\uB2E4.
      \uBAB8\uC744 \uC880 \uB0B4\uC8FC\uBA74\n\uC774 \uAD6C\uC5ED \uC0C1\uC778\uB4E4\uC5D0\uAC8C
      \uB9D0\uC744 \uB123\uC5B4 \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH2_05.accept
    _ko: "\uC0B4\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH2_05.decline
    _ko: "\uBB3C\uB7EC\uC120\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH2_06.title
    _ko: "\uBD80\uC11C\uC9C4 \uC81C\uB2E8"
    _ja: 
    _en: 
  - _key: event.EV_CH2_06.body
    _ko: "\uAE08 \uAC04 \uC81C\uB2E8\uC774 \uC544\uC9C1 \uC228\uC744 \uC270\uB2E4.\n\uC0C8
      \uAC83\uC744 \uC8FC\uC9C0\uB294 \uBABB\uD558\uC9C0\uB9CC, \uC9C0\uB2CC \uAC83
      \uD558\uB098\uB294 \uBCBC\uB824 \uC900\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH2_06.accept
    _ko: "\uC81C\uB2E8\uC5D0 \uC62C\uB9B0\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH2_06.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_01.title
    _ko: "\uC601\uD63C\uC744 \uAC74 \uB0B4\uAE30"
    _ja: 
    _en: 
  - _key: event.EV_CH3_01.body
    _ko: "\uBC30\uAD00 \uC0AC\uC774\uC5D0 \uC790\uAE30\uC640 \uB611\uAC19\uC774 \uC0DD\uAE34
      \uAC83\uC774 \uC549\uC544 \uC788\uB2E4.\n\uC81C \uBAAB\uC744 \uB5BC\uC5B4 \uC8FC\uBA74
      \uAE38\uC744 \uBCF4\uC5EC \uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH3_01.accept
    _ko: "\uC601\uD63C\uC744 \uB5BC\uC5B4 \uC900\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_01.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_02.title
    _ko: "\uCE58\uBA85\uC801\uC778 \uB3C4\uC804"
    _ja: 
    _en: 
  - _key: event.EV_CH3_02.body
    _ko: "\uC694\uC0C8\uC758 \uBB38\uC9C0\uAE30 \uB458\uC774 \uAE38\uC744 \uB9C9\uACE0
      \uC11C \uC788\uB2E4.\n\uC774\uACA8\uC11C \uC5BB\uC744 \uAC83\uC774 \uD06C\uACE0,
      \uC838\uC11C \uC783\uC744 \uAC83\uB3C4 \uD06C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH3_02.accept
    _ko: "\uBC1B\uC544\uB4E4\uC778\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_02.decline
    _ko: "\uB3CC\uC544\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_03.title
    _ko: "\uBCF4\uC2A4 \uB300\uBE44"
    _ja: 
    _en: 
  - _key: event.EV_CH3_03.body
    _ko: "\uBB34\uAE30\uACE0\uC5D0 \uD30C\uC1C4\uD0C4\uC774 \uD558\uB098 \uB0A8\uC544
      \uC788\uB2E4.\n\uAC12\uC740 \uBE44\uC2F8\uC9C0\uB9CC, \uADF8 \uBC29\uC5B4\uB9C9\uC744
      \uD55C \uBC88\uC740 \uD655\uC2E4\uD788 \uBC97\uAE34\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH3_03.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_03.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_04.title
    _ko: "\uD0C0\uB77D\uD55C \uD638\uC2A4\uD2B8"
    _ja: 
    _en: 
  - _key: event.EV_CH3_04.body
    _ko: "\uBC30\uAD00 \uC548\uCABD\uC5D0\uC11C \uB0AB \uB044\uB294 \uC18C\uB9AC\uAC00
      \uB09C\uB2E4.\n\uC0B4\uC744 \uC870\uAE08 \uB0B4\uC8FC\uBA74 \uC774\uCABD\uC73C\uB85C
      \uB098\uC628\uB2E4. \uB098\uC624\uBA74, \uBE7C\uC557\uC744 \uC218 \uC788\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH3_04.accept
    _ko: "\uC0B4\uC744 \uB0B4\uC900\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_04.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_05.title
    _ko: "\uC2EC\uC5F0\uC758 \uAC70\uB798"
    _ja: 
    _en: 
  - _key: event.EV_CH3_05.body
    _ko: "\uBC14\uB2E5\uC774 \uBCF4\uC774\uC9C0 \uC54A\uB294 \uD1B5\uB85C. \uC544\uB798\uC5D0\uC11C
      \uBAA9\uC18C\uB9AC\uAC00 \uC62C\uB77C\uC628\uB2E4.\n\uAC12\uC740 \uC601\uD63C\uC73C\uB85C
      \uBC1B\uB294\uB2E4\uACE0 \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH3_05.accept
    _ko: "\uC601\uD63C\uC744 \uB0B4\uC900\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_05.decline
    _ko: "\uB300\uC2E0 \uC26C\uC5B4 \uAC04\uB2E4  (\uACE0\uC2A4\uD2B8 30% \uD68C\uBCF5)"
    _ja: 
    _en: 
  - _key: event.EV_CH3_06.title
    _ko: "\uB9C8\uC9C0\uB9C9 \uBCF4\uAE09 \uD22C\uD558"
    _ja: 
    _en: 
  - _key: event.EV_CH3_06.body
    _ko: "\uC694\uC0C8 \uC704\uB85C \uB099\uD558\uC0B0 \uD558\uB098\uAC00 \uB0B4\uB824\uC628\uB2E4.\n\uBA3C\uC800
      \uC9D1\uB294 \uCABD\uC774 \uC784\uC790\uC9C0\uB9CC, \uC548\uC5D0 \uBB34\uC5C7\uC774
      \uB4E4\uC5C8\uB294\uC9C0\uB294 \uBAA8\uB978\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH3_06.accept
    _ko: "\uC804\uBD80 \uD138\uC5B4 \uB123\uB294\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH3_06.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_01.title
    _ko: "\uD53C\uC758 \uACC4\uC57D"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_01.body
    _ko: "\uC81C\uB2E8\uC774 \uC190\uBAA9\uC744 \uC7A1\uB294\uB2E4.\n\uB124 \uADF8\uB987\uC744
      \uC601\uC601 \uC904\uC774\uB294 \uB300\uC2E0, \uC774 \uD310\uC5D0\uC11C \uAC00\uC7A5
      \uD070 \uAC83\uC744 \uC900\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_DEAL_01.accept
    _ko: "\uD53C\uB97C \uB0B4\uC900\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_01.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_02.title
    _ko: "\uAD11\uB780"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_02.body
    _ko: "\uC18D\uC0AD\uC784\uC774 \uADC0\uB97C \uCC44\uC6B4\uB2E4.\n\uBAB8\uC774
      \uC791\uC544\uC9C0\uB294 \uB9CC\uD07C \uC190\uC774 \uBE68\uB77C\uC9C4\uB2E4\uACE0
      \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_DEAL_02.accept
    _ko: "\uADC0\uB97C \uC5F0\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_02.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_04.title
    _ko: "\uC601\uD63C \uC800\uB2F9"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_04.body
    _ko: "\uC720\uB839\uC758 \uBAAB\uC744 \uB2F4\uBCF4\uB85C \uC7A1\uB294\uB2E4.\n\uC601\uD63C\uC774
      \uC587\uC544\uC9C0\uC9C0\uB9CC \uC190\uC5D0\uB294 \uB458\uC774 \uB0A8\uB294\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_DEAL_04.accept
    _ko: "\uC601\uD63C\uC744 \uB9E1\uAE34\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_04.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_06.title
    _ko: "\uAD76\uC8FC\uB9BC"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_06.body
    _ko: "\uAD76\uC8FC\uB9B0 \uAC83\uC774 \uC81C \uC774\uBE68\uC744 \uB0B4\uBBFC\uB2E4.\n\uADF8\uB987\uC744
      \uC870\uAE08 \uB0B4\uC8FC\uBA74 \uB0A8\uC758 \uD53C\uB85C \uCC44\uC6B0\uB294
      \uBC95\uC744 \uC54C\uB824 \uC900\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_DEAL_06.accept
    _ko: "\uC774\uBE68\uC744 \uBC1B\uB294\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_DEAL_06.decline
    _ko: "\uB4F1\uC744 \uB3CC\uB9B0\uB2E4"
    _ja: 
    _en: 
  - _key: stage.1.1.name
    _ko: "\uC4F0\uB808\uAE30 \uC9D1\uC801\uC7A5"
    _ja: 
    _en: 
  - _key: stage.2.1.name
    _ko: "\uBBF8\uC0AC\uC77C \uC800\uC7A5\uAE30\uC9C0"
    _ja: 
    _en: 
  - _key: stage.3.1.name
    _ko: "\uBC24\uC758 \uB3C4\uC2DC \uAC70\uB9AC"
    _ja: 
    _en: 
  - _key: stage.4.1.name
    _ko: "\uBC24\uC758 \uACF5\uC911\uAE30\uC9C0 \uC625\uC0C1"
    _ja: 
    _en: 
  - _key: stage.5.1.name
    _ko: "\uC720\uB839 \uC5F0\uAD6C\uC18C"
    _ja: 
    _en: 
  - _key: stage.6.1.name
    _ko: "\uC57C\uAC04 \uC815\uC720\uC18C"
    _ja: 
    _en: 
  - _key: host.ghost.name
    _ko: "\uC720\uB839"
    _ja: 
    _en: 
  - _key: tip.loading.0
    _ko: "\uACE0\uC2A4\uD2B8\uB294 \uB5A0 \uC788\uB294 \uB3D9\uC548 \uCCB4\uB825\uC774
      \uAE4E\uC778\uB2E4. \uBAB8\uC740 \uBE68\uB9AC \uACE0\uB97C\uC218\uB85D \uC88B\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.1
    _ko: "\uBA48\uCDB0\uC57C \uC3DC\uB2E4. \uC6C0\uC9C1\uC774\uB294 \uB3D9\uC548\uC5D0\uB294
      \uC790\uB3D9 \uACF5\uACA9\uC774 \uBA48\uCD98\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.2
    _ko: "\uBAB8\uC744 \uC2A4\uC2A4\uB85C \uB193\uC544\uC8FC\uBA74 \uADF8 \uBAB8\uC740
      \uC774 \uBC29\uC5D0\uC11C \uB2E4\uC2DC \uD0C8 \uC218 \uC5C6\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.3
    _ko: "\uBCF4\uC2A4\uB294 \uBE7C\uC557\uC744 \uC218 \uC5C6\uB2E4. \uBCF4\uC2A4\uBC29\uC740
      \uD0C0\uACE0 \uB4E4\uC5B4\uAC04 \uBAB8\uC73C\uB85C \uB05D\uB0B4\uC57C \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.4
    _ko: "\uC870\uC900 \uB9C1\uC774 \uD68C\uC0C9 \uC790\uBB3C\uC1E0\uBA74 \uC544\uC9C1
      \uC870\uAC74\uC774 \uC548 \uCC3C\uB2E4. \uB354 \uB450\uB4E4\uAE30\uBA74 \uC5F4\uB9B0\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.5
    _ko: "\uBAB8\uC744 \uC783\uC73C\uBA74 Ghost HP 20%\uAC00 \uB0A0\uC544\uAC04\uB2E4.
      \uB193\uC544\uC8FC\uB294 \uD3B8\uC774 \uC2F8\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.6
    _ko: "\uD68C\uBCF5 \uBC29\uC5D0\uC11C\uB294 Ghost HP \uAC00 \uB3CC\uC544\uC628\uB2E4.
      \uB2E4\uC74C \uBC29\uC744 \uBCF4\uACE0 \uB4E4\uC5B4\uAC00\uB77C."
    _ja: 
    _en: 
  - _key: tip.loading.7
    _ko: "\uBAB8\uC774 \uBC14\uB00C\uC5B4\uB3C4 \uBC84\uD504\uB294 \uB0A8\uB294\uB2E4.
      \uC2A4\uD0EF\uC774 \uC544\uB2C8\uB77C \uB098\uC5D0\uAC8C \uBD99\uAE30 \uB54C\uBB38\uC774\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.8
    _ko: "\uBA38\uB9AC \uC704 \uAE08\uC0C9 \uC870\uC900 \uB9C1\uC774 \uC9C0\uAE08
      \uBE59\uC758 \uBC84\uD2BC\uC774 \uB178\uB9AC\uB294 \uBAB8\uC774\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.9
    _ko: "\uBE59\uC758 \uD45C\uC2DD\uC740 \uAC00\uAE4C\uC6B4 \uC21C\uC73C\uB85C \uB2E4\uC12F\uAE4C\uC9C0\uB9CC
      \uB72C\uB2E4. \uB098\uBA38\uC9C0\uB294 \uC0AC\uAC70\uB9AC \uBC16\uC774\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.10
    _ko: "\uBD89\uC740 X \uAC00 \uBD99\uC740 \uBAB8\uC740 \uB0B4\uAC00 \uBC84\uB9B0
      \uBAB8\uC774\uB2E4. \uC774 \uBC29\uC5D0\uC11C\uB294 \uB2E4\uC2DC \uBABB \uD0C4\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.11
    _ko: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC\uC740 \uBAB8\uB9C8\uB2E4 \uB2E4\uB974\uB2E4.
      \uC5B4\uB5A4 \uBAB8\uC744 \uD0D4\uB294\uC9C0\uAC00 \uACE7 \uC5B4\uB5A4 \uC561\uD2F0\uBE0C
      \uC2A4\uD0AC\uB97C \uC4F0\uB294\uC9C0\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.12
    _ko: "\uC8FC\uC704\uC5D0 \uBE8F\uC744 \uBAB8\uC774 \uD558\uB098\uB3C4 \uC5C6\uC73C\uBA74
      \uC7A0\uC2DC \uB4A4 \uBAB8 \uD558\uB098\uAC00 \uB358\uC838\uC9C4\uB2E4. \uB300\uC2E0
      \uAC12\uC774 \uBE44\uC2F8\uB2E4."
    _ja: 
    _en: 
  - _key: tip.loading.13
    _ko: "\uD654\uBA74 \uAC00\uC7A5\uC790\uB9AC \uD654\uC0B4\uD45C\uB294 \uCC3D \uBC16\uC5D0
      \uBE8F\uC744 \uBAB8\uC774 \uC788\uB2E4\uB294 \uB73B\uC774\uB2E4."
    _ja: 
    _en: 
  - _key: opening.line.0
    _ko: "\uC5B4\uB290 \uB0A0, \uC5EC\uC790\uCE5C\uAD6C\uC640 \uD568\uAED8 \uAC77\uACE0
      \uC788\uC5C8\uB2E4."
    _ja: 
    _en: 
  - _key: opening.line.1
    _ko: "\uADF8\uB7F0\uB370 \uAC11\uC790\uAE30, \uC2B5\uACA9\uB2F9\uD588\uB2E4!"
    _ja: 
    _en: 
  - _key: opening.line.2
    _ko: "\uC73C\uC544\uC544\uC544\uC544\uC544\uC545\u2026\u2026"
    _ja: 
    _en: 
  - _key: opening.line.6
    _ko: "\uD0D5!"
    _ja: 
    _en: 
  - _key: opening.line.9
    _ko: "\uADF8\uB9AC\uACE0, \uB098\uB294 \uC8FD\uC5C8\uB2E4."
    _ja: 
    _en: 
  - _key: opening.line.10
    _ko: "\uB0B4\uAC00 \uC790\uB124\uB97C \uBD88\uB800\uB124."
    _ja: 
