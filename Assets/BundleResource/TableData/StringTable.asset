    _ko: "\uB4B7\uACE8\uBAA9\uC744 \uC8FC\uB984\uC7A1\uB358 \uB450\uBAA9.\n\uAD8C\uCD1D
      \uD55C \uC790\uB8E8\uB85C \uAE38\uC744 \uC5F0\uB2E4."
    _ja: "\u88CF\u8DEF\u5730\u3092\u4ED5\u5207\u3063\u3066\u3044\u305F\u30DC\u30B9\u3002\n\u62F3\u9283\u4E00\u4E01\u3067\u9053\u3092\u5207\u308A\u958B\u304F\u3002"
    _en: 'A back-alley boss who clears

      the way with a single pistol.'
    _zhHant: "\u7A31\u9738\u5F8C\u5DF7\u7684\u8001\u5927\u3002\n\u4E00\u628A\u624B\u69CD\u6BBA\u51FA\u4E00\u689D\u8DEF\u3002"
    _zhHans: "\u79F0\u9738\u540E\u5DF7\u7684\u8001\u5927\u3002\n\u4E00\u628A\u624B\u67AA\u6740\u51FA\u4E00\u6761\u8DEF\u3002"
  - _key: host.thug.desc
    _ko: "\uAC70\uB9AC\uC758 \uC2F8\uC6C0\uAFBC.\n\uC8FC\uBA39\uC774 \uBA3C\uC800
      \uB098\uAC04\uB2E4."
    _ja: "\u8857\u306E\u30B1\u30F3\u30AB\u5C4B\u3002\n\u62F3\u304C\u5148\u306B\u51FA\u308B\u3002"
    _en: 'A street brawler whose

      fists always go first.'
    _zhHant: "\u8857\u982D\u6253\u67B6\u738B\u3002\n\u62F3\u982D\u7E3D\u662F\u5148\u51FA\u624B\u3002"
    _zhHans: "\u8857\u5934\u6253\u67B6\u738B\u3002\n\u62F3\u5934\u603B\u662F\u5148\u51FA\u624B\u3002"
  - _key: host.amazon.desc
    _ko: "\uC815\uAE00\uC758 \uC804\uC0AC.\n\uB0A0\uB79C \uBAB8\uB180\uB9BC\uC73C\uB85C
      \uC801\uC744 \uBCA4\uB2E4."
    _ja: "\u30B8\u30E3\u30F3\u30B0\u30EB\u306E\u6226\u58EB\u3002\n\u7D20\u65E9\u3044\u8EAB\u306E\u3053\u306A\u3057\u3067\u6575\u3092\u65AC\u308B\u3002"
    _en: 'A jungle warrior who cuts foes

      down with nimble moves.'
    _zhHant: "\u53E2\u6797\u7684\u6230\u58EB\u3002\n\u4EE5\u654F\u6377\u8EAB\u624B\u65AC\u6BBA\u6575\u4EBA\u3002"
    _zhHans: "\u4E1B\u6797\u7684\u6218\u58EB\u3002\n\u4EE5\u654F\u6377\u8EAB\u624B\u65A9\u6740\u654C\u4EBA\u3002"
  - _key: host.amazon_elite.desc
    _ko: "\uC544\uB9C8\uC874 \uC804\uC0AC\uB2E8\uC758 \uC815\uC608.\n\uBC18\uACA9\uC73C\uB85C
      \uD750\uB984\uC744 \uB4A4\uC9D1\uB294\uB2E4."
    _ja: "\u30A2\u30DE\u30BE\u30CD\u30B9\u6226\u58EB\u56E3\u306E\u7CBE\u92ED\u3002\n\u53CD\u6483\u3067\u6D41\u308C\u3092\u3072\u3063\u304F\u308A\u8FD4\u3059\u3002"
    _en: 'Elite of the Amazon warband who

      turns the tide with counters.'
    _zhHant: "\u4E9E\u99AC\u905C\u6230\u58EB\u5718\u7684\u7CBE\u82F1\u3002\n\u4EE5\u53CD\u64CA\u626D\u8F49\u5C40\u52E2\u3002"
    _zhHans: "\u4E9A\u9A6C\u900A\u6218\u58EB\u56E2\u7684\u7CBE\u82F1\u3002\n\u4EE5\u53CD\u51FB\u626D\u8F6C\u5C40\u52BF\u3002"
  - _key: host.hopper.desc
    _ko: "\uB6F0\uC5B4\uC624\uB974\uBA70 \uC2F8\uC6B0\uB294 \uBB34\uBC95\uC790.\n\uBA48\uCD94\uC9C0
      \uC54A\uB294 \uAE30\uC138\uAC00 \uBB34\uAE30\uB2E4."
    _ja: "\u8DF3\u306D\u56DE\u3063\u3066\u6226\u3046\u7121\u6CD5\u8005\u3002\n\u6B62\u307E\u3089\u306A\u3044\u52E2\u3044\u304C\u6B66\u5668\u3060\u3002"
    _en: 'An outlaw who fights on the hop.

      Momentum is the weapon.'
    _zhHant: "\u908A\u8DF3\u908A\u6230\u7684\u4EA1\u547D\u4E4B\u5F92\u3002\n\u505C\u4E0D\u4E0B\u4F86\u7684\u6C23\u52E2\u5C31\u662F\u6B66\u5668\u3002"
    _zhHans: "\u8FB9\u8DF3\u8FB9\u6218\u7684\u4EA1\u547D\u4E4B\u5F92\u3002\n\u505C\u4E0D\u4E0B\u6765\u7684\u6C14\u52BF\u5C31\u662F\u6B66\u5668\u3002"
  - _key: host.hopper_smg.desc
    _ko: "\uAE30\uAD00\uB2E8\uCD1D\uC744 \uB4E0 \uD638\uD37C.\n\uC274 \uC0C8 \uC5C6\uC774
      \uD0C4\uC744 \uD37C\uBD93\uB294\uB2E4."
    _ja: "\u30B5\u30D6\u30DE\u30B7\u30F3\u30AC\u30F3\u3092\u6301\u3064\u30DB\u30C3\u30D1\u30FC\u3002\n\u7D76\u3048\u9593\u306A\u304F\u5F3E\u3092\u6D74\u3073\u305B\u308B\u3002"
    _en: 'A hopper with an SMG who never

      stops pouring out bullets.'
    _zhHant: "\u624B\u6301\u885D\u92D2\u69CD\u7684\u8DF3\u8E8D\u8005\u3002\n\u6BEB\u4E0D\u505C\u6B47\u5730\u50BE\u7009\u5B50\u5F48\u3002"
    _zhHans: "\u624B\u6301\u51B2\u950B\u67AA\u7684\u8DF3\u8DC3\u8005\u3002\n\u6BEB\u4E0D\u505C\u6B47\u5730\u503E\u6CFB\u5B50\u5F39\u3002"
  - _key: host.commando_mg.desc
    _ko: "\uC5B4\uB5A4 \uC804\uC7A5\uC5D0\uC11C\uB3C4 \uC784\uBB34\uB97C \uC644\uC218\uD558\uB294\n\uD2B9\uC218\uBD80\uB300\uC6D0\uC785\uB2C8\uB2E4."
    _ja: "\u3069\u3093\u306A\u6226\u5834\u3067\u3082\u4EFB\u52D9\u3092\u5B8C\u9042\u3059\u308B\n\u7279\u6B8A\u90E8\u968A\u54E1\u3067\u3059\u3002"
    _en: 'A special forces soldier who completes

      the mission on any battlefield.'
    _zhHant: "\u7121\u8AD6\u5728\u4F55\u7A2E\u6230\u5834\u90FD\u80FD\u5B8C\u6210\u4EFB\u52D9\u7684\n\u7279\u7A2E\u90E8\u968A\u58EB\u5175\u3002"
    _zhHans: "\u65E0\u8BBA\u5728\u4F55\u79CD\u6218\u573A\u90FD\u80FD\u5B8C\u6210\u4EFB\u52A1\u7684\n\u7279\u79CD\u90E8\u961F\u58EB\u5175\u3002"
  - _key: host.commando_laser.desc
    _ko: "\uB808\uC774\uC800 \uC18C\uCD1D\uC744 \uC4F0\uB294 \uCF54\uB9CC\uB3C4.\n\uBA40\uB9AC\uC11C
      \uD55C \uC904\uB85C \uAFF0\uB6AB\uB294\uB2E4."
    _ja: "\u30EC\u30FC\u30B6\u30FC\u30E9\u30A4\u30D5\u30EB\u306E\u30B3\u30DE\u30F3\u30C9\u30FC\u3002\n\u9060\u304F\u304B\u3089\u4E00\u76F4\u7DDA\u306B\u8CAB\u304F\u3002"
    _en: 'A commando with a laser rifle who

      pierces enemies from afar.'
    _zhHant: "\u4F7F\u7528\u96F7\u5C04\u6B65\u69CD\u7684\u7A81\u64CA\u5175\u3002\n\u5F9E\u9060\u8655\u4E00\u7DDA\u8CAB\u7A7F\u6575\u4EBA\u3002"
    _zhHans: "\u4F7F\u7528\u6FC0\u5149\u6B65\u67AA\u7684\u7A81\u51FB\u5175\u3002\n\u4ECE\u8FDC\u5904\u4E00\u7EBF\u8D2F\u7A7F\u654C\u4EBA\u3002"
  - _key: host.commando_grenade.desc
    _ko: "\uC218\uB958\uD0C4\uC744 \uB2E4\uB8E8\uB294 \uCF54\uB9CC\uB3C4.\n\uBB49\uCE5C
      \uC801\uC744 \uD55C\uAEBC\uBC88\uC5D0 \uB0A0\uB9B0\uB2E4."
    _ja: "\u624B\u69B4\u5F3E\u3092\u6271\u3046\u30B3\u30DE\u30F3\u30C9\u30FC\u3002\n\u56FA\u307E\u3063\u305F\u6575\u3092\u307E\u3068\u3081\u3066\u5439\u304D\u98DB\u3070\u3059\u3002"
    _en: 'A grenadier commando who blasts

      clustered enemies at once.'
    _zhHant: "\u64C5\u7528\u624B\u69B4\u5F48\u7684\u7A81\u64CA\u5175\u3002\n\u628A\u805A\u96C6\u7684\u6575\u4EBA\u4E00\u53E3\u6C23\u70B8\u98DB\u3002"
    _zhHans: "\u64C5\u7528\u624B\u69B4\u5F39\u7684\u7A81\u51FB\u5175\u3002\n\u628A\u805A\u96C6\u7684\u654C\u4EBA\u4E00\u53E3\u6C14\u70B8\u98DE\u3002"
  - _key: host.salamander.desc
    _ko: "\uBD88\uC744 \uBFDC\uB294 \uB3C4\uB9C8\uBC40 \uC778\uAC04.\n\uAC00\uAE4C\uC774
      \uC624\uB294 \uC801\uC744 \uD0DC\uC6B4\uB2E4."
    _ja: "\u706B\u3092\u5410\u304F\u30C8\u30AB\u30B2\u4EBA\u9593\u3002\n\u8FD1\u3065\u304F\u6575\u3092\u713C\u304D\u5C3D\u304F\u3059\u3002"
    _en: 'A fire-breathing lizardman who

      burns anyone who comes close.'
    _zhHant: "\u6703\u5674\u706B\u7684\u8725\u8734\u4EBA\u3002\n\u71D2\u76E1\u9760\u8FD1\u7684\u6575\u4EBA\u3002"
    _zhHans: "\u4F1A\u55B7\u706B\u7684\u8725\u8734\u4EBA\u3002\n\u70E7\u5C3D\u9760\u8FD1\u7684\u654C\u4EBA\u3002"
  - _key: host.dragoon.desc
    _ko: "\uCC3D\uC744 \uB4E0 \uC6A9\uAE30\uBCD1.\n\uBB35\uC9C1\uD55C \uD55C \uBC29\uC73C\uB85C
      \uB6AB\uACE0 \uB098\uAC04\uB2E4."
    _ja: "\u69CD\u3092\u69CB\u3048\u305F\u7ADC\u9A0E\u5175\u3002\n\u91CD\u3044\u4E00\u6483\u3067\u7A81\u304D\u9032\u3080\u3002"
    _en: 'A lance-wielding dragoon who

      breaks through with heavy blows.'
    _zhHant: "\u624B\u6301\u9577\u69CD\u7684\u9F8D\u9A0E\u5175\u3002\n\u4EE5\u6C89\u91CD\u4E00\u64CA\u7A81\u7834\u91CD\u570D\u3002"
    _zhHans: "\u624B\u6301\u957F\u67AA\u7684\u9F99\u9A91\u5175\u3002\n\u4EE5\u6C89\u91CD\u4E00\u51FB\u7A81\u7834\u91CD\u56F4\u3002"
  - _key: host.dragon_blue.desc
    _ko: "\uD478\uB978 \uBE44\uB298\uC758 \uC6A9.\n\uBE60\uB978 \uC228\uACB0\uB85C
      \uC801\uC744 \uBAB0\uC544\uCE5C\uB2E4."
    _ja: "\u9752\u3044\u9C57\u306E\u30C9\u30E9\u30B4\u30F3\u3002\n\u7D20\u65E9\u3044\u30D6\u30EC\u30B9\u3067\u6575\u3092\u8FFD\u3044\u7ACB\u3066\u308B\u3002"
    _en: 'A blue-scaled dragon that drives

      foes back with swift breath.'
    _zhHant: "\u9752\u8272\u9C57\u7247\u7684\u9F8D\u3002\n\u4EE5\u8FC5\u6377\u5410\u606F\u9A45\u8D95\u6575\u4EBA\u3002"
    _zhHans: "\u9752\u8272\u9CDE\u7247\u7684\u9F99\u3002\n\u4EE5\u8FC5\u6377\u5410\u606F\u9A71\u8D76\u654C\u4EBA\u3002"
  - _key: host.guru.desc
    _ko: "\uD5C8\uACF5\uC5D0 \uB5A0 \uC788\uB294 \uC218\uD589\uC790.\n\uBC84\uD2F0\uACE0
      \uB610 \uBC84\uD2F4\uB2E4."
    _ja: "\u5B99\u306B\u6D6E\u304B\u3076\u4FEE\u884C\u8005\u3002\n\u8010\u3048\u3066\u3001\u307E\u305F\u8010\u3048\u308B\u3002"
    _en: 'A levitating ascetic who endures

      and endures again.'
    _zhHant: "\u61F8\u6D6E\u65BC\u7A7A\u4E2D\u7684\u4FEE\u884C\u8005\u3002\n\u5FCD\u8010\uFF0C\u518D\u5FCD\u8010\u3002"
    _zhHans: "\u60AC\u6D6E\u4E8E\u7A7A\u4E2D\u7684\u4FEE\u884C\u8005\u3002\n\u5FCD\u8010\uFF0C\u518D\u5FCD\u8010\u3002"
  - _key: host.white_wizard.desc
    _ko: "\uD770 \uC637\uC758 \uB9C8\uBC95\uC0AC.\n\uBA40\uB9AC\uC11C \uB9C8\uB825\uC744
      \uC3D8\uC544 \uBCF4\uB0B8\uB2E4."
    _ja: "\u767D\u8863\u306E\u9B54\u6CD5\u4F7F\u3044\u3002\n\u9060\u304F\u304B\u3089\u9B54\u529B\u3092\u6483\u3061\u51FA\u3059\u3002"
    _en: 'A wizard in white who hurls

      magic from a distance.'
    _zhHant: "\u767D\u8863\u9B54\u6CD5\u5E2B\u3002\n\u5F9E\u9060\u8655\u5C04\u51FA\u9B54\u529B\u3002"
    _zhHans: "\u767D\u8863\u9B54\u6CD5\u5E08\u3002\n\u4ECE\u8FDC\u5904\u5C04\u51FA\u9B54\u529B\u3002"
  - _key: host.medium.desc
    _ko: "\uC601\uD63C\uC744 \uBD80\uB974\uB294 \uBB34\uB140.\n\uBCF4\uC774\uC9C0
      \uC54A\uB294 \uD798\uC73C\uB85C \uC2F8\uC6B4\uB2E4."
    _ja: "\u970A\u3092\u547C\u3076\u5DEB\u5973\u3002\n\u898B\u3048\u306A\u3044\u529B\u3067\u6226\u3046\u3002"
    _en: 'A medium who calls on spirits

      and fights with unseen power.'
    _zhHant: "\u53EC\u559A\u9748\u9B42\u7684\u5DEB\u5973\u3002\n\u4EE5\u770B\u4E0D\u898B\u7684\u529B\u91CF\u6230\u9B25\u3002"
    _zhHans: "\u53EC\u5524\u7075\u9B42\u7684\u5DEB\u5973\u3002\n\u4EE5\u770B\u4E0D\u89C1\u7684\u529B\u91CF\u6218\u6597\u3002"
  - _key: host.ninja.desc
    _ko: "\uADF8\uB9BC\uC790 \uC18D\uC758 \uB2CC\uC790.\n\uBE60\uB978 \uC190\uC73C\uB85C
      \uAE09\uC18C\uB97C \uB178\uB9B0\uB2E4."
    _ja: "\u5F71\u306B\u3072\u305D\u3080\u5FCD\u8005\u3002\n\u7D20\u65E9\u3044\u624B\u3067\u6025\u6240\u3092\u72D9\u3046\u3002"
    _en: 'A ninja in the shadows who strikes

      vital points with quick hands.'
    _zhHant: "\u6F5B\u4F0F\u65BC\u6697\u5F71\u4E2D\u7684\u5FCD\u8005\u3002\n\u4EE5\u8FC5\u6377\u4E4B\u624B\u76F4\u53D6\u8981\u5BB3\u3002"
    _zhHans: "\u6F5C\u4F0F\u4E8E\u6697\u5F71\u4E2D\u7684\u5FCD\u8005\u3002\n\u4EE5\u8FC5\u6377\u4E4B\u624B\u76F4\u53D6\u8981\u5BB3\u3002"
  - _key: host.ninja_chain.desc
    _ko: "\uC0AC\uC2AC\uB0AB\uC744 \uC4F0\uB294 \uB2CC\uC790.\n\uBA3C \uAC70\uB9AC\uC5D0\uC11C
      \uC801\uC744 \uB09A\uC544\uCC48\uB2E4."
    _ja: "\u9396\u938C\u3092\u4F7F\u3046\u5FCD\u8005\u3002\n\u96E2\u308C\u305F\u6575\u3092\u7D61\u3081\u53D6\u308B\u3002"
    _en: 'A chain-sickle ninja who snares

      enemies from far away.'
    _zhHant: "\u4F7F\u7528\u9396\u93C8\u942E\u7684\u5FCD\u8005\u3002\n\u5F9E\u9060\u8655\u64D2\u4F4F\u6575\u4EBA\u3002"
    _zhHans: "\u4F7F\u7528\u9501\u94FE\u9570\u7684\u5FCD\u8005\u3002\n\u4ECE\u8FDC\u5904\u64D2\u4F4F\u654C\u4EBA\u3002"
  - _key: host.robot.desc
    _ko: "\uACE0\uCCA0\uB85C \uB9CC\uB4E0 \uC804\uD22C \uB85C\uBD07.\n\uC608\uBE44
      \uD68C\uB85C\uB85C \uBA87 \uBC88\uC774\uACE0 \uC77C\uC5B4\uB09C\uB2E4."
    _ja: "\u9244\u304F\u305A\u3067\u4F5C\u3089\u308C\u305F\u6226\u95D8\u30ED\u30DC\u30C3\u30C8\u3002\n\u4E88\u5099\u56DE\u8DEF\u3067\u4F55\u5EA6\u3067\u3082\u7ACB\u3061\u4E0A\u304C\u308B\u3002"
    _en: 'A scrap-built battle robot that gets

      back up on spare circuits.'
    _zhHant: "\u7528\u5EE2\u9435\u6253\u9020\u7684\u6230\u9B25\u6A5F\u5668\u4EBA\u3002\n\u9760\u5099\u7528\u8FF4\u8DEF\u4E00\u6B21\u6B21\u91CD\u65B0\u7AD9\u8D77\u3002"
    _zhHans: "\u7528\u5E9F\u94C1\u6253\u9020\u7684\u6218\u6597\u673A\u5668\u4EBA\u3002\n\u9760\u5907\u7528\u56DE\u8DEF\u4E00\u6B21\u6B21\u91CD\u65B0\u7AD9\u8D77\u3002"
  - _key: host.baseball.desc
    _ko: "\uBC29\uB9DD\uC774\uB97C \uB4E0 \uAC15\uD0C0\uC790.\n\uD55C \uBC88 \uD718\uB450\uB974\uBA74
      \uB2F4\uC7A5\uC744 \uB118\uAE34\uB2E4."
    _ja: "\u30D0\u30C3\u30C8\u3092\u63E1\u308B\u5F37\u6253\u8005\u3002\n\u3072\u3068\u632F\u308A\u3067\u30D5\u30A7\u30F3\u30B9\u3092\u8D8A\u3048\u308B\u3002"
    _en: 'A power hitter whose single swing

      sends foes over the fence.'
    _zhHant: "\u624B\u63E1\u7403\u68D2\u7684\u5F37\u6253\u8005\u3002\n\u4E00\u63EE\u5C31\u6253\u51FA\u5168\u58D8\u6253\u3002"
    _zhHans: "\u624B\u63E1\u7403\u68D2\u7684\u5F3A\u6253\u8005\u3002\n\u4E00\u6325\u5C31\u6253\u51FA\u672C\u5792\u6253\u3002"
  - _key: host.snowwoman.desc
    _ko: "\uB208\uC744 \uBD80\uB974\uB294 \uC124\uB140.\n\uCC28\uAC00\uC6B4 \uC190\uAE38\uB85C
      \uC801\uC744 \uC5BC\uB9B0\uB2E4."
    _ja: "\u96EA\u3092\u547C\u3076\u96EA\u5973\u3002\n\u51B7\u305F\u3044\u624B\u3067\u6575\u3092\u51CD\u3089\u305B\u308B\u3002"
    _en: 'A snow woman whose icy touch

      freezes her foes.'
    _zhHant: "\u53EC\u559A\u98A8\u96EA\u7684\u96EA\u5973\u3002\n\u4EE5\u51B0\u51B7\u4E4B\u624B\u51CD\u7D50\u6575\u4EBA\u3002"
    _zhHans: "\u53EC\u5524\u98CE\u96EA\u7684\u96EA\u5973\u3002\n\u4EE5\u51B0\u51B7\u4E4B\u624B\u51BB\u7ED3\u654C\u4EBA\u3002"
  - _key: host.vampire.desc
    _ko: "\uBC24\uC758 \uADC0\uC871 \uD761\uD608\uADC0.\n\uC801\uC758 \uD53C\uB85C
      \uC0C1\uCC98\uB97C \uBA54\uC6B4\uB2E4."
    _ja: "\u591C\u306E\u8CB4\u65CF\u3001\u5438\u8840\u9B3C\u3002\n\u6575\u306E\u8840\u3067\u50B7\u3092\u3075\u3055\u3050\u3002"
    _en: 'A vampire noble of the night who

      heals on the blood of foes.'
    _zhHant: "\u6697\u591C\u8CB4\u65CF\u5438\u8840\u9B3C\u3002\n\u4EE5\u6575\u4EBA\u4E4B\u8840\u7652\u5408\u50B7\u53E3\u3002"
    _zhHans: "\u6697\u591C\u8D35\u65CF\u5438\u8840\u9B3C\u3002\n\u4EE5\u654C\u4EBA\u4E4B\u8840\u6108\u5408\u4F24\u53E3\u3002"
  - _key: host.commando_missile.desc
    _ko: "\uBBF8\uC0AC\uC77C\uC744 \uC3D8\uB294 \uCF54\uB9CC\uB3C4.\n\uBA40\uB9AC
      \uC788\uB294 \uC801\uAE4C\uC9C0 \uD3ED\uACA9\uD55C\uB2E4."
    _ja: "\u30DF\u30B5\u30A4\u30EB\u3092\u6483\u3064\u30B3\u30DE\u30F3\u30C9\u30FC\u3002\n\u9060\u304F\u306E\u6575\u307E\u3067\u7206\u6483\u3059\u308B\u3002"
    _en: 'A missile commando who bombards

      even distant enemies.'
    _zhHant: "\u767C\u5C04\u98DB\u5F48\u7684\u7A81\u64CA\u5175\u3002\n\u9023\u9060\u8655\u7684\u6575\u4EBA\u4E5F\u80FD\u8F5F\u70B8\u3002"
    _zhHans: "\u53D1\u5C04\u5BFC\u5F39\u7684\u7A81\u51FB\u5175\u3002\n\u8FDE\u8FDC\u5904\u7684\u654C\u4EBA\u4E5F\u80FD\u8F70\u70B8\u3002"
  - _key: host.death.desc
    _ko: "\uB0AB\uC744 \uB4E0 \uC8FD\uC74C \uADF8 \uC790\uCCB4.\n\uB2FF\uB294 \uBAA8\uB4E0
      \uAC83\uC744 \uAC70\uB454\uB2E4."
    _ja: "\u938C\u3092\u6301\u3064\u6B7B\u305D\u306E\u3082\u306E\u3002\n\u89E6\u308C\u308B\u3082\u306E\u3059\u3079\u3066\u3092\u5208\u308A\u53D6\u308B\u3002"
    _en: 'Death itself, scythe in hand,

      reaping all it touches.'
    _zhHant: "\u624B\u6301\u942E\u5200\u7684\u6B7B\u4EA1\u672C\u8EAB\u3002\n\u6536\u5272\u89F8\u53CA\u7684\u4E00\u5207\u3002"
    _zhHans: "\u624B\u6301\u9570\u5200\u7684\u6B7B\u4EA1\u672C\u8EAB\u3002\n\u6536\u5272\u89E6\u53CA\u7684\u4E00\u5207\u3002"
  - _key: ui.ingame.no_host_to_possess
    _ko: "\uBE59\uC758\uD560 \uD638\uC2A4\uD2B8\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4"
    _ja: "\u6191\u4F9D\u3067\u304D\u308B\u30DB\u30B9\u30C8\u304C\u3044\u307E\u305B\u3093"
    _en: No host to possess
    _zhHant: "\u6C92\u6709\u53EF\u9644\u8EAB\u7684\u5BBF\u4E3B"
    _zhHans: "\u6CA1\u6709\u53EF\u9644\u8EAB\u7684\u5BBF\u4E3B"
  - _key: stage.7.1.name
    _ko: "\uBD88\uD0C0\uB294 \uC9D1\uC801\uC7A5"
    _ja: "\u71C3\u3048\u308B\u96C6\u7A4D\u5834"
    _en: Burning Junkyard
    _zhHant: "\u71C3\u71D2\u7684\u96C6\u6563\u5834"
    _zhHans: "\u71C3\u70E7\u7684\u96C6\u6563\u573A"
  - _key: stage.8.1.name
    _ko: "\uBD09\uC1C4\uB41C \uC800\uC7A5\uAE30\uC9C0"
    _ja: "\u5C01\u9396\u3055\u308C\u305F\u8CAF\u8535\u57FA\u5730"
    _en: Sealed Depot
    _zhHant: "\u5C01\u9396\u7684\u5132\u85CF\u57FA\u5730"
    _zhHans: "\u5C01\u9501\u7684\u50A8\u85CF\u57FA\u5730"
  - _key: stage.9.1.name
    _ko: "\uB9DD\uB839\uC758 \uAC70\uB9AC"
    _ja: "\u4EA1\u970A\u306E\u8857"
    _en: Street of Wraiths
    _zhHant: "\u4EA1\u9748\u4E4B\u8857"
    _zhHans: "\u4EA1\u7075\u4E4B\u8857"
  - _key: stage.10.1.name
    _ko: "\uCD5C\uD6C4\uC758 \uC625\uC0C1"
    _ja: "\u6700\u5F8C\u306E\u5C4B\u4E0A"
    _en: The Last Rooftop
    _zhHant: "\u6700\u5F8C\u7684\u9802\u6A13"
    _zhHans: "\u6700\u540E\u7684\u5929\u53F0"
  - _key: chapter.1.desc
    _ko: "\uB3C4\uC2DC\uAC00 \uBC84\uB9B0 \uAC83\uB4E4\uC774 \uC313\uC774\uB294 \uACF3\n\uBB34\uC5B8\uAC00\uAC00
      \uADF8 \uC544\uB798\uC5D0\uC11C \uAE68\uC5B4\uB0AC\uB2E4."
    _ja: "\u8857\u304C\u6368\u3066\u305F\u3082\u306E\u304C\u7A4D\u3082\u308B\u5834\u6240\n\u305D\u306E\u4E0B\u3067\u4F55\u304B\u304C\u76EE\u3092\u899A\u307E\u3057\u305F\u3002"
    _en: 'Where the city''s castoffs pile up.

      Something has awoken beneath.'
    _zhHant: "\u57CE\u5E02\u62CB\u68C4\u4E4B\u7269\u5806\u7A4D\u4E4B\u8655\n\u6709\u4EC0\u9EBC\u5728\u5176\u4E0B\u7526\u9192\u4E86\u3002"
    _zhHans: "\u57CE\u5E02\u629B\u5F03\u4E4B\u7269\u5806\u79EF\u4E4B\u5904\n\u6709\u4EC0\u4E48\u5728\u5176\u4E0B\u82CF\u9192\u4E86\u3002"
  - _key: chapter.2.desc
    _ko: "\uB3C4\uC2DC \uC678\uACFD\uC5D0 \uC704\uCE58\uD55C \uC218\uC218\uAED8\uB07C\uC758
      \uAD70\uC0AC \uC2DC\uC124\n\uB354 \uAE4A\uC740 \uACF3\uC5D0\uC11C \uB204\uAD70\uAC00\uAC00
      \uC6C0\uC9C1\uC774\uACE0 \uC788\uB2E4."
    _ja: "\u8857\u5916\u308C\u306B\u3042\u308B\u8B0E\u306E\u8ECD\u4E8B\u65BD\u8A2D\n\u3055\u3089\u306B\u5965\u3067\u8AB0\u304B\u304C\u52D5\u3044\u3066\u3044\u308B\u3002"
    _en: 'A mysterious military site on the city''s edge.

      Someone is moving
      deeper within.'
    _zhHant: "\u4F4D\u65BC\u57CE\u5E02\u90CA\u5916\u7684\u795E\u79D8\u8ECD\u4E8B\u8A2D\u65BD\n\u66F4\u6DF1\u8655\u6709\u4EBA\u5728\u884C\u52D5\u3002"
    _zhHans: "\u4F4D\u4E8E\u57CE\u5E02\u90CA\u5916\u7684\u795E\u79D8\u519B\u4E8B\u8BBE\u65BD\n\u66F4\u6DF1\u5904\u6709\u4EBA\u5728\u884C\u52A8\u3002"
  - _key: chapter.3.desc
    _ko: "\uB124\uC628\uC774 \uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uBC24\uC758 \uAC70\uB9AC\n\uACE8\uBAA9\uB9C8\uB2E4
      \uB2E4\uB978 \uC5BC\uAD74\uC774 \uAE30\uB2E4\uB9B0\uB2E4."
    _ja: "\u30CD\u30AA\u30F3\u304C\u6D88\u3048\u306A\u3044\u591C\u306E\u8857\n\u8DEF\u5730\u3054\u3068\u306B\u9055\u3046\u9854\u304C\u5F85\u3063\u3066\u3044\u308B\u3002"
    _en: 'Night streets where the neon never dies.

      A different face waits
      in every alley.'
    _zhHant: "\u9713\u8679\u6C38\u4E0D\u7184\u6EC5\u7684\u591C\u8857\n\u6BCF\u689D\u5DF7\u5B50\u90FD\u6709\u4E0D\u540C\u7684\u9762\u5B54\u5728\u7B49\u5F85\u3002"
    _zhHans: "\u9713\u8679\u6C38\u4E0D\u7184\u706D\u7684\u591C\u8857\n\u6BCF\u6761\u5DF7\u5B50\u90FD\u6709\u4E0D\u540C\u7684\u9762\u5B54\u5728\u7B49\u5F85\u3002"
  - _key: chapter.4.desc
    _ko: "\uBE57\uBB3C\uC774 \uACE0\uC778 \uACF5\uC911\uAE30\uC9C0 \uC625\uC0C1\n\uBC1C\uBC11\uC774
      \uBB34\uB108\uC9C0\uB294 \uC18C\uB9AC\uAC00 \uB09C\uB2E4."
    _ja: "\u96E8\u6C34\u304C\u6E9C\u307E\u3063\u305F\u7A7A\u4E2D\u57FA\u5730\u306E\u5C4B\u4E0A\n\u8DB3\u5143\u304C\u5D29\u308C\u308B\u97F3\u304C\u3059\u308B\u3002"
    _en: 'A rain-soaked sky base rooftop.

      The ground cracks beneath your feet.'
    _zhHant: "\u7A4D\u6EFF\u96E8\u6C34\u7684\u7A7A\u4E2D\u57FA\u5730\u9802\u6A13\n\u8173\u4E0B\u50B3\u4F86\u5D29\u584C\u7684\u8072\u97F3\u3002"
    _zhHans: "\u79EF\u6EE1\u96E8\u6C34\u7684\u7A7A\u4E2D\u57FA\u5730\u5929\u53F0\n\u811A\u4E0B\u4F20\u6765\u5D29\u584C\u7684\u58F0\u97F3\u3002"
  - _key: chapter.5.desc
    _ko: "\uC7A0\uAE30\uC9C0 \uC54A\uC740 \uC5F0\uAD6C\uC18C\uC758 \uBB38\n\uC2E4\uD328\uD55C
      \uAC83\uB4E4\uC774 \uC544\uC9C1 \uC228\uC744 \uC270\uB2E4."
    _ja: "\u9375\u306E\u304B\u304B\u3063\u3066\u3044\u306A\u3044\u7814\u7A76\u6240\u306E\u6249\n\u5931\u6557\u4F5C\u304C\u307E\u3060\u606F\u3092\u3057\u3066\u3044\u308B\u3002"
    _en: 'A lab door left unlocked.

      The failures are still breathing.'
    _zhHant: "\u6C92\u6709\u4E0A\u9396\u7684\u7814\u7A76\u6240\u5927\u9580\n\u5931\u6557\u54C1\u4ECD\u5728\u547C\u5438\u3002"
    _zhHans: "\u6CA1\u6709\u4E0A\u9501\u7684\u7814\u7A76\u6240\u5927\u95E8\n\u5931\u8D25\u54C1\u4ECD\u5728\u547C\u5438\u3002"
  - _key: chapter.6.desc
    _ko: "\uBD88\uAE38\uC774 \uBA48\uCD94\uC9C0 \uC54A\uB294 \uC815\uC720\uC18C\n\uBAA8\uB4E0
      \uAC83\uC758 \uC8FC\uC778\uC774 \uC5EC\uAE30 \uC788\uB2E4."
    _ja: "\u708E\u304C\u6B62\u307E\u3089\u306A\u3044\u88FD\u6CB9\u6240\n\u3059\u3079\u3066\u306E\u4E3B\u304C\u3053\u3053\u306B\u3044\u308B\u3002"
    _en: 'A refinery that never stops burning.

      The master of it all waits
      here.'
    _zhHant: "\u70C8\u706B\u4E0D\u6B62\u7684\u7149\u6CB9\u5EE0\n\u4E00\u5207\u7684\u4E3B\u5BB0\u5C31\u5728\u9019\u88E1\u3002"
    _zhHans: "\u70C8\u706B\u4E0D\u6B62\u7684\u70BC\u6CB9\u5382\n\u4E00\u5207\u7684\u4E3B\u5BB0\u5C31\u5728\u8FD9\u91CC\u3002"
  - _key: chapter.7.desc
    _ko: "\uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uBD88\uC774 \uACE0\uCCA0\uC744 \uB179\uC778\uB2E4\n\uAE38\uC740
      \uD130\uB728\uB824\uC11C \uC5EC\uB294 \uC218\uBC16\uC5D0 \uC5C6\uB2E4."
    _ja: "\u6D88\u3048\u306A\u3044\u708E\u304C\u9244\u304F\u305A\u3092\u6EB6\u304B\u3059\n\u9053\u306F\u7206\u7834\u3057\u3066\u958B\u304F\u3057\u304B\u306A\u3044\u3002"
    _en: 'Undying flames melt the scrap.

      The only way forward is to blast
      it open.'
    _zhHant: "\u4E0D\u6EC5\u4E4B\u706B\u7194\u5316\u4E86\u5EE2\u9435\n\u53EA\u80FD\u70B8\u51FA\u4E00\u689D\u8DEF\u3002"
    _zhHans: "\u4E0D\u706D\u4E4B\u706B\u7194\u5316\u4E86\u5E9F\u94C1\n\u53EA\u80FD\u70B8\u51FA\u4E00\u6761\u8DEF\u3002"
  - _key: chapter.8.desc
    _ko: "\uBB38\uC774 \uC804\uBD80 \uC7A0\uAE34 \uAE30\uC9C0 \uAE4A\uC740 \uACF3\n\uC0AC\uC120\uACFC
      \uBC15\uC790\uB97C \uC77D\uC5B4\uC57C \uC9C0\uB098\uAC04\uB2E4."
    _ja: "\u3059\u3079\u3066\u306E\u6249\u304C\u9589\u3056\u3055\u308C\u305F\u57FA\u5730\u306E\u5965\n\u5C04\u7DDA\u3068\u30EA\u30BA\u30E0\u3092\u8AAD\u307E\u306A\u3051\u308C\u3070\u901A\u308C\u306A\u3044\u3002"
    _en: 'Deep in a base where every door is sealed.

      Read the firing lines
      and the rhythm to pass.'
    _zhHant: "\u6240\u6709\u9580\u90FD\u88AB\u9396\u4E0A\u7684\u57FA\u5730\u6DF1\u8655\n\u5FC5\u9808\u770B\u6E05\u5C04\u7DDA\u8207\u7BC0\u594F\u624D\u80FD\u901A\u904E\u3002"
    _zhHans: "\u6240\u6709\u95E8\u90FD\u88AB\u9501\u4E0A\u7684\u57FA\u5730\u6DF1\u5904\n\u5FC5\u987B\u770B\u6E05\u5C04\u7EBF\u4E0E\u8282\u594F\u624D\u80FD\u901A\u8FC7\u3002"
  - _key: chapter.9.desc
    _ko: "\uBD88\uC774 \uAEBC\uC9C4 \uAC70\uB9AC\uC5D0 \uB9DD\uC790\uAC00 \uAC77\uB294\uB2E4\n\uC774\uC81C\uB294
      \uBC14\uB2E5\uB9C8\uC800 \uC801\uC774\uB2E4."
    _ja: "\u706F\u308A\u306E\u6D88\u3048\u305F\u8857\u3092\u4EA1\u8005\u304C\u6B69\u304F\n\u3082\u306F\u3084\u5E8A\u3055\u3048\u3082\u6575\u3060\u3002"
    _en: 'The dead walk the darkened streets.

      Now even the floor is your enemy.'
    _zhHant: "\u4EA1\u8005\u884C\u8D70\u5728\u71C8\u706B\u7184\u6EC5\u7684\u8857\u9053\n\u5982\u4ECA\u9023\u5730\u9762\u90FD\u662F\u6575\u4EBA\u3002"
    _zhHans: "\u4EA1\u8005\u884C\u8D70\u5728\u706F\u706B\u7184\u706D\u7684\u8857\u9053\n\u5982\u4ECA\u8FDE\u5730\u9762\u90FD\u662F\u654C\u4EBA\u3002"
  - _key: chapter.10.desc
    _ko: "\uBAA8\uB4E0 \uAC83\uC774 \uC2DC\uC791\uB41C \uC625\uC0C1\n\uBC30\uC6B4
      \uAC83\uC744 \uC804\uBD80 \uAEBC\uB0B4\uC57C \uD55C\uB2E4."
    _ja: "\u3059\u3079\u3066\u304C\u59CB\u307E\u3063\u305F\u5C4B\u4E0A\n\u5B66\u3093\u3060\u3053\u3068\u3092\u3059\u3079\u3066\u51FA\u3057\u5207\u308C\u3002"
    _en: 'The rooftop where it all began.

      Give it everything you''ve learned.'
    _zhHant: "\u4E00\u5207\u958B\u59CB\u7684\u9802\u6A13\n\u62FF\u51FA\u4F60\u5B78\u5230\u7684\u4E00\u5207\u3002"
    _zhHans: "\u4E00\u5207\u5F00\u59CB\u7684\u5929\u53F0\n\u62FF\u51FA\u4F60\u5B66\u5230\u7684\u4E00\u5207\u3002"
  - _key: ui.ingame.result.dead_gold
    _ko: "\uC720\uB839\uC774 \uC18C\uBA78\uD588\uC2B5\uB2C8\uB2E4.\n\uC8FC\uC6B4
      \uACE8\uB4DC +{0} \uC744 \uCC59\uACA8 \uB85C\uBE44\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
    _ja: "\u30B4\u30FC\u30B9\u30C8\u304C\u6D88\u6EC5\u3057\u307E\u3057\u305F\u3002\n\u62FE\u3063\u305F\u30B4\u30FC\u30EB\u30C9
      +{0} \u3092\u6301\u3063\u3066\u30ED\u30D3\u30FC\u306B\u623B\u308A\u307E\u3059\u3002"
    _en: 'The ghost has vanished.

      You keep +{0} gold.'
    _zhHant: "\u5E7D\u9748\u6D88\u6563\u4E86\u3002\n\u5E36\u8457\u64BF\u5230\u7684\u91D1\u5E63
      +{0} \u8FD4\u56DE\u5927\u5EF3\u3002"
    _zhHans: "\u5E7D\u7075\u6D88\u6563\u4E86\u3002\n\u5E26\u7740\u6361\u5230\u7684\u91D1\u5E01
