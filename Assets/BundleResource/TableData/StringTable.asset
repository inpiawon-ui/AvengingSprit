    _zhHans: "\u5BF9\u8303\u56F4\u5185\u6240\u6709\u654C\u4EBA\u8D34\u4E0A\u70B8\u5F39\uFF0C2\u79D2\u540E\u8FDE\u9501\u7206\u70B8\uFF08\u671F\u95F4\u505C\u6B62\u666E\u653B\uFF09\u3002"
