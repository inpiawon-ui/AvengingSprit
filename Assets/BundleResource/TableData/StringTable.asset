  - _key: ui.rb.host.help
    _ko: "\uD638\uC2A4\uD2B8\uB97C \uB20C\uB7EC \uB2A5\uB825\uCE58 \xB7 \uC131\uAE09\uC744
      \uC62C\uB824\uC694.\n\uC870\uAC01\uC744 \uBAA8\uC73C\uBA74 \uC0C8 \uD638\uC2A4\uD2B8\uB97C
      \uD574\uAE08\uD574\uC694."
    _ja: "\u30DB\u30B9\u30C8\u3092\u30BF\u30C3\u30D7\u3057\u3066\u80FD\u529B\u30FB\u661F\u7D1A\u3092\u4E0A\u3052\u307E\u3059\u3002\n\u304B\u3051\u3089\u3092\u96C6\u3081\u308B\u3068\u65B0\u3057\u3044\u30DB\u30B9\u30C8\u3092\u89E3\u653E\u3067\u304D\u307E\u3059\u3002"
    _en: 'Tap a host to upgrade stats and stars.

      Collect shards to unlock
      new hosts.'
    _zhHant: "\u9EDE\u64CA\u5BBF\u4E3B\u63D0\u5347\u80FD\u529B\u503C\u8207\u661F\u7D1A\u3002\n\u6536\u96C6\u788E\u7247\u5373\u53EF\u89E3\u9396\u65B0\u5BBF\u4E3B\u3002"
    _zhHans: "\u70B9\u51FB\u5BBF\u4E3B\u63D0\u5347\u5C5E\u6027\u4E0E\u661F\u7EA7\u3002\n\u6536\u96C6\u788E\u7247\u5373\u53EF\u89E3\u9501\u65B0\u5BBF\u4E3B\u3002"
