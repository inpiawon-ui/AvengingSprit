    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH1_04.title
    _ko: "\uAE38 \uC783\uC740 \uC601\uD63C"
    _ja: "\u8FF7\u3048\u308B\u9B42"
    _en: 
  - _key: event.EV_CH1_04.body
    _ko: "\uC800\uB3C4 \uBAB8\uC744 \uCC3E\uB2E4 \uC9C0\uCE5C \uAC83\uC774 \uD558\uB098
      \uB5A0 \uC788\uB2E4.\n\uC81C \uBAAB\uC744 \uC870\uAE08 \uB5BC\uC5B4 \uC8FC\uBA74
      \uBAB8\uC73C\uB85C \uAC00\uB294 \uAE38\uC744 \uB113\uD600 \uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4."
    _ja: "\u4F53\u3092\u63A2\u3057\u75B2\u308C\u305F\u8005\u304C\u3072\u3068\u3064\u3001\u6F02\u3063\u3066\u3044\u308B\u3002\n\u5206\u3051\u524D\u3092\u5C11\u3057\u6E21\u305B\u3070\u3001\u4F53\u3078\u306E\u9053\u3092\u5E83\u3052\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 
  - _key: event.EV_CH1_04.accept
    _ko: "\uC601\uD63C\uC744 \uB098\uB220 \uC900\uB2E4"
    _ja: "\u9B42\u3092\u5206\u3051\u4E0E\u3048\u308B"
    _en: 
  - _key: event.EV_CH1_04.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: "\u7ACB\u3061\u53BB\u308B"
    _en: 
  - _key: event.EV_CH1_05.title
    _ko: "\uC57C\uC804 \uC758\uBB34\uBCD1"
    _ja: "\u91CE\u6226\u885B\u751F\u5175"
    _en: 
  - _key: event.EV_CH1_05.body
    _ko: "\uBD80\uB450 \uCC3D\uACE0\uC5D0 \uC544\uC9C1 \uC228\uC774 \uBD99\uC740
      \uC758\uBB34\uBCD1\uC774 \uC788\uB2E4.\n\uB9D0\uC740 \uC548 \uD1B5\uD558\uC9C0\uB9CC
      \uC190\uC9D3\uC740 \uD1B5\uD55C\uB2E4."
    _ja: "\u57E0\u982D\u306E\u5009\u5EAB\u306B\u3001\u307E\u3060\u606F\u306E\u3042\u308B\u885B\u751F\u5175\u304C\u3044\u308B\u3002\n\u8A00\u8449\u306F\u901A\u3058\u306A\u3044\u304C\u3001\u8EAB\u632F\u308A\u306F\u901A\u3058\u308B\u3002"
    _en: 
  - _key: event.EV_CH1_05.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: "\u4EE3\u4FA1\u3092\u6255\u3046"
    _en: 
  - _key: event.EV_CH1_05.decline
    _ko: "\uB0B4\uBC84\uB824 \uB454\uB2E4"
    _ja: "\u653E\u3063\u3066\u304A\u304F"
    _en: 
  - _key: event.EV_CH1_06.title
    _ko: "\uC881\uC740 \uAE38\uBAA9"
    _ja: "\u72ED\u3044\u901A\u308A\u9053"
    _en: 
  - _key: event.EV_CH1_06.body
    _ko: "\uC9D0\uC9DD \uC0AC\uC774\uB85C \uAE38\uC774 \uD558\uB098\uBFD0\uC774\uB2E4.\n\uBC18\uB300\uD3B8\uC5D0\uC11C
      \uAE30\uCC99\uC774 \uB09C\uB2E4. \uB3CC\uC544\uAC08 \uC218\uB3C4 \uC788\uB2E4."
    _ja: "\u8377\u7269\u306E\u9593\u306B\u9053\u306F\u3072\u3068\u3064\u3060\u3051\u3002\n\u5411\u3053\u3046\u5074\u3067\u6C17\u914D\u304C\u3059\u308B\u3002\u5F15\u304D\u8FD4\u3059\u3053\u3068\u3082\u3067\u304D\u308B\u3002"
    _en: 
  - _key: event.EV_CH1_06.accept
    _ko: "\uBC00\uACE0 \uB4E4\uC5B4\uAC04\uB2E4"
    _ja: "\u62BC\u3057\u5165\u308B"
    _en: 
