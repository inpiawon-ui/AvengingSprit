    _en: Walk Away
    _zhHant: "\u96E2\u958B"
    _zhHans: "\u79BB\u5F00"
  - _key: event.EV_CH3_04.title
    _ko: "\uD0C0\uB77D\uD55C \uD638\uC2A4\uD2B8"
    _ja: "\u5815\u3061\u305F\u30DB\u30B9\u30C8"
    _en: Fallen Host
    _zhHant: "\u58AE\u843D\u7684\u5BBF\u4E3B"
    _zhHans: "\u5815\u843D\u7684\u5BBF\u4E3B"
  - _key: event.EV_CH3_04.body
    _ko: "\uBC30\uAD00 \uC548\uCABD\uC5D0\uC11C \uB0A0\uAC1C \uC811\uB294 \uC18C\uB9AC\uAC00
      \uB09C\uB2E4.\n\uC0B4\uC744 \uC870\uAE08 \uB0B4\uC8FC\uBA74 \uC774\uCABD\uC73C\uB85C
      \uB098\uC628\uB2E4. \uB098\uC624\uBA74, \uBE7C\uC557\uC744 \uC218 \uC788\uB2E4."
    _ja: "\u914D\u7BA1\u306E\u5965\u304B\u3089\u3001\u7FFC\u3092\u305F\u305F\u3080\u97F3\u304C\u3059\u308B\u3002\n\u8089\u3092\u5C11\u3057\u5DEE\u3057\u51FA\u305B\u3070\u3001\u3053\u3061\u3089\u3078\u51FA\u3066\u304F\u308B\u3002\u51FA\u3066\u304F\u308C\u3070\u3001\u596A\u3048\u308B\u3002"
    _en: 'Wings fold somewhere deep in the pipes.

      Offer a little flesh and
      it comes out. Then it''s yours to take.'
    _zhHant: "\u7BA1\u7DDA\u6DF1\u8655\u50B3\u4F86\u6536\u7FC5\u7684\u8072\u97F3\u3002\n\u4EA4\u51FA\u4E00\u9EDE\u8840\u8089\uFF0C\u5B83\u5C31\u6703\u51FA\u4F86\u3002\u51FA\u4F86\u4E86\uFF0C\u5C31\u80FD\u596A\u53D6\u3002"
    _zhHans: "\u7BA1\u9053\u6DF1\u5904\u4F20\u6765\u6536\u7FC5\u7684\u58F0\u97F3\u3002\n\u4EA4\u51FA\u4E00\u70B9\u8840\u8089\uFF0C\u5B83\u5C31\u4F1A\u51FA\u6765\u3002\u51FA\u6765\u4E86\uFF0C\u5C31\u80FD\u593A\u53D6\u3002"
  - _key: event.EV_CH3_04.accept
    _ko: "\uC0B4\uC744 \uB0B4\uC900\uB2E4"
    _ja: "\u8089\u3092\u5DEE\u3057\u51FA\u3059"
    _en: Offer Flesh
    _zhHant: "\u4EA4\u51FA\u8840\u8089"
    _zhHans: "\u4EA4\u51FA\u8840\u8089"
