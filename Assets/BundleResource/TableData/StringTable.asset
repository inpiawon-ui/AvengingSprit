    _ko: "\uC4F0\uB808\uAE30 \uC9D1\uC801\uC7A5"
    _ja: "\u30B4\u30DF\u96C6\u7A4D\u5834"
    _en: Junkyard
    _zhHant: "\u5783\u573E\u96C6\u6563\u5834"
    _zhHans: "\u5783\u573E\u96C6\u6563\u573A"
  - _key: stage.2.1.name
    _ko: "\uBBF8\uC0AC\uC77C \uC800\uC7A5\uAE30\uC9C0"
