  - _key: ult.robot.desc
    _ko: "\uB85C\uBD07 \uB2E4\uC12F\uC774 \uBE5B\uAE30\uB465\uC73C\uB85C \uB0B4\uB824\uC640
      \uBBF8\uC0AC\uC77C\uC744 \uD37C\uBD93\uACE0, \uC800\uB9C8\uB2E4 \uC138 \uBC1C\uC744
      \uB354 \uC3D8\uACE0 \uB3CC\uC544\uAC04\uB2E4."
    _ja: "\u30ED\u30DC5\u4F53\u304C\u5149\u306E\u67F1\u3067\u964D\u4E0B\u3057\u3066\u30DF\u30B5\u30A4\u30EB\u3092\u6D74\u3073\u305B\u3001\u6700\u5F8C\u306B\u305D\u308C\u305E\u308C3\u767A\u6483\u3063\u3066\u5E30\u9084\u3059\u308B\u3002"
