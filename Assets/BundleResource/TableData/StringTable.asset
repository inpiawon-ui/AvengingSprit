  - _key: chapter.14.desc
    _ko: "\uAEBC\uC9C0\uC9C0 \uC54A\uB294 \uB4F1\uBD88\uC774\n\uC801\uC758 \uBAB8\uC744
      \uAC10\uC2FC\uB2E4."
    _ja: "\u6D88\u3048\u306A\u3044\u706F\u304C\n\u6575\u306E\u4F53\u3092\u5305\u307F\u8FBC\u3080\u3002"
    _en: 'Lanterns that never go out

      wrap your enemies in their light.'
    _zhHant: "\u6C38\u4E0D\u7184\u6EC5\u7684\u71C8\u706B\n\u5305\u8986\u8457\u6575\u4EBA\u7684\u8EAB\u9AD4\u3002"
    _zhHans: "\u6C38\u4E0D\u7184\u706D\u7684\u706F\u706B\n\u5305\u88F9\u7740\u654C\u4EBA\u7684\u8EAB\u4F53\u3002"
