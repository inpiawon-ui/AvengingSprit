    _en: 
  - _key: askill.psg_h13.name
    _ko: "\uC815\uC870\uC900"
    _ja: "\u7CBE\u5BC6\u7167\u6E96"
    _en: 
  - _key: askill.psg_h13.desc
    _ko: "5\uCD08\uAC04 \uCE58\uBA85\uD0C0 \uD655\uB960\uC774 90% \uB85C \uACE0\uC815\uB41C\uB2E4."
