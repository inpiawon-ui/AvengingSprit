    _zhHant: "\u4E94\u53F0\u6A5F\u5668\u4EBA\u4E58\u5149\u67F1\u964D\u4E0B\u50BE\u7009\u98DB\u5F48\uFF0C\u5404\u81EA\u518D\u5C04\u4E09\u767C\u5F8C\u8FD4\u56DE\u3002"
