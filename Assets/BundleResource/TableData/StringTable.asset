  - _key: ui.rb.chl.help
    _ko: "\uD0D1\uC740 \uD55C \uC8FC \uB3D9\uC548 \uCE35\uC744 \uC62C\uB77C\uAC00\uACE0,
      \uBC24\uC740 \uC694\uC77C\uB9C8\uB2E4 \uB2E4\uB978 \uADDC\uCE59\uC73C\uB85C
      \uBC84\uD168\uC694.\n\uC785\uC7A5\uC740 \uD558\uB8E8 3\uBC88 \xB7 \uC82C\uC73C\uB85C
      \uB354 \uC0B4 \uC218 \uC788\uC5B4\uC694."
    _ja: "\u5854\u306F1\u9031\u9593\u304B\u3051\u3066\u968E\u3092\u767B\u308A\u3001\u591C\u306F\u66DC\u65E5\u3054\u3068\u306B\u9055\u3046\u30EB\u30FC\u30EB\u3067\u8010\u3048\u307E\u3059\u3002\n\u5165\u5834\u306F1\u65E53\u56DE\u30FB\u30B8\u30A7\u30E0\u3067\u8FFD\u52A0\u3067\u304D\u307E\u3059\u3002"
    _en: "Climb the Tower floor by floor each week; survive the Night with a new
      rule each day.\n3 entries a day \xB7 buy more with gems."
    _zhHant: "\u5854\u8981\u5728\u4E00\u9031\u5167\u9010\u5C64\u6500\u767B\uFF0C\u591C\u665A\u6BCF\u5929\u898F\u5247\u4E0D\u540C\u3002\n\u6BCF\u65E5\u53EF\u5165\u58343\u6B21
      \xB7 \u53EF\u7528\u5BF6\u77F3\u8CFC\u8CB7\u66F4\u591A\u3002"
    _zhHans: "\u5854\u8981\u5728\u4E00\u5468\u5185\u9010\u5C42\u6500\u767B\uFF0C\u591C\u665A\u6BCF\u5929\u89C4\u5219\u4E0D\u540C\u3002\n\u6BCF\u65E5\u53EF\u5165\u573A3\u6B21
      \xB7 \u53EF\u7528\u5B9D\u77F3\u8D2D\u4E70\u66F4\u591A\u3002"
