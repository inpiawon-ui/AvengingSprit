    _en: Missile Depot
    _zhHant: "\u98DB\u5F48\u5132\u5B58\u57FA\u5730"
    _zhHans: "\u5BFC\u5F39\u50A8\u5B58\u57FA\u5730"
  - _key: stage.3.1.name
    _ko: "\uBC24\uC758 \uB3C4\uC2DC \uAC70\uB9AC"
    _ja: "\u591C\u306E\u8857"
    _en: Night City Streets
    _zhHant: "\u591C\u665A\u8857\u982D"
    _zhHans: "\u591C\u665A\u8857\u5934"
  - _key: stage.4.1.name
    _ko: "\uBC24\uC758 \uACF5\uC911\uAE30\uC9C0 \uC625\uC0C1"
    _ja: "\u591C\u306E\u7A7A\u4E2D\u57FA\u5730 \u5C4B\u4E0A"
    _en: Sky Base Rooftop at Night
    _zhHant: "\u591C\u665A\u7A7A\u4E2D\u57FA\u5730\u5C4B\u9802"
    _zhHans: "\u591C\u665A\u7A7A\u4E2D\u57FA\u5730\u5C4B\u9876"
  - _key: stage.5.1.name
    _ko: "\uC720\uB839 \uC5F0\uAD6C\uC18C"
    _ja: "\u5E7D\u970A\u7814\u7A76\u6240"
    _en: Ghost Laboratory
    _zhHant: "\u5E7D\u9748\u7814\u7A76\u6240"
    _zhHans: "\u5E7D\u7075\u7814\u7A76\u6240"
  - _key: stage.6.1.name
    _ko: "\uC57C\uAC04 \uC815\uC720\uC18C"
    _ja: "\u591C\u306E\u88FD\u6CB9\u6240"
    _en: Refinery at Night
    _zhHant: "\u591C\u9593\u7149\u6CB9\u5EE0"
    _zhHans: "\u591C\u95F4\u70BC\u6CB9\u5382"
  - _key: host.ghost.name
    _ko: "\uC720\uB839"
    _ja: "\u30B4\u30FC\u30B9\u30C8"
    _en: Ghost
    _zhHant: "\u5E7D\u9748"
    _zhHans: "\u5E7D\u7075"
  - _key: tip.loading.0
    _ko: "\uACE0\uC2A4\uD2B8\uB294 \uB5A0 \uC788\uB294 \uB3D9\uC548 \uCCB4\uB825\uC774
      \uAE4E\uC778\uB2E4. \uBAB8\uC740 \uBE68\uB9AC \uACE0\uB97C\uC218\uB85D \uC88B\uB2E4."
    _ja: "\u30B4\u30FC\u30B9\u30C8\u306F\u6F02\u3063\u3066\u3044\u308B\u9593\u3001\u4F53\u529B\u304C\u6E1B\u308A\u7D9A\u3051\u307E\u3059\u3002\u4F53\u306F\u65E9\u304F\u9078\u3076\u307B\u3069\u6709\u5229\u3067\u3059\u3002"
    _en: Your Ghost loses HP while drifting. Grab a body fast.
    _zhHant: "\u5E7D\u9748\u98C4\u6D6E\u6642HP\u6703\u6301\u7E8C\u6E1B\u5C11\u3002\u8D8A\u5FEB\u9078\u597D\u8EAB\u9AD4\u8D8A\u597D\u3002"
    _zhHans: "\u5E7D\u7075\u6F02\u6D6E\u65F6HP\u4F1A\u6301\u7EED\u51CF\u5C11\u3002\u8D8A\u5FEB\u9009\u597D\u8EAB\u4F53\u8D8A\u597D\u3002"
  - _key: tip.loading.1
    _ko: "\uBA48\uCDB0\uC57C \uC3DC\uB2E4. \uC6C0\uC9C1\uC774\uB294 \uB3D9\uC548\uC5D0\uB294
      \uC790\uB3D9 \uACF5\uACA9\uC774 \uBA48\uCD98\uB2E4."
    _ja: "\u6B62\u307E\u3063\u3066\u3044\u308B\u3068\u304D\u3060\u3051\u6483\u3061\u307E\u3059\u3002\u79FB\u52D5\u4E2D\u306F\u81EA\u52D5\u653B\u6483\u304C\u6B62\u307E\u308A\u307E\u3059\u3002"
    _en: Stand still to shoot. Auto-attack stops while you move.
    _zhHant: "\u505C\u4E0B\u624D\u6703\u5C04\u64CA\u3002\u79FB\u52D5\u6642\u81EA\u52D5\u653B\u64CA\u6703\u505C\u6B62\u3002"
    _zhHans: "\u505C\u4E0B\u624D\u4F1A\u5C04\u51FB\u3002\u79FB\u52A8\u65F6\u81EA\u52A8\u653B\u51FB\u4F1A\u505C\u6B62\u3002"
  - _key: tip.loading.2
    _ko: "\uBAB8\uC744 \uC2A4\uC2A4\uB85C \uB193\uC544\uC8FC\uBA74 \uADF8 \uBAB8\uC740
      \uC774 \uBC29\uC5D0\uC11C \uB2E4\uC2DC \uD0C8 \uC218 \uC5C6\uB2E4."
    _ja: "\u81EA\u5206\u304B\u3089\u624B\u653E\u3057\u305F\u4F53\u306B\u306F\u3001\u305D\u306E\u90E8\u5C4B\u3067\u518D\u3073\u6191\u4F9D\u3067\u304D\u307E\u305B\u3093\u3002"
    _en: A body you release can't be possessed again in that Room.
    _zhHant: "\u4E3B\u52D5\u653E\u68C4\u7684\u8EAB\u9AD4\uFF0C\u5728\u9019\u500B\u623F\u9593\u5167\u7121\u6CD5\u518D\u6B21\u9644\u8EAB\u3002"
    _zhHans: "\u4E3B\u52A8\u653E\u5F03\u7684\u8EAB\u4F53\uFF0C\u5728\u8FD9\u4E2A\u623F\u95F4\u5185\u65E0\u6CD5\u518D\u6B21\u9644\u8EAB\u3002"
  - _key: tip.loading.3
    _ko: "\uBCF4\uC2A4\uB294 \uBE7C\uC557\uC744 \uC218 \uC5C6\uB2E4. \uBCF4\uC2A4\uBC29\uC740
      \uD0C0\uACE0 \uB4E4\uC5B4\uAC04 \uBAB8\uC73C\uB85C \uB05D\uB0B4\uC57C \uD55C\uB2E4."
    _ja: "\u30DC\u30B9\u306B\u306F\u6191\u4F9D\u3067\u304D\u307E\u305B\u3093\u3002\u30DC\u30B9\u90E8\u5C4B\u306F\u4E57\u308A\u8FBC\u3093\u3060\u4F53\u3067\u6226\u3044\u629C\u304D\u307E\u3057\u3087\u3046\u3002"
    _en: Bosses can't be possessed. Finish the Boss Room in the body you brought.
    _zhHant: "\u982D\u76EE\u7121\u6CD5\u9644\u8EAB\u3002\u982D\u76EE\u623F\u5FC5\u9808\u7528\u5E36\u9032\u4F86\u7684\u8EAB\u9AD4\u6253\u5B8C\u3002"
    _zhHans: "\u5934\u76EE\u65E0\u6CD5\u9644\u8EAB\u3002\u5934\u76EE\u623F\u5FC5\u987B\u7528\u5E26\u8FDB\u6765\u7684\u8EAB\u4F53\u6253\u5B8C\u3002"
  - _key: tip.loading.4
    _ko: "\uC870\uC900 \uB9C1\uC774 \uD68C\uC0C9 \uC790\uBB3C\uC1E0\uBA74 \uC544\uC9C1
      \uC870\uAC74\uC774 \uC548 \uCC3C\uB2E4. \uB354 \uB450\uB4E4\uAE30\uBA74 \uC5F4\uB9B0\uB2E4."
    _ja: "\u7167\u6E96\u30EA\u30F3\u30B0\u304C\u7070\u8272\u306E\u9375\u306A\u3089\u3001\u307E\u3060\u6761\u4EF6\u3092\u6E80\u305F\u3057\u3066\u3044\u307E\u305B\u3093\u3002\u3055\u3089\u306B\u653B\u6483\u3059\u308B\u3068\u89E3\u653E\u3055\u308C\u307E\u3059\u3002"
    _en: A gray lock on the target ring means it's not ready yet. Keep hitting to
      unlock it.
    _zhHant: "\u7784\u6E96\u5708\u82E5\u662F\u7070\u8272\u9396\u982D\uFF0C\u4EE3\u8868\u689D\u4EF6\u5C1A\u672A\u9054\u6210\u3002\u7E7C\u7E8C\u653B\u64CA\u5C31\u6703\u89E3\u9396\u3002"
    _zhHans: "\u7784\u51C6\u5708\u82E5\u662F\u7070\u8272\u9501\u5934\uFF0C\u4EE3\u8868\u6761\u4EF6\u5C1A\u672A\u8FBE\u6210\u3002\u7EE7\u7EED\u653B\u51FB\u5C31\u4F1A\u89E3\u9501\u3002"
  - _key: tip.loading.5
    _ko: "\uBAB8\uC744 \uC783\uC73C\uBA74 Ghost HP 20%\uAC00 \uB0A0\uC544\uAC04\uB2E4.
      \uB193\uC544\uC8FC\uB294 \uD3B8\uC774 \uC2F8\uB2E4."
    _ja: "\u4F53\u3092\u5931\u3046\u3068Ghost HP\u304C20%\u6E1B\u308A\u307E\u3059\u3002\u81EA\u5206\u304B\u3089\u624B\u653E\u3059\u307B\u3046\u304C\u5B89\u304F\u6E08\u307F\u307E\u3059\u3002"
    _en: Losing a body costs 20% Ghost HP. Releasing it is cheaper.
    _zhHant: "\u5931\u53BB\u8EAB\u9AD4\u6703\u6263\u9664Ghost HP 20%\u3002\u4E3B\u52D5\u653E\u68C4\u6BD4\u8F03\u5212\u7B97\u3002"
    _zhHans: "\u5931\u53BB\u8EAB\u4F53\u4F1A\u6263\u9664Ghost HP 20%\u3002\u4E3B\u52A8\u653E\u5F03\u66F4\u5212\u7B97\u3002"
  - _key: tip.loading.6
    _ko: "\uD68C\uBCF5 \uBC29\uC5D0\uC11C\uB294 Ghost HP \uAC00 \uB3CC\uC544\uC628\uB2E4.
      \uB2E4\uC74C \uBC29\uC744 \uBCF4\uACE0 \uB4E4\uC5B4\uAC00\uB77C."
    _ja: "\u56DE\u5FA9\u90E8\u5C4B\u3067\u306FGhost HP\u304C\u623B\u308A\u307E\u3059\u3002\u6B21\u306E\u90E8\u5C4B\u3092\u898B\u3066\u304B\u3089\u9032\u307F\u307E\u3057\u3087\u3046\u3002"
    _en: Recovery Rooms restore Ghost HP. Check the next Room before entering.
    _zhHant: "\u56DE\u5FA9\u623F\u9593\u80FD\u56DE\u5FA9Ghost HP\u3002\u5148\u770B\u6E05\u4E0B\u4E00\u500B\u623F\u9593\u518D\u9032\u5165\u3002"
    _zhHans: "\u6062\u590D\u623F\u95F4\u80FD\u6062\u590DGhost HP\u3002\u5148\u770B\u6E05\u4E0B\u4E00\u4E2A\u623F\u95F4\u518D\u8FDB\u5165\u3002"
  - _key: tip.loading.7
    _ko: "\uBAB8\uC774 \uBC14\uB00C\uC5B4\uB3C4 \uBC84\uD504\uB294 \uB0A8\uB294\uB2E4.
      \uC2A4\uD0EF\uC774 \uC544\uB2C8\uB77C \uB098\uC5D0\uAC8C \uBD99\uAE30 \uB54C\uBB38\uC774\uB2E4."
    _ja: "\u4F53\u304C\u5909\u308F\u3063\u3066\u3082\u30D0\u30D5\u306F\u6B8B\u308A\u307E\u3059\u3002\u30B9\u30C6\u30FC\u30BF\u30B9\u3067\u306F\u306A\u304F\u3001\u3042\u306A\u305F\u81EA\u8EAB\u306B\u4ED8\u304F\u304B\u3089\u3067\u3059\u3002"
    _en: Buffs stay when you switch bodies. They belong to you, not your stats.
    _zhHant: "\u63DB\u8EAB\u9AD4\u5F8C\u589E\u76CA\u6548\u679C\u4ECD\u6703\u4FDD\u7559\uFF0C\u56E0\u70BA\u5B83\u9644\u5728\u4F60\u8EAB\u4E0A\uFF0C\u800C\u975E\u5C6C\u6027\u4E0A\u3002"
    _zhHans: "\u6362\u8EAB\u4F53\u540E\u589E\u76CA\u6548\u679C\u4ECD\u4F1A\u4FDD\u7559\uFF0C\u56E0\u4E3A\u5B83\u9644\u5728\u4F60\u8EAB\u4E0A\uFF0C\u800C\u4E0D\u662F\u5C5E\u6027\u4E0A\u3002"
  - _key: tip.loading.8
    _ko: "\uBA38\uB9AC \uC704 \uAE08\uC0C9 \uC870\uC900 \uB9C1\uC774 \uC9C0\uAE08
      \uBE59\uC758 \uBC84\uD2BC\uC774 \uB178\uB9AC\uB294 \uBAB8\uC774\uB2E4."
    _ja: "\u982D\u4E0A\u306E\u91D1\u8272\u306E\u7167\u6E96\u30EA\u30F3\u30B0\u304C\u3001\u3044\u307E\u6191\u4F9D\u30DC\u30BF\u30F3\u3067\u72D9\u3063\u3066\u3044\u308B\u4F53\u3067\u3059\u3002"
    _en: The gold ring overhead marks the body your Possess button is targeting.
    _zhHant: "\u982D\u4E0A\u7684\u91D1\u8272\u7784\u6E96\u5708\uFF0C\u5C31\u662F\u9644\u8EAB\u6309\u9215\u76EE\u524D\u9396\u5B9A\u7684\u8EAB\u9AD4\u3002"
    _zhHans: "\u5934\u4E0A\u7684\u91D1\u8272\u7784\u51C6\u5708\uFF0C\u5C31\u662F\u9644\u8EAB\u6309\u94AE\u5F53\u524D\u9501\u5B9A\u7684\u8EAB\u4F53\u3002"
  - _key: tip.loading.9
    _ko: "\uBE59\uC758 \uD45C\uC2DD\uC740 \uAC00\uAE4C\uC6B4 \uC21C\uC73C\uB85C \uB2E4\uC12F\uAE4C\uC9C0\uB9CC
      \uB72C\uB2E4. \uB098\uBA38\uC9C0\uB294 \uC0AC\uAC70\uB9AC \uBC16\uC774\uB2E4."
    _ja: "\u6191\u4F9D\u30DE\u30FC\u30AB\u30FC\u306F\u8FD1\u3044\u9806\u306B5\u3064\u307E\u3067\u8868\u793A\u3055\u308C\u307E\u3059\u3002\u305D\u308C\u4EE5\u5916\u306F\u5C04\u7A0B\u5916\u3067\u3059\u3002"
    _en: Up to five nearest Possess markers are shown. The rest are out of range.
    _zhHant: "\u9644\u8EAB\u6A19\u8A18\u4F9D\u8DDD\u96E2\u6700\u591A\u986F\u793A5\u500B\uFF0C\u5176\u9918\u90FD\u5728\u5C04\u7A0B\u5916\u3002"
    _zhHans: "\u9644\u8EAB\u6807\u8BB0\u6309\u8DDD\u79BB\u6700\u591A\u663E\u793A5\u4E2A\uFF0C\u5176\u4F59\u90FD\u5728\u5C04\u7A0B\u5916\u3002"
  - _key: tip.loading.10
    _ko: "\uBD89\uC740 X \uAC00 \uBD99\uC740 \uBAB8\uC740 \uB0B4\uAC00 \uBC84\uB9B0
      \uBAB8\uC774\uB2E4. \uC774 \uBC29\uC5D0\uC11C\uB294 \uB2E4\uC2DC \uBABB \uD0C4\uB2E4."
    _ja: "\u8D64\u3044\xD7\u304C\u4ED8\u3044\u305F\u4F53\u306F\u3001\u3042\u306A\u305F\u304C\u6368\u3066\u305F\u4F53\u3067\u3059\u3002\u3053\u306E\u90E8\u5C4B\u3067\u306F\u518D\u3073\u6191\u4F9D\u3067\u304D\u307E\u305B\u3093\u3002"
    _en: A red X marks a body you abandoned. You can't possess it again in this Room.
    _zhHant: "\u5E36\u6709\u7D05\u8272X\u7684\u8EAB\u9AD4\u662F\u4F60\u62CB\u68C4\u7684\u8EAB\u9AD4\uFF0C\u5728\u9019\u500B\u623F\u9593\u5167\u7121\u6CD5\u518D\u9644\u8EAB\u3002"
    _zhHans: "\u5E26\u6709\u7EA2\u8272X\u7684\u8EAB\u4F53\u662F\u4F60\u629B\u5F03\u7684\u8EAB\u4F53\uFF0C\u5728\u8FD9\u4E2A\u623F\u95F4\u5185\u65E0\u6CD5\u518D\u9644\u8EAB\u3002"
  - _key: tip.loading.11
    _ko: "\uC561\uD2F0\uBE0C \uC2A4\uD0AC\uC740 \uBAB8\uB9C8\uB2E4 \uB2E4\uB974\uB2E4.
      \uC5B4\uB5A4 \uBAB8\uC744 \uD0D4\uB294\uC9C0\uAC00 \uACE7 \uC5B4\uB5A4 \uC561\uD2F0\uBE0C
      \uC2A4\uD0AC\uB97C \uC4F0\uB294\uC9C0\uB2E4."
    _ja: "\u30A2\u30AF\u30C6\u30A3\u30D6\u30B9\u30AD\u30EB\u306F\u4F53\u3054\u3068\u306B\u7570\u306A\u308A\u307E\u3059\u3002\u3069\u306E\u4F53\u306B\u6191\u4F9D\u3057\u305F\u304B\u3067\u3001\u4F7F\u3048\u308B\u30A2\u30AF\u30C6\u30A3\u30D6\u30B9\u30AD\u30EB\u304C\u6C7A\u307E\u308A\u307E\u3059\u3002"
    _en: Each body has its own Active Skill. Your Host decides which one you use.
    _zhHant: "\u4E3B\u52D5\u6280\u80FD\u56E0\u8EAB\u9AD4\u800C\u7570\u3002\u9644\u8EAB\u54EA\u500B\u8EAB\u9AD4\uFF0C\u5C31\u6C7A\u5B9A\u4F7F\u7528\u54EA\u500B\u4E3B\u52D5\u6280\u80FD\u3002"
    _zhHans: "\u4E3B\u52A8\u6280\u80FD\u56E0\u8EAB\u4F53\u800C\u5F02\u3002\u9644\u8EAB\u54EA\u4E2A\u8EAB\u4F53\uFF0C\u5C31\u51B3\u5B9A\u4F7F\u7528\u54EA\u4E2A\u4E3B\u52A8\u6280\u80FD\u3002"
  - _key: tip.loading.12
    _ko: "\uC8FC\uC704\uC5D0 \uBE8F\uC744 \uBAB8\uC774 \uD558\uB098\uB3C4 \uC5C6\uC73C\uBA74
      \uC7A0\uC2DC \uB4A4 \uBAB8 \uD558\uB098\uAC00 \uB358\uC838\uC9C4\uB2E4. \uB300\uC2E0
      \uAC12\uC774 \uBE44\uC2F8\uB2E4."
    _ja: "\u5468\u56F2\u306B\u596A\u3048\u308B\u4F53\u304C\u3072\u3068\u3064\u3082\u306A\u3044\u3068\u3001\u3057\u3070\u3089\u304F\u3057\u3066\u4F53\u304C\u3072\u3068\u3064\u6295\u3052\u8FBC\u307E\u308C\u307E\u3059\u3002\u305F\u3060\u3057\u30B3\u30B9\u30C8\u306F\u9AD8\u3081\u3067\u3059\u3002"
    _en: With no bodies nearby, one gets thrown in after a while, at a higher cost.
    _zhHant: "\u5468\u570D\u6C92\u6709\u53EF\u596A\u53D6\u7684\u8EAB\u9AD4\u6642\uFF0C\u904E\u4E00\u6703\u5152\u6703\u4E1F\u9032\u4E00\u500B\u8EAB\u9AD4\uFF0C\u4F46\u4EE3\u50F9\u8F03\u9AD8\u3002"
    _zhHans: "\u5468\u56F4\u6CA1\u6709\u53EF\u593A\u53D6\u7684\u8EAB\u4F53\u65F6\uFF0C\u8FC7\u4E00\u4F1A\u513F\u4F1A\u6254\u8FDB\u4E00\u4E2A\u8EAB\u4F53\uFF0C\u4F46\u4EE3\u4EF7\u8F83\u9AD8\u3002"
  - _key: tip.loading.13
    _ko: "\uD654\uBA74 \uAC00\uC7A5\uC790\uB9AC \uD654\uC0B4\uD45C\uB294 \uCC3D \uBC16\uC5D0
      \uBE8F\uC744 \uBAB8\uC774 \uC788\uB2E4\uB294 \uB73B\uC774\uB2E4."
    _ja: "\u753B\u9762\u7AEF\u306E\u77E2\u5370\u306F\u3001\u753B\u9762\u5916\u306B\u596A\u3048\u308B\u4F53\u304C\u3042\u308B\u3053\u3068\u3092\u793A\u3057\u3066\u3044\u307E\u3059\u3002"
    _en: Arrows at the screen edge point to bodies you can take off-screen.
    _zhHant: "\u756B\u9762\u908A\u7DE3\u7684\u7BAD\u982D\uFF0C\u8868\u793A\u756B\u9762\u5916\u6709\u53EF\u596A\u53D6\u7684\u8EAB\u9AD4\u3002"
    _zhHans: "\u753B\u9762\u8FB9\u7F18\u7684\u7BAD\u5934\uFF0C\u8868\u793A\u753B\u9762\u5916\u6709\u53EF\u593A\u53D6\u7684\u8EAB\u4F53\u3002"
  - _key: opening.line.0
    _ko: "\uC5B4\uB290 \uB0A0, \uC5EC\uC790\uCE5C\uAD6C\uC640 \uD568\uAED8 \uAC77\uACE0
      \uC788\uC5C8\uB2E4."
    _ja: "\u3042\u308B\u65E5\u3001\u604B\u4EBA\u3068\u4E00\u7DD2\u306B\u6B69\u3044\u3066\u3044\u305F\u3002"
    _en: One day, I was out walking with my girlfriend.
    _zhHant: "\u67D0\u5929\uFF0C\u6211\u6B63\u548C\u5973\u53CB\u4E00\u8D77\u6563\u6B65\u3002"
    _zhHans: "\u67D0\u5929\uFF0C\u6211\u6B63\u548C\u5973\u670B\u53CB\u4E00\u8D77\u6563\u6B65\u3002"
  - _key: opening.line.1
    _ko: "\uADF8\uB7F0\uB370 \uAC11\uC790\uAE30, \uC2B5\uACA9\uB2F9\uD588\uB2E4!"
    _ja: "\u3059\u308B\u3068\u7A81\u7136\u3001\u8972\u308F\u308C\u305F\uFF01"
    _en: Then, out of nowhere, we were attacked!
    _zhHant: "\u7A81\u7136\u9593\uFF0C\u6211\u5011\u906D\u5230\u8972\u64CA\uFF01"
    _zhHans: "\u7A81\u7136\u95F4\uFF0C\u6211\u4EEC\u906D\u5230\u88AD\u51FB\uFF01"
  - _key: opening.line.2
    _ko: "\uC73C\uC544\uC544\uC544\uC544\uC544\uC545\u2026\u2026"
    _ja: "\u3046\u308F\u3042\u3042\u3042\u3042\u3042\u3063\u2026\u2026"
    _en: Aaaaaaargh......
    _zhHant: "\u55DA\u554A\u554A\u554A\u554A\u554A\u2026\u2026"
    _zhHans: "\u545C\u554A\u554A\u554A\u554A\u554A\u2026\u2026"
  - _key: opening.line.6
    _ko: "\uD0D5!"
    _ja: "\u30D0\u30F3\u30C3\uFF01"
    _en: BANG!
    _zhHant: "\u7830\uFF01"
    _zhHans: "\u7830\uFF01"
  - _key: opening.line.9
    _ko: "\uADF8\uB9AC\uACE0, \uB098\uB294 \uC8FD\uC5C8\uB2E4."
    _ja: "\u305D\u3057\u3066\u3001\u4FFA\u306F\u6B7B\u3093\u3060\u3002"
    _en: And so, I died.
    _zhHant: "\u7136\u5F8C\uFF0C\u6211\u6B7B\u4E86\u3002"
    _zhHans: "\u7136\u540E\uFF0C\u6211\u6B7B\u4E86\u3002"
  - _key: opening.line.10
    _ko: "\uB0B4\uAC00 \uC790\uB124\uB97C \uBD88\uB800\uB124."
    _ja: "\u308F\u3057\u304C\u541B\u3092\u547C\u3093\u3060\u306E\u3058\u3083\u3002"
    _en: It was I who summoned you.
    _zhHant: "\u662F\u8001\u592B\u53EC\u559A\u4E86\u4F60\u3002"
    _zhHans: "\u662F\u8001\u592B\u53EC\u5524\u4E86\u4F60\u3002"
  - _key: opening.line.11
    _ko: "\uADF8\uC790\uB4E4\uC740 \uC545\uC758 \uBE44\uBC00\uACB0\uC0AC\uC600\uC5B4."
    _ja: "\u5974\u3089\u306F\u60AA\u306E\u79D8\u5BC6\u7D50\u793E\u3058\u3083\u3063\u305F\u3002"
    _en: They were an evil secret society.
    _zhHant: "\u90A3\u4E9B\u4EBA\u662F\u90AA\u60E1\u7684\u7955\u5BC6\u7D50\u793E\u3002"
    _zhHans: "\u90A3\u4E9B\u4EBA\u662F\u90AA\u6076\u7684\u79D8\u5BC6\u7ED3\u793E\u3002"
  - _key: opening.line.12
    _ko: "\uB0B4 \uC720\uB839 \uC5D0\uB108\uC9C0 \uC5F0\uAD6C\uB97C \uCE90\uB0B4\uB824\uACE0\n\uB538\uC744
      \uB0A9\uCE58\uD574 \uBAB8\uAC12\uC744 \uC694\uAD6C\uD588\uB2E4\uB124."
    _ja: "\u308F\u3057\u306E\u5E7D\u970A\u30A8\u30CD\u30EB\u30AE\u30FC\u7814\u7A76\u3092\u596A\u304A\u3046\u3068\n\u5A18\u3092\u3055\u3089\u3044\u3001\u8EAB\u4EE3\u91D1\u3092\u8981\u6C42\u3057\u3066\u304D\u305F\u306E\u3058\u3083\u3002"
    _en: 'To steal my ghost energy research,

      they kidnapped my daughter for
      ransom.'
    _zhHant: "\u4ED6\u5011\u70BA\u4E86\u596A\u53D6\u6211\u7684\u5E7D\u9748\u80FD\u91CF\u7814\u7A76\uFF0C\n\u7D81\u67B6\u4E86\u6211\u5973\u5152\u7D22\u8981\u8D16\u91D1\u3002"
    _zhHans: "\u4ED6\u4EEC\u4E3A\u4E86\u593A\u53D6\u6211\u7684\u5E7D\u7075\u80FD\u91CF\u7814\u7A76\uFF0C\n\u7ED1\u67B6\u4E86\u6211\u5973\u513F\u7D22\u8981\u8D4E\u91D1\u3002"
  - _key: opening.line.13
    _ko: "\uC790\uB124\uC758 \uC5D0\uB108\uC9C0\uB294 \uD55C\uC815\uB3FC \uC788\uB124."
    _ja: "\u541B\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u306B\u306F\u9650\u308A\u304C\u3042\u308B\u3002"
    _en: Your energy is limited.
    _zhHant: "\u4F60\u7684\u80FD\u91CF\u662F\u6709\u9650\u7684\u3002"
    _zhHans: "\u4F60\u7684\u80FD\u91CF\u662F\u6709\u9650\u7684\u3002"
  - _key: opening.line.14
    _ko: "\uC790\uB124\uC758 \uC5D0\uB108\uC9C0\uB294 \uD55C\uC815\uB3FC \uC788\uB124."
    _ja: "\u541B\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u306B\u306F\u9650\u308A\u304C\u3042\u308B\u3002"
    _en: Your energy is limited.
    _zhHant: "\u4F60\u7684\u80FD\u91CF\u662F\u6709\u9650\u7684\u3002"
    _zhHans: "\u4F60\u7684\u80FD\u91CF\u662F\u6709\u9650\u7684\u3002"
  - _key: opening.line.15
