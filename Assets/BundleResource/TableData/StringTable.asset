    _ja: "\u6247\u72B68\u65B9\u5411\u306B\u5149\u5F3E\u3092\u653E\u3064\u3002"
    _en: 
  - _key: askill.psg_h17.name
    _ko: "\uC0AC\uC2AC \uACB0\uBC15"
    _ja: "\u9396\u306E\u675F\u7E1B"
    _en: 
  - _key: askill.psg_h17.desc
    _ko: "\uBC29 \uC548 \uBAA8\uB4E0 \uC801\uC744 5\uCD08\uAC04 \uBB36\uB294\uB2E4.
      \uBB36\uC778 \uC801\uC740 \uB354 \uC544\uD504\uAC8C \uB9DE\uB294\uB2E4."
    _ja: "\u90E8\u5C4B\u306E\u5168\u3066\u306E\u6575\u30925\u79D2\u9593\u62D8\u675F\u3002\u62D8\u675F\u4E2D\u306E\u6575\u306F\u88AB\u30C0\u30E1\u30FC\u30B8\u5897\u52A0\u3002"
    _en: 
  - _key: askill.psg_h18.name
    _ko: "\uADF8\uB9BC\uC790 \uBD84\uC2E0"
    _ja: "\u5F71\u5206\u8EAB"
    _en: 
  - _key: askill.psg_h18.desc
    _ko: "\uBC29 \uD55C\uAC00\uC6B4\uB370 \uBD84\uC2E0\uC744 \uC138\uC6B4\uB2E4.
      5\uCD08\uAC04 \uC801\uC774 \uC804\uBD80 \uBD84\uC2E0\uC744 \uB178\uB9B0\uB2E4."
    _ja: "\u90E8\u5C4B\u306E\u4E2D\u592E\u306B\u5206\u8EAB\u3092\u7F6E\u304F\u30025\u79D2\u9593\u3001\u6575\u306F\u3059\u3079\u3066\u5206\u8EAB\u3092\u72D9\u3046\u3002"
    _en: 
