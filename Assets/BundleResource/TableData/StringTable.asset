  - _key: ult.medium.desc
    _ko: "\uAC70\uB300 \uC6D0\uD63C\uC744 \uBD88\uB7EC 5\uCD08\uAC04 \uB458\uB808
      \uC801\uC744 \uD560\uD034\uAC8C \uD558\uACE0, \uB05D\uC5D0 \uD06C\uAC8C \uD130\uB728\uB9B0\uB2E4."
    _ja: "\u5DE8\u5927\u306A\u6028\u970A\u3092\u547C\u3073\u30015\u79D2\u9593\u5468\u56F2\u306E\u6575\u3092\u5F15\u304D\u88C2\u304B\u305B\u3001\u6700\u5F8C\u306B\u5927\u7206\u767A\u3055\u305B\u308B\u3002"
