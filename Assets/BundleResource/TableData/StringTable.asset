    _ja: "1\u79D2\u9593\u30013\u65B9\u5411\u306B\u6483\u3061\u307E\u304F\u308B\u3002"
    _en: 
  - _key: askill.psg_h12.name
    _ko: "\uC218\uD638 \uACB0\uACC4"
    _ja: "\u5B88\u8B77\u7D50\u754C"
    _en: 
  - _key: askill.psg_h12.desc
