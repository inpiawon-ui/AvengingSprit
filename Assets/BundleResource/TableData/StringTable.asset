    _ko: "\uC7A5\uBE44\uB97C \uCC59\uAE34\uB2E4"
    _ja: "\u88C5\u5099\u3092\u6301\u3063\u3066\u3044\u304F"
    _en: 
  - _key: event.EV_CH1_02.decline
    _ko: "\uD314\uC544 \uB118\uAE34\uB2E4  (\uACE8\uB4DC 25)"
    _ja: "\u58F2\u308A\u6255\u3046  \uFF08\u30B4\u30FC\u30EB\u30C925\uFF09"
    _en: 
  - _key: event.EV_CH1_03.title
    _ko: "\uC7A0\uAE34 \uAE08\uACE0"
    _ja: "\u9375\u306E\u304B\u304B\u3063\u305F\u91D1\u5EAB"
    _en: 
  - _key: event.EV_CH1_03.body
    _ko: "\uB2E4\uC774\uC5BC\uC774 \uC138 \uCE78 \uB0A8\uC558\uB2E4. \uC5B5\uC9C0\uB85C
      \uC5F4\uBA74 \uC548\uC758 \uAC83\uC774 \uC0C1\uD560\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    _ja: "\u30C0\u30A4\u30E4\u30EB\u306F\u3042\u30683\u3064\u3002\u7121\u7406\u306B\u958B\u3051\u308C\u3070\u3001\u4E2D\u8EAB\u304C\u50B7\u3080\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
    _en: 
