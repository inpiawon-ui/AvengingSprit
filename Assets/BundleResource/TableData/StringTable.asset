    _en: 
  - _key: askill.psg_h02.desc
    _ko: "\uC2A4\uD0AC \uBCF4\uB958 \u2014 \uC815\uD574\uC9C0\uBA74 \uCC44\uC6B4\uB2E4."
    _ja: "\u30B9\u30AD\u30EB\u4FDD\u7559 \u2014 \u6C7A\u307E\u308A\u6B21\u7B2C\u8FFD\u52A0\u3059\u308B\u3002"
