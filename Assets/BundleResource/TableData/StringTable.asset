  - _key: event.EV_DEAL_07.body
    _ko: "\uC81C\uB2E8 \uC704\uC5D0 \uCE74\uB4DC \uC138 \uC7A5\uC774 \uB5A0\uC624\uB978\uB2E4.\n\uADF8\uB987\uC744
      \uAE4E\uC544 \uB0B4\uBA74 \uADF8\uC911 \uD558\uB098\uB97C \uC950\uAC8C \uD574
      \uC900\uB2E4."
    _ja: "\u796D\u58C7\u306E\u4E0A\u306B\u30AB\u30FC\u30C9\u304C\u4E09\u679A\u6D6E\u304B\u3076\u3002\n\u5668\u3092\u524A\u308C\u3070\u3001\u305D\u306E\u3046\u3061\u4E00\u679A\u3092\u63E1\u3089\u305B\u3066\u3084\u308D\u3046\u3002"
    _en: 'Three cards rise above the Altar.

      Carve away your vessel, and one
      is yours.'
    _zhHant: "\u796D\u58C7\u4E0A\u6D6E\u73FE\u4E09\u5F35\u5361\u7247\u3002\n\u524A\u53BB\u5BB9\u5668\uFF0C\u5C31\u8B93\u4F60\u63E1\u4F4F\u5176\u4E2D\u4E00\u5F35\u3002"
    _zhHans: "\u796D\u575B\u4E0A\u6D6E\u73B0\u4E09\u5F20\u5361\u7247\u3002\n\u524A\u53BB\u5BB9\u5668\uFF0C\u5C31\u8BA9\u4F60\u63E1\u4F4F\u5176\u4E2D\u4E00\u5F20\u3002"
