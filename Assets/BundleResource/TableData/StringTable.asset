  - _key: event.EV_CH1_01.title
    _ko: "\uC601\uD63C\uC758 \uC0AC\uB2F9"
    _ja: 
    _en: 
  - _key: event.EV_CH1_01.body
    _ko: "\uBD80\uC11C\uC9C4 \uBC29\uD30C\uC81C \uB05D\uC5D0 \uB0A1\uC740 \uC0AC\uB2F9\uC774
      \uC11C \uC788\uB2E4.\n\uB3D9\uC804\uC744 \uB193\uB294 \uC790\uB9AC\uAC00 \uC190\uB54C\uC5D0
      \uD30C\uC5EC \uC788\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH1_01.accept
    _ko: "\uB3D9\uC804\uC744 \uB193\uB294\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_01.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_02.title
    _ko: "\uBC84\uB824\uC9C4 \uBCF4\uAE09\uD488"
    _ja: 
    _en: 
  - _key: event.EV_CH1_02.body
    _ko: "\uB4A4\uC9D1\uD78C \uC0C1\uC790 \uD558\uB098. \uC548\uC5D0 \uB4E0 \uAC83\uC744
      \uB2E4 \uAC00\uC838\uAC08 \uC218\uB294 \uC5C6\uB2E4.\n\uC7A5\uBE44\uB97C \uCC59\uAE30\uB4E0\uC9C0,
      \uD314\uC544 \uB118\uAE30\uB4E0\uC9C0."
    _ja: 
    _en: 
  - _key: event.EV_CH1_02.accept
    _ko: "\uC7A5\uBE44\uB97C \uCC59\uAE34\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_02.decline
    _ko: "\uD314\uC544 \uB118\uAE34\uB2E4  (\uACE8\uB4DC 25)"
    _ja: 
    _en: 
  - _key: event.EV_CH1_03.title
    _ko: "\uC7A0\uAE34 \uAE08\uACE0"
    _ja: 
    _en: 
  - _key: event.EV_CH1_03.body
    _ko: "\uB2E4\uC774\uC5BC\uC774 \uC138 \uCE78 \uB0A8\uC558\uB2E4. \uC5B5\uC9C0\uB85C
      \uC5F4\uBA74 \uC548\uC758 \uAC83\uC774 \uC0C1\uD560\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH1_03.accept
    _ko: "\uC5B5\uC9C0\uB85C \uC5F0\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_03.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_04.title
    _ko: "\uAE38 \uC783\uC740 \uC601\uD63C"
    _ja: 
    _en: 
  - _key: event.EV_CH1_04.body
    _ko: "\uC800\uB3C4 \uBAB8\uC744 \uCC3E\uB2E4 \uC9C0\uCE5C \uAC83\uC774 \uD558\uB098
      \uB5A0 \uC788\uB2E4.\n\uC81C \uBAAB\uC744 \uC870\uAE08 \uB5BC\uC5B4 \uC8FC\uBA74
      \uBAB8\uC73C\uB85C \uAC00\uB294 \uAE38\uC744 \uB113\uD600 \uC8FC\uACA0\uB2E4\uACE0
      \uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH1_04.accept
    _ko: "\uC601\uD63C\uC744 \uB098\uB220 \uC900\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_04.decline
    _ko: "\uC9C0\uB098\uAC04\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_05.title
    _ko: "\uC57C\uC804 \uC758\uBB34\uBCD1"
    _ja: 
    _en: 
  - _key: event.EV_CH1_05.body
    _ko: "\uBD80\uB450 \uCC3D\uACE0\uC5D0 \uC544\uC9C1 \uC228\uC774 \uBD99\uC740
      \uC758\uBB34\uBCD1\uC774 \uC788\uB2E4.\n\uB9D0\uC740 \uC548 \uD1B5\uD558\uC9C0\uB9CC
      \uC190\uC9D3\uC740 \uD1B5\uD55C\uB2E4."
    _ja: 
    _en: 
  - _key: event.EV_CH1_05.accept
    _ko: "\uAC12\uC744 \uCE58\uB978\uB2E4"
    _ja: 
    _en: 
  - _key: event.EV_CH1_05.decline
    _ko: "\uB0B4\uBC84\uB824 \uB454\uB2E4"
    _ja: 
    _en: 
