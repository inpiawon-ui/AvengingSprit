  - _key: event.EV_CH1_02.body
    _ko: "\uB4A4\uC9D1\uD78C \uC0C1\uC790 \uD558\uB098. \uC548\uC5D0 \uB4E0 \uAC83\uC744
      \uB2E4 \uAC00\uC838\uAC08 \uC218\uB294 \uC5C6\uB2E4.\n\uC7A5\uBE44\uB97C \uCC59\uAE30\uB4E0\uC9C0,
      \uD314\uC544 \uB118\uAE30\uB4E0\uC9C0."
    _ja: "\u6A2A\u5012\u3057\u306E\u7BB1\u304C\u3072\u3068\u3064\u3002\u4E2D\u8EAB\u3092\u3059\u3079\u3066\u6301\u3063\u3066\u3044\u304F\u3053\u3068\u306F\u3067\u304D\u306A\u3044\u3002\n\u88C5\u5099\u3092\u6301\u3063\u3066\u3044\u304F\u304B\u3001\u58F2\u308A\u6255\u3046\u304B\u3002"
    _en: 'An overturned crate. You can''t take it all.

      Keep the gear, or sell
      it off.'
    _zhHant: "\u4E00\u500B\u7FFB\u5012\u7684\u7BB1\u5B50\u3002\u88E1\u9762\u7684\u6771\u897F\u7121\u6CD5\u5168\u90E8\u5E36\u8D70\u3002\n\u5E36\u8D70\u88DD\u5099\uFF0C\u9084\u662F\u8CE3\u6389\uFF1F"
    _zhHans: "\u4E00\u4E2A\u7FFB\u5012\u7684\u7BB1\u5B50\u3002\u91CC\u9762\u7684\u4E1C\u897F\u65E0\u6CD5\u5168\u90E8\u5E26\u8D70\u3002\n\u5E26\u8D70\u88C5\u5907\uFF0C\u8FD8\u662F\u5356\u6389\uFF1F"
