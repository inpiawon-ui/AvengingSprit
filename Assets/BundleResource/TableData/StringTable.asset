    _en: 
  - _key: askill.psg_h14.name
    _ko: "\uB3C4\uC57D \uAC15\uC2B5"
    _ja: "\u8DF3\u8E8D\u5F37\u8972"
    _en: 
  - _key: askill.psg_h14.desc
    _ko: "\uAC00\uC7A5 \uBA3C \uC801\uC5D0\uAC8C \uB6F0\uC5B4\uB4E4\uACE0 2\uCD08\uAC04
      \uBB34\uC801."
