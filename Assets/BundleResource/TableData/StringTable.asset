      \uC801 \uC804\uC6D0\uC5D0\uAC8C \uCE58\uBA85 \uD655\uC815."
    _ja: "\u5203\u3067\u524D\u65B9\u306E\u6575\u3092\u307E\u3068\u3081\u3066\u62D8\u675F\u3057\u3001\u62D8\u675F\u3057\u305F\u6575\u5168\u54E1\u306B\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u78BA\u5B9A\u3002"
