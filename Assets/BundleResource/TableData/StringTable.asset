    _ja: "\u5206\u8EAB\u30923\u4F53\u547C\u3073\u51FA\u30576\u79D2\u9593\u5171\u306B\u653B\u6483\u3059\u308B\u3002\u5FCD\u8005\u304C\u6295\u3052\u308B\u30683\u4F53\u3082\u540C\u6642\u306B\u6295\u3052\u308B\u3002"
