  - _key: askill.psg_h15.name
    _ko: "\uACE8\uB818 \uC18C\uD658"
    _ja: "\u30B4\u30FC\u30EC\u30E0\u53EC\u559A"
    _en: 
  - _key: askill.psg_h15.desc
    _ko: "\uACE8\uB818\uC744 \uC138\uC6B4\uB2E4. \uD574\uACE8\uBCF4\uB2E4 \uD06C\uACE0
      \uC624\uB798 \uC2F8\uC6B4\uB2E4."
    _ja: "\u30B4\u30FC\u30EC\u30E0\u3092\u547C\u3073\u51FA\u3059\u3002\u30B9\u30B1\u30EB\u30C8\u30F3\u3088\u308A\u5927\u304D\u304F\u3001\u9577\u304F\u6226\u3046\u3002"
    _en: 
  - _key: askill.psg_h16.name
    _ko: "\uAD11\uD718 \uD655\uC0B0"
    _ja: "\u5149\u8F1D\u62E1\u6563"
    _en: 
  - _key: askill.psg_h16.desc
