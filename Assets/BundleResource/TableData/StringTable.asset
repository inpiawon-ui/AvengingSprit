      \uB113\uC5B4\uC9C4\uB2E4."
    _ja: "\u30B9\u30AD\u30EB\u30FB\u5FC5\u6BBA\u6280\u30FB\u7206\u767A\u306E\u7BC4\u56F2\u304C\u5E83\u304C\u308B\u3002"
