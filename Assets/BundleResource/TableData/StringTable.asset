    _en: Turn Away
    _zhHant: "\u8F49\u8EAB\u96E2\u958B"
    _zhHans: "\u8F6C\u8EAB\u79BB\u5F00"
  - _key: event.EV_DEAL_06.title
    _ko: "\uAD76\uC8FC\uB9BC"
    _ja: "\u98E2\u3048"
    _en: Hunger
    _zhHant: "\u98E2\u9913"
    _zhHans: "\u9965\u997F"
  - _key: event.EV_DEAL_06.body
    _ko: "\uAD76\uC8FC\uB9B0 \uAC83\uC774 \uC81C \uC774\uBE68\uC744 \uB0B4\uBBFC\uB2E4.\n\uADF8\uB987\uC744
      \uC870\uAE08 \uB0B4\uC8FC\uBA74 \uB0A8\uC758 \uD53C\uB85C \uCC44\uC6B0\uB294
      \uBC95\uC744 \uC54C\uB824 \uC900\uB2E4."
    _ja: "\u98E2\u3048\u305F\u3082\u306E\u304C\u81EA\u3089\u306E\u7259\u3092\u5DEE\u3057\u51FA\u3059\u3002\n\u5668\u3092\u5C11\u3057\u6E21\u305B\u3070\u3001\u4ED6\u8005\u306E\u8840\u3067\u6E80\u305F\u3059\u8853\u3092\u6559\u3048\u3066\u3084\u308B\u3068\u8A00\u3046\u3002"
    _en: 'A starving thing bares its fangs to you.

      Give up some of your vessel,
      and learn to fill it with others'' blood.'
    _zhHant: "\u98E2\u9913\u4E4B\u7269\u5411\u4F60\u9732\u51FA\u7360\u7259\u3002\n\u4EA4\u51FA\u4E00\u9EDE\u5BB9\u5668\uFF0C\u5C31\u6559\u4F60\u7528\u4ED6\u4EBA\u7684\u8840\u586B\u6EFF\u5B83\u3002"
    _zhHans: "\u9965\u997F\u4E4B\u7269\u5411\u4F60\u9732\u51FA\u7360\u7259\u3002\n\u4EA4\u51FA\u4E00\u70B9\u5BB9\u5668\uFF0C\u5C31\u6559\u4F60\u7528\u4ED6\u4EBA\u7684\u8840\u586B\u6EE1\u5B83\u3002"
  - _key: event.EV_DEAL_06.accept
    _ko: "\uC774\uBE68\uC744 \uBC1B\uB294\uB2E4"
    _ja: "\u7259\u3092\u53D7\u3051\u53D6\u308B"
    _en: Take the Fangs
    _zhHant: "\u63A5\u53D7\u7360\u7259"
    _zhHans: "\u63A5\u53D7\u7360\u7259"
