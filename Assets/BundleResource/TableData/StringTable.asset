  - _key: askill.psg_h03.name
    _ko: "\uC735\uB2E8 \uD3ED\uACA9"
    _ja: "\u7D68\u6BEF\u7206\u6483"
    _en: 
  - _key: askill.psg_h03.desc
    _ko: "\uC218\uB958\uD0C4 5\uBC1C\uC744 \uBD80\uCC44\uAF34\uB85C \uB3D9\uC2DC\uC5D0
      \uB358\uC9C4\uB2E4."
    _ja: "\u30B0\u30EC\u30CD\u30FC\u30C95\u767A\u3092\u6247\u72B6\u306B\u540C\u6642\u306B\u6295\u3052\u308B\u3002"
    _en: 
  - _key: askill.psg_h04.name
    _ko: "\uC5F0\uC1C4 \uBC29\uC804"
    _ja: "\u9023\u9396\u653E\u96FB"
    _en: 
  - _key: askill.psg_h04.desc
    _ko: "3\uCD08\uAC04 \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uC804\uAE30\uAC00 \uACC4\uC18D
      \uD284\uB2E4."
    _ja: "3\u79D2\u9593\u3001\u5468\u56F2\u306E\u6575\u306B\u96FB\u6483\u304C\u8D70\u308A\u7D9A\u3051\u308B\u3002"
    _en: 
  - _key: askill.psg_h05.name
    _ko: "\uBC29\uBCBD \uC804\uAC1C"
    _ja: "\u9632\u58C1\u5C55\u958B"
    _en: 
  - _key: askill.psg_h05.desc
    _ko: "5\uCD08\uAC04 \uCD5C\uB300 \uCCB4\uB825\uB9CC\uD07C \uC274\uB4DC\uB97C
      \uB450\uB978\uB2E4. \uAE4E\uC774\uBA74 \uB05D\uB09C\uB2E4."
    _ja: "5\u79D2\u9593\u3001\u6700\u5927\u4F53\u529B\u5206\u306E\u30B7\u30FC\u30EB\u30C9\u3092\u307E\u3068\u3046\u3002\u524A\u3089\u308C\u308B\u3068\u6D88\u3048\u308B\u3002"
    _en: 
  - _key: askill.psg_h06.name
    _ko: "\uB2E4\uC911 \uC720\uB3C4"
    _ja: "\u591A\u91CD\u8A98\u5C0E"
    _en: 
  - _key: askill.psg_h06.desc
    _ko: "\uBC18\uC6D0\uC73C\uB85C \uD37C\uC9C4 8\uBC1C\uC774 \uD55C \uB300\uC0C1\uC73C\uB85C
      \uBAA8\uC5EC \uB4E0\uB2E4."
    _ja: "\u534A\u5186\u72B6\u306B\u653E\u3063\u305F8\u767A\u304C1\u4F53\u306E\u6575\u306B\u53CE\u675F\u3059\u308B\u3002"
    _en: 
  - _key: askill.psg_h07.name
    _ko: "\uB1CC\uC804 \uD3ED\uC8FC"
    _ja: "\u96F7\u96FB\u66B4\u8D70"
    _en: 
  - _key: askill.psg_h07.desc
    _ko: "2\uCD08\uAC04 \uBC88\uAC1C \uD295\uAE40\uC774 \uBC18\uB4DC\uC2DC \uD130\uC9C4\uB2E4."
    _ja: "2\u79D2\u9593\u3001\u9023\u9396\u96F7\u304C\u5FC5\u305A\u767A\u751F\u3059\u308B\u3002"
    _en: 
  - _key: askill.psg_h08.name
    _ko: "\uB3C5 \uBFDC\uAE30"
    _ja: "\u6BD2\u9727\u5674\u5C04"
    _en: 
  - _key: askill.psg_h08.desc
    _ko: "\uB458\uB808 5 m \uC758 \uC801\uC744 \uBAA8\uB450 \uC911\uB3C5\uC2DC\uD0A8\uB2E4.
      \uB3C5\uC740 \uC544\uD504\uACE0 \uB290\uB824\uC9C4\uB2E4."
    _ja: "\u5468\u56F25m\u306E\u6575\u3092\u6BD2\u72B6\u614B\u306B\u3059\u308B\u3002\u6BD2\u306F\u30C0\u30E1\u30FC\u30B8\u3068\u920D\u8DB3\u3092\u4E0E\u3048\u308B\u3002"
    _en: 
  - _key: askill.psg_h09.name
    _ko: "\uD654\uC5FC \uC9C0\uB300"
    _ja: "\u706B\u708E\u5730\u5E2F"
    _en: 
  - _key: askill.psg_h09.desc
    _ko: "\uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC801 \uBC1C\uBC11\uC5D0 \uBD88\uBC14\uB2E4\uB97C
      \uD3B8\uB2E4. \uBC1F\uACE0 \uC120 \uC801\uC774 \uACC4\uC18D \uD0C4\uB2E4."
    _ja: "\u6700\u3082\u8FD1\u3044\u6575\u306E\u8DB3\u5143\u306B\u706B\u306E\u6D77\u3092\u5E83\u3052\u308B\u3002\u4E0A\u306B\u7ACB\u3064\u6575\u306F\u71C3\u3048\u7D9A\u3051\u308B\u3002"
    _en: 
  - _key: askill.psg_h10.name
    _ko: "\uC77C\uC81C \uD45C\uC2DD"
    _ja: "\u4E00\u6589\u30DE\u30FC\u30AD\u30F3\u30B0"
    _en: 
  - _key: askill.psg_h10.desc
    _ko: "\uBC29 \uC548 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C 3\uCD08\uAC04 \uD45C\uC2DD\uC744
