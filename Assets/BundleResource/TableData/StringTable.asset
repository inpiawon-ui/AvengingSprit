    _ko: "\uBB3C\uB7EC\uC120\uB2E4"
    _ja: "\u8EAB\u3092\u5F15\u304F"
    _en: 
  - _key: event.EV_CH2_02.title
    _ko: "\uC774\uB984\uB09C \uBAB8"
    _ja: "\u540D\u306E\u77E5\u308C\u305F\u4F53"
    _en: 
  - _key: event.EV_CH2_02.body
    _ko: "\uACE8\uBAA9 \uB05D\uC5D0 \uD558\uB098\uAC00 \uC11C \uC788\uB2E4. \uC774
      \uAD6C\uC5ED\uC5D0\uC11C \uC81C\uC77C \uC88B\uC740 \uBAB8\uC774\uB2E4.\n\uBE44\uCF1C
      \uC904 \uC0DD\uAC01\uC740 \uC5C6\uC5B4 \uBCF4\uC778\uB2E4."
    _ja: "\u8DEF\u5730\u306E\u5965\u306B\u3072\u3068\u308A\u7ACB\u3063\u3066\u3044\u308B\u3002\u3053\u306E\u533A\u57DF\u3067\u3044\u3061\u3070\u3093\u826F\u3044\u4F53\u3060\u3002\n\u9053\u3092\u8B72\u308B\u6C17\u306F\u306A\u3055\u305D\u3046\u3060\u3002"
    _en: 
  - _key: event.EV_CH2_02.accept
    _ko: "\uB364\uBE48\uB2E4"
    _ja: "\u6311\u3080"
    _en: 
