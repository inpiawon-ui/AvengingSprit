  - _key: ui.growth.help.stats
    _ko: "\uACE8\uB4DC\uB85C \uB2A5\uB825\uCE58\uB97C \uC601\uAD6C\uD788 \uC62C\uB9BD\uB2C8\uB2E4.\n\uC720\uB839
      \uC721\uC131\uC740 \uBAA8\uB4E0 \uD638\uC2A4\uD2B8\uC5D0, \uD638\uC2A4\uD2B8
      \uC721\uC131\uC740 \uADF8 \uD638\uC2A4\uD2B8\uC5D0\uB9CC \uBD99\uC2B5\uB2C8\uB2E4."
    _ja: "\u30B4\u30FC\u30EB\u30C9\u3067\u80FD\u529B\u5024\u3092\u6C38\u4E45\u306B\u5F37\u5316\u3057\u307E\u3059\u3002\n\u30B4\u30FC\u30B9\u30C8\u80B2\u6210\u306F\u5168\u30DB\u30B9\u30C8\u306B\u3001\u30DB\u30B9\u30C8\u80B2\u6210\u306F\u305D\u306E\u30DB\u30B9\u30C8\u3060\u3051\u306B\u9069\u7528\u3055\u308C\u307E\u3059\u3002"
    _en: 'Spend gold to permanently raise stats.

      Ghost upgrades apply to every
      host; host upgrades apply to that host only.'
    _zhHant: "\u4F7F\u7528\u91D1\u5E63\u6C38\u4E45\u63D0\u5347\u80FD\u529B\u503C\u3002\n\u5E7D\u9748\u57F9\u990A\u9069\u7528\u65BC\u6240\u6709\u5BBF\u4E3B\uFF0C\u5BBF\u4E3B\u57F9\u990A\u50C5\u9069\u7528\u65BC\u8A72\u5BBF\u4E3B\u3002"
    _zhHans: "\u4F7F\u7528\u91D1\u5E01\u6C38\u4E45\u63D0\u5347\u5C5E\u6027\u3002\n\u5E7D\u7075\u57F9\u517B\u9002\u7528\u4E8E\u6240\u6709\u5BBF\u4E3B\uFF0C\u5BBF\u4E3B\u57F9\u517B\u4EC5\u9002\u7528\u4E8E\u8BE5\u5BBF\u4E3B\u3002"
  - _key: ui.growth.help.path
    _ko: "\uCC55\uD130\uB97C \uD074\uB9AC\uC5B4\uD558\uBA74 \uC720\uB839 \uACBD\uD5D8\uCE58\uB97C
      \uC5BB\uC2B5\uB2C8\uB2E4.\n\uC815\uD574\uC9C4 \uB808\uBCA8\uC5D0 \uB2FF\uC73C\uBA74
      \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    _ja: "\u30C1\u30E3\u30D7\u30BF\u30FC\u3092\u30AF\u30EA\u30A2\u3059\u308B\u3068\u30B4\u30FC\u30B9\u30C8\u7D4C\u9A13\u5024\u3092\u7372\u5F97\u3057\u307E\u3059\u3002\n\u6C7A\u307E\u3063\u305F\u30EC\u30D9\u30EB\u306B\u9054\u3059\u308B\u3068\u5831\u916C\u3092\u53D7\u3051\u53D6\u308C\u307E\u3059\u3002"
    _en: 'Clear chapters to earn ghost EXP.

      Reach milestone levels to claim
      rewards.'
    _zhHant: "\u901A\u95DC\u7AE0\u7BC0\u53EF\u7372\u5F97\u5E7D\u9748\u7D93\u9A57\u503C\u3002\n\u9054\u5230\u6307\u5B9A\u7B49\u7D1A\u5373\u53EF\u9818\u53D6\u734E\u52F5\u3002"
    _zhHans: "\u901A\u5173\u7AE0\u8282\u53EF\u83B7\u5F97\u5E7D\u7075\u7ECF\u9A8C\u503C\u3002\n\u8FBE\u5230\u6307\u5B9A\u7B49\u7EA7\u5373\u53EF\u9886\u53D6\u5956\u52B1\u3002"
  - _key: ui.growth.ghost.name
    _ko: "\uC720\uB839"
    _ja: "\u30B4\u30FC\u30B9\u30C8"
    _en: Ghost
    _zhHant: "\u5E7D\u9748"
    _zhHans: "\u5E7D\u7075"
  - _key: ui.growth.ghost.desc
    _ko: "\uC138\uC0C1\uC744 \uB5A0\uB3C4\uB294 \uC815\uC758\uB85C\uC6B4 \uC601\uD63C.\n\uC544\uC9C1
      \uB05D\uB098\uC9C0 \uC54A\uC740 \uC774\uC57C\uAE30\uB97C \uC704\uD574\n\uC624\uB298\uB3C4
      \uD568\uAED8\uD569\uB2C8\uB2E4."
    _ja: "\u4E16\u3092\u3055\u307E\u3088\u3046\u6B63\u7FA9\u306E\u9B42\u3002\n\u307E\u3060\u7D42\u308F\u3089\u306A\u3044\u7269\u8A9E\u306E\u305F\u3081\u306B\n\u4ECA\u65E5\u3082\u5171\u306B\u6226\u3044\u307E\u3059\u3002"
    _en: 'A righteous soul adrift in the world,

      fighting on for a story

      that
      isn''t over yet.'
    _zhHant: "\u904A\u8569\u65BC\u4E16\u9593\u7684\u6B63\u7FA9\u9748\u9B42\u3002\n\u70BA\u4E86\u5C1A\u672A\u7D50\u675F\u7684\u6545\u4E8B\uFF0C\n\u4ECA\u5929\u4E5F\u4E26\u80A9\u4F5C\u6230\u3002"
    _zhHans: "\u6E38\u8361\u4E8E\u4E16\u95F4\u7684\u6B63\u4E49\u7075\u9B42\u3002\n\u4E3A\u4E86\u5C1A\u672A\u7ED3\u675F\u7684\u6545\u4E8B\uFF0C\n\u4ECA\u5929\u4E5F\u5E76\u80A9\u4F5C\u6218\u3002"
