  - _key: chapter.13.desc
    _ko: "\uACE0\uCCA0 \uB354\uBBF8 \uB108\uBA38\uB85C\n\uB3CC\uC544\uC624\uB294
      \uD1B1\uB0A0 \uC18C\uB9AC."
    _ja: "\u30B9\u30AF\u30E9\u30C3\u30D7\u306E\u5C71\u306E\u5411\u3053\u3046\u304B\u3089\n\u623B\u3063\u3066\u304F\u308B\u30CE\u30B3\u30AE\u30EA\u306E\u97F3\u3002"
    _en: 'From beyond the scrap heaps

      comes the whine of a returning blade.'
    _zhHant: "\u5EE2\u9435\u5806\u7684\u53E6\u4E00\u982D\n\u50B3\u4F86\u92F8\u7247\u8FF4\u65CB\u7684\u8072\u97F3\u3002"
    _zhHans: "\u5E9F\u94C1\u5806\u7684\u53E6\u4E00\u5934\n\u4F20\u6765\u952F\u7247\u56DE\u65CB\u7684\u58F0\u97F3\u3002"
  - _key: stage.14.1.name
