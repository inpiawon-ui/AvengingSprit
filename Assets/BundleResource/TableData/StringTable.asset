    _ko: "\uB54C\uB9B4\uC218\uB85D \uADF8 \uC801\uC774 \uBC1B\uB294 \uD53C\uD574\uAC00
      \uC313\uC5EC \uB298\uC5B4\uB09C\uB2E4."
