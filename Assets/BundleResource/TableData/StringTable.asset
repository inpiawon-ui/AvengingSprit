    _zhHant: "\u9023\u7E8C\u653B\u64CA\u540C\u4E00\u6575\u4EBA\u6642\u8D8A\u4F86\u8D8A\u5F37\u3002"
    _zhHans: "\u8FDE\u7EED\u653B\u51FB\u540C\u4E00\u654C\u4EBA\u65F6\u8D8A\u6765\u8D8A\u5F3A\u3002"
