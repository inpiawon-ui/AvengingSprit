  - _eventId: EV_CH1_02
    _chapter: 1
    _titleKr: "\uBC84\uB824\uC9C4 \uBCF4\uAE09\uD488"
    _bodyKr: "\uB4A4\uC9D1\uD78C \uC0C1\uC790 \uD558\uB098. \uC548\uC5D0 \uB4E0 \uAC83\uC744
      \uB2E4 \uAC00\uC838\uAC08 \uC218\uB294 \uC5C6\uB2E4.\n\uC7A5\uBE44\uB97C \uCC59\uAE30\uB4E0\uC9C0,
      \uD314\uC544 \uB118\uAE30\uB4E0\uC9C0."
    _costType: 0
    _costValue: 0
    _acceptKr: "\uC7A5\uBE44\uB97C \uCC59\uAE34\uB2E4"
