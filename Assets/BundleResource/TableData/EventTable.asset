    _titleKr: "\uC881\uC740 \uAE38\uBAA9"
    _bodyKr: "\uC9D0\uC9DD \uC0AC\uC774\uB85C \uAE38\uC774 \uD558\uB098\uBFD0\uC774\uB2E4.\n\uBC18\uB300\uD3B8\uC5D0\uC11C
